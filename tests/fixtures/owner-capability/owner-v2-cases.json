        "    public void CombinedOwner() {}",
        "",
        "    [DataTestMethod]",
        "    public void MissingOwner() {}",
        "",
        "    [TestMethod, Owner(\"group-c\")]",
        "    public void MixedCompliant() {}",
        "",
        "    [TestMethod]",
        "    public void MixedViolation() {}",
        "",
        "    public void HelperMethod() {}",
        "",
        "    [TestMethod]",
        "    public void OutsideSpan() {}",
        "",
        "    [TestMethod]",
        "    public void DuplicateName() {}",
        "",
        "    [DataTestMethod]",
        "    public void DuplicateName(int value) {}",
        "}"
      ],
      "spans": [
