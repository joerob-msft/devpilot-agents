# PowerShell / module build output
*.nupkg
output/

# Agent runtime state must never be committed: it contains repository
# identifiers, PR numbers, and per-cycle activity logs.
state/
*.log.jsonl
failed-cycles/

# Dashboard operational data: live snapshots, identity roster, and collected
# comment outcomes. These files may contain display names and PR activity and
# must never be committed.
dashboard-data/

