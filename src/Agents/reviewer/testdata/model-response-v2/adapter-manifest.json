{
  "schemaVersion": 1,
  "kind": "reviewer-offline-model-adapter",
  "fixtureId": "model-response-v2",
  "expectedBaseCommit": "1111111111111111111111111111111111111111",
  "adapterScript": "../../offline/Invoke-ReviewerModelAdapter.ps1",
  "classification": {
    "offlineOnly": true,
    "nonPromotable": true,
    "writesPermitted": false,
    "outputsPreAuthored": true,
    "oracleDerivedAtRuntime": false
  },
  "roles": {
    "blind-opus": {
      "model": "claude-opus-5",
      "behavior": "missingMarker",
      "responseV2": {
        "mode": "nonceAbsent",
        "noncePrefix": "REVIEWER_NONCE_V2:",
        "payloadPrefix": "REVIEWER_PAYLOAD_V2:",
        "payloadTemplate": {
          "schemaVersion": 2,
          "reviewedSourceCommit": "{{binding.reviewedSourceCommit}}",
          "findings": [
            {
              "severity": "important",
              "filePath": "/src/Widget.cs",
              "line": 15,
              "comment": "The new Rename method mutates an identifier documented as construction-stable."
            }
          ],
          "recommendedVote": "waitForAuthor",
          "summary": "One construction-lifecycle regression requires clarification."
        }
      }
    },
    "blind-gpt": {
      "model": "gpt-5.6-sol",
      "behavior": "missingMarker",
      "responseV2": {
        "mode": "authenticated",
        "noncePrefix": "REVIEWER_NONCE_V2:",
        "payloadPrefix": "REVIEWER_PAYLOAD_V2:",
        "payloadTemplate": {
          "schemaVersion": 2,
          "reviewedSourceCommit": "{{binding.reviewedSourceCommit}}",
          "findings": [],
          "recommendedVote": "approve",
          "summary": "No additional finding."
        }
      }
    }
  }
}
