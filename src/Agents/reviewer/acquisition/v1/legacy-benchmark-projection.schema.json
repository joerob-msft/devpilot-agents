{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewer.legacy-blinded-benchmark-projection.v1",
  "title": "Legacy blinded reviewer benchmark projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "fixtureId", "fixtureVersion", "binding", "bindingSha256", "fixtureIndexBinding", "resources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "blinded-reviewer-adapter-input" },
    "fixtureId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "fixtureVersion": { "type": "integer", "minimum": 1 },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "repositoryId", "pr", "iteration", "common", "source", "target"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "repository": { "type": "string", "minLength": 1, "maxLength": 256 },
        "repositoryId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pr": { "type": "integer", "minimum": 1 },
        "iteration": { "type": "integer", "minimum": 1 },
        "common": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "source": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "target": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
      }
    },
    "bindingSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fixtureIndexBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureIndexSha256", "fixtureRecordHash", "originalFixtureFileSha256"],
      "properties": {
        "fixtureIndexSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "fixtureRecordHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "originalFixtureFileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mediaRole", "sealedPath", "sha256", "byteLength"],
        "properties": {
          "mediaRole": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "sealedPath": { "type": "string", "minLength": 1, "maxLength": 512 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "byteLength": { "type": "integer", "minimum": 2, "maximum": 67108864 }
        }
      }
    }
  }
}
