{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewer.discovery-candidate-input.v1",
  "title": "Reviewer independently-captured discovery candidate input",
  "description": "The verifier acquisition may NEVER derive its candidate from a co-run discovery pass or from any expected answer. It consumes exactly this artifact: a candidate set that was captured from a SEPARATE discovery run, carrying the exact source fixture, source model, and result-marker binding that produced it. The plan binds this artifact's SHA-256 and its source identity, so a substituted or truth-derived candidate is refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "sourceFixtureId",
    "sourceRole",
    "sourceModel",
    "resultMarkerPrefix",
    "resultMarkerBinding",
    "clusterId",
    "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "reviewer-discovery-candidate-input" },
    "sourceFixtureId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sourceRole": { "enum": ["generalist", "specialist"] },
    "sourceModel": { "type": "string", "minLength": 1, "maxLength": 128 },
    "resultMarkerPrefix": { "type": "string", "minLength": 1, "maxLength": 64 },
    "resultMarkerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prId", "repositoryId", "project", "sourceCommit"],
      "properties": {
        "prId": { "type": "integer", "minimum": 1 },
        "repositoryId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
        "project": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
      }
    },
    "clusterId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "candidateHash"],
        "properties": {
          "candidateId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "candidateHash": { "type": "string", "pattern": "^[0-9a-f]{8,64}$" },
          "originKind": { "enum": ["generalist", "convention"] },
          "originModel": { "type": "string", "minLength": 1, "maxLength": 128 },
          "originArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "severity": { "type": "string", "maxLength": 32 },
          "filePath": { "type": "string", "maxLength": 400 },
          "line": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "comment": { "type": "string", "maxLength": 4096 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "sourceRole": { "const": "specialist" } },
        "required": ["sourceRole"]
      },
      "then": {
        "properties": {
          "candidates": {
            "items": {
              "required": ["originKind", "originModel", "originArtifactSha256"],
              "properties": { "originKind": { "const": "convention" } }
            }
          }
        }
      }
    }
  ]
}
