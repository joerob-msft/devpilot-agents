{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewer.model-visible-role-provenance.v1",
  "title": "Sealed model-visible reviewer role provenance",
  "description": "Exact role input fields independently sealed into a blinded legacy pack. This is stimulus provenance only and may not contain an oracle or expected decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "fixtureId", "role", "bindingSha256", "configSha256", "scriptSha256", "promptSha256", "context"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "reviewer-model-visible-role-provenance" },
    "fixtureId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "role": { "enum": ["generalist", "specialist", "verifier"] },
    "bindingSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "configSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scriptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "promptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "context": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["sourceBranch", "authorAlias", "title", "threadDigestText"],
          "properties": {
            "sourceBranch": { "type": "string", "minLength": 1, "maxLength": 400 },
            "authorAlias": { "type": "string", "minLength": 1, "maxLength": 200 },
            "title": { "type": "string", "maxLength": 400 },
            "threadDigestText": { "type": "string", "minLength": 1, "maxLength": 65536 },
            "authoritativeSourcesText": { "type": "string", "maxLength": 262144 },
            "pinnedSourceText": { "type": "string", "maxLength": 1048576 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["conventionPlanJson", "factPlanJson"],
          "properties": {
            "conventionPlanJson": { "type": "string", "minLength": 1, "maxLength": 4194304 },
            "factPlanJson": { "type": "string", "minLength": 1, "maxLength": 4194304 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["targetCommit", "changeSetDigest", "configSha256", "scriptSha256", "promptSha256"],
          "properties": {
            "targetCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
            "changeSetDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "configSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "scriptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "promptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    }
  }
}
