{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewer.transcript-package.v1",
  "title": "Reviewer blinded transcript package manifest",
  "description": "The canonical, read-only manifest that seals one acquired blinded transcript. It binds each captured file by length and SHA-256, records the reported model, role, fresh nonce and its hash, every input/prompt/schema/config/script/snapshot/candidate digest, the attempt ledger with typed reasons, usage, timestamps and durations, the terminal status, and the zero-write telemetry proof. It NEVER contains a credential, an authorization token, or an oracle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "planId",
    "role",
    "reportedModel",
    "requestedModel",
    "secondGeneralistModel",
    "nonce",
    "nonceSha256",
    "resultMarkerPrefix",
    "files",
    "directories",
    "digests",
    "snapshotIdentity",
    "attempts",
    "usage",
    "telemetry",
    "timings",
    "terminalStatus",
    "createdUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "reviewer-blinded-transcript-package" },
    "planId": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
    "role": { "enum": ["generalist", "specialist", "verifier"] },
    "reportedModel": { "type": "string", "maxLength": 128 },
    "requestedModel": { "type": "string", "minLength": 1, "maxLength": 128 },
    "secondGeneralistModel": { "type": "string", "minLength": 1, "maxLength": 128 },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
    "nonceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "resultMarkerPrefix": { "type": "string", "minLength": 1, "maxLength": 64 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "bytes"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$", "maxLength": 256 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "directories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$", "maxLength": 256 }
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureProjectionSha256",
        "requestSha256",
        "inputSha256",
        "promptSha256",
        "schemaSha256",
        "configSha256",
        "scriptSha256",
        "snapshotManifestDigest"
      ],
      "properties": {
        "fixtureProjectionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "requestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "inputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "promptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "schemaSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "configSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "scriptSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "snapshotManifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "candidateInputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "clusterHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "discoveryMarkerSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "discoveryPackageManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "candidateExtractionHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "derivedCandidateHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "derivedClusterHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "snapshotIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotName", "manifestDigest", "prId", "repositoryId", "project", "sourceCommit", "targetCommit", "changeSetDigest", "nonPromotable"],
      "properties": {
        "snapshotName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "manifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "prId": { "type": "integer", "minimum": 1 },
        "repositoryId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
        "project": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "targetCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "changeSetDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "nonPromotable": { "const": true }
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "nonce", "nonceSha256", "markerStatus", "retryable", "modelRan", "exitCode", "timedOut", "reason", "detail", "usage"],
        "properties": {
          "attempt": { "type": "integer", "minimum": 1 },
          "nonce": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
          "nonceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "markerStatus": { "type": "string", "minLength": 1, "maxLength": 64 },
          "retryable": { "type": "boolean" },
          "modelRan": { "type": "boolean" },
          "exitCode": { "type": "integer" },
          "timedOut": { "type": "boolean" },
          "reason": { "type": "string", "maxLength": 512 },
          "detail": { "type": "string", "maxLength": 512 },
          "durationMs": { "type": "integer", "minimum": 0 },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reported", "premiumRequests", "totalApiDurationMs", "sessionDurationMs", "totalNanoAiu", "totalPremiumRequests", "unavailable"],
            "properties": {
              "reported": { "type": "boolean" },
              "premiumRequests": { "type": ["integer", "null"], "minimum": 0 },
              "totalApiDurationMs": { "type": ["integer", "null"], "minimum": 0 },
              "sessionDurationMs": { "type": ["integer", "null"], "minimum": 0 },
              "totalNanoAiu": { "type": ["integer", "null"], "minimum": 0 },
              "totalPremiumRequests": { "type": ["integer", "null"], "minimum": 0 },
              "unavailable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reported", "premiumRequests", "totalApiDurationMs", "sessionDurationMs", "totalNanoAiu", "totalPremiumRequests", "unavailable"],
      "properties": {
        "reported": { "type": "boolean" },
        "premiumRequests": { "type": ["integer", "null"], "minimum": 0 },
        "totalApiDurationMs": { "type": ["integer", "null"], "minimum": 0 },
        "sessionDurationMs": { "type": ["integer", "null"], "minimum": 0 },
        "totalNanoAiu": { "type": ["integer", "null"], "minimum": 0 },
        "totalPremiumRequests": { "type": ["integer", "null"], "minimum": 0 },
        "unavailable": { "type": "boolean" }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "fileExists",
        "sinkBytes",
        "sinkSha256",
        "totalEvents",
        "modelSubprocessStarts",
        "realModelStarts",
        "providerLiveProcessStarts",
        "providerLiveWrites",
        "writeToolInvocations",
        "zeroWriteVerified"
      ],
      "properties": {
        "mode": { "enum": ["production", "production-test-only"] },
        "fileExists": { "const": true },
        "sinkBytes": { "type": "integer", "minimum": 1 },
        "sinkSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "totalEvents": { "type": "integer", "minimum": 1 },
        "modelSubprocessStarts": { "type": "integer", "minimum": 0 },
        "realModelStarts": { "type": "integer", "minimum": 0 },
        "providerLiveProcessStarts": { "type": "integer", "minimum": 0, "maximum": 0 },
        "providerLiveWrites": { "type": "integer", "minimum": 0, "maximum": 0 },
        "writeToolInvocations": { "type": "integer", "minimum": 0, "maximum": 0 },
        "zeroWriteVerified": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "production-test-only" } } },
          "then": { "properties": { "realModelStarts": { "maximum": 0 } } }
        }
      ]
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedUtc", "endedUtc", "totalDurationMs"],
      "properties": {
        "startedUtc": { "type": "string", "format": "date-time" },
        "endedUtc": { "type": "string", "format": "date-time" },
        "totalDurationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "terminalStatus": {
      "enum": ["captured", "captureFailedRetriesExhausted", "captureFailedTerminal", "timeout", "crash"]
    },
    "createdUtc": { "type": "string", "format": "date-time" }
  }
}
