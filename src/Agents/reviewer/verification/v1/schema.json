{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devpilot:reviewer:verification-candidate:v1",
  "title": "DevPilot normalized verification candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidateId",
    "candidateHash",
    "schemaVersion",
    "originKind",
    "originModel",
    "originArtifactSha256",
    "originCandidateId",
    "issueClass",
    "affectedBehavior",
    "anchorKind",
    "filePath",
    "line",
    "severity",
    "comment",
    "evidence",
    "ruleSourceId",
    "ruleSourceSha256",
    "ruleQuote",
    "siblingStatus",
    "siblingEvidence",
    "siblingNotRequiredReason",
    "factIds",
    "changedCodeFix",
    "existingDebtFollowUp",
    "existingDebtEvidence",
    "rawCandidateSha256"
  ],
  "properties": {
    "candidateId": { "type": "string", "pattern": "^cand1:[0-9a-f]{64}$" },
    "candidateHash": { "$ref": "#/$defs/sha256" },
    "schemaVersion": { "const": 1 },
    "originKind": { "enum": ["generalist", "convention"] },
    "originModel": { "type": "string", "minLength": 1 },
    "originArtifactSha256": { "$ref": "#/$defs/sha256" },
    "originCandidateId": { "type": "string" },
    "issueClass": {
      "enum": [
        "security",
        "buildTest",
        "dataIntegrity",
        "errorHandling",
        "concurrency",
        "compatibility",
        "behavior",
        "other"
      ]
    },
    "affectedBehavior": { "type": "string" },
    "anchorKind": { "enum": ["changedFile", "prMetadata"] },
    "filePath": { "type": "string" },
    "line": { "type": "integer", "minimum": 0 },
    "severity": { "enum": ["critical", "important", "suggestion"] },
    "comment": { "type": "string" },
    "evidence": { "type": "string" },
    "ruleSourceId": { "type": "string" },
    "ruleSourceSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "const": "" }
      ]
    },
    "ruleQuote": { "type": "string" },
    "siblingStatus": { "enum": ["", "checked", "notRequired"] },
    "siblingEvidence": { "type": "string" },
    "siblingNotRequiredReason": { "type": "string" },
    "factIds": { "type": "string" },
    "changedCodeFix": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "targets", "conventionKey", "valueSource", "evidenceFactIds"],
          "properties": {
            "action": { "enum": ["add", "modify", "remove", "rename", "replace", "validate"] },
            "targets": { "type": "string" },
            "conventionKey": { "type": "string" },
            "valueSource": { "enum": ["authoritativeRule", "deterministicFact"] },
            "evidenceFactIds": { "type": "string" }
          }
        }
      ]
    },
    "existingDebtFollowUp": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status", "evidenceFactId", "selectorKey", "scopeKind", "scopePath",
            "comparableCount", "compliantCount", "action"
          ],
          "properties": {
            "status": { "enum": ["none", "required"] },
            "evidenceFactId": { "type": "string" },
            "selectorKey": { "type": "string" },
            "scopeKind": { "enum": ["", "file"] },
            "scopePath": { "type": "string" },
            "comparableCount": { "type": "integer", "minimum": 0 },
            "compliantCount": { "type": "integer", "minimum": 0 },
            "action": { "enum": ["", "recordTrackedFollowUp", "linkTrackedFollowUp"] }
          }
        }
      ]
    },
    "existingDebtEvidence": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceFactId", "path", "declarationCount",
            "attributeFrequency", "attributeCountsComplete", "generatedCode"
          ],
          "properties": {
            "evidenceFactId": { "type": "string", "pattern": "^rdf1:[0-9a-f]{64}$" },
            "path": { "type": "string" },
            "declarationCount": { "type": "integer", "minimum": 0 },
            "attributeFrequency": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["attribute", "declarations"],
                "properties": {
                  "attribute": { "type": "string" },
                  "declarations": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "attributeCountsComplete": { "type": "boolean" },
            "generatedCode": { "type": "boolean" }
          }
        }
      ]
    },
    "rawCandidateSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
