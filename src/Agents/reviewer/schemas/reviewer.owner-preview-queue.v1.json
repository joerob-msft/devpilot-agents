{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewer.owner-preview-queue.v1",
  "title": "Owner preview declared queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "instanceName", "toolkitRoot", "expectedToolkitHead", "expectedToolkitRef", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "reviewer-owner-preview-queue" },
    "instanceName": { "$ref": "#/$defs/name" },
    "toolkitRoot": { "$ref": "#/$defs/path" },
    "expectedToolkitHead": { "$ref": "#/$defs/commit" },
    "expectedToolkitRef": { "$ref": "#/$defs/ref" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "token": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f\"']+$" },
    "path": { "type": "string", "minLength": 3, "maxLength": 1024, "pattern": "^[A-Za-z]:\\\\[^\\u0000-\\u001f\\u007f\"]+$" },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "ref": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]{0,244}$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability", "organization", "project", "repositoryId", "repositoryName",
        "pullRequestId", "targetRefName", "sourceHeadMode", "configPath",
        "authoritativeRuleCommit", "model", "expectedReviewerBaseCommit", "agencyPath"
      ],
      "properties": {
        "capability": { "const": "bpm-test-ownership@1" },
        "organization": { "$ref": "#/$defs/token" },
        "project": { "$ref": "#/$defs/token" },
        "repositoryId": { "$ref": "#/$defs/token" },
        "repositoryName": { "$ref": "#/$defs/token" },
        "pullRequestId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "targetRefName": { "$ref": "#/$defs/ref" },
        "sourceRefName": { "$ref": "#/$defs/ref" },
        "sourceHeadMode": { "enum": ["fixed", "refresh-before-first-run"] },
        "expectedSourceHead": { "$ref": "#/$defs/commit" },
        "configPath": { "$ref": "#/$defs/path" },
        "promptPath": { "$ref": "#/$defs/path" },
        "repositoryPath": { "$ref": "#/$defs/path" },
        "offlineModelAdapterManifest": { "$ref": "#/$defs/path" },
        "authoritativeRuleCommit": { "$ref": "#/$defs/commit" },
        "model": { "$ref": "#/$defs/name" },
        "expectedReviewerBaseCommit": { "$ref": "#/$defs/commit" },
        "agencyPath": { "$ref": "#/$defs/path" }
      },
      "allOf": [
        {
          "if": { "properties": { "sourceHeadMode": { "const": "fixed" } }, "required": ["sourceHeadMode"] },
          "then": { "required": ["expectedSourceHead"] },
          "else": { "not": { "required": ["expectedSourceHead"] } }
        }
      ]
    }
  }
}
