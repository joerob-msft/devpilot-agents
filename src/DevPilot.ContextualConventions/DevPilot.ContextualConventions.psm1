#requires -Version 7.0

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

Import-Module (Join-Path $PSScriptRoot `
    '..\DevPilot.TestClassCoverage\DevPilot.TestClassCoverage.psd1') -Force

$script:RuleIds = @(
    'exception-logging',
    'exception-propagation',
    'type-based-decisions',
    'explicit-string-comparison',
    'named-call-arguments',
    'xml-summary-layout',
    'duplicate-constant-declarations',
    'reused-string-literals',
    'collection-cardinality',
    'cheap-validation',
    'async-all-the-way',
    'async-io',
    'async-wait-sync',
    'http-client-lifetime',
    'thread-safe-immutable',
    'cache-streaming',
    'typed-contracts',
    'json-contracts',
    'api-errors',
    'secret-redaction',
    'dependency-fanout',
    'test-class-code-coverage',
    'pr-template-compliance',
    'block-body-indentation',
    'generic-exception-naming',
    'file-copyright-header'
)

function Get-ContextualConventionRuleIds {
    return @($script:RuleIds)
}

function Test-ContextualConventionPriorRuleIds {
    param(
        [Parameter(Mandatory)][Collections.IDictionary]$Rule,
        [Parameter(Mandatory)][object[]]$RuleIds
    )
    if ('named-call-arguments' -cin $RuleIds) { return $false }
    if ([string]$Rule.hash -cne
            'v1:sha256:275a62e22d849913ea0da332fdb07dfb6ebed155231236c7704b94f4fb031938' -and
        @($RuleIds | Where-Object {
        [string]$_ -cin @('block-body-indentation', 'generic-exception-naming',
            'reused-string-literals', 'file-copyright-header')
    }).Count -gt 0) { return $false }
    $excluded = switch ([string]$Rule.hash) {
        'v1:sha256:0f6bd9dd21df64854bba7e2ba487c2639be15fa90f068da00df20f031ef9c749' {
            if ([long]$Rule.length -ne 3706) { return $false }
            @('named-call-arguments', 'xml-summary-layout',
                'duplicate-constant-declarations', 'pr-template-compliance')
        }
        'v1:sha256:6a7db82e68b407af4ed19aab4517973337592e757a32d5fa7a142b63ef75d22a' {
            if ([long]$Rule.length -ne 5205) { return $false }
            @('named-call-arguments', 'pr-template-compliance')
        }
        'v1:sha256:9834f5ee38aefe532a9c2b5e05b90dd0f55faa8d87d743e2a650bb191c89506e' {
            if ([long]$Rule.length -ne 5399) { return $false }
            @('pr-template-compliance')
        }
        'v1:sha256:e84ed0793dbabb4494a603fb445bea120af872b6df4477f2952148fc9bc3efac' {
            if ([long]$Rule.length -ne 6249) { return $false }
            @()
        }
        'v1:sha256:275a62e22d849913ea0da332fdb07dfb6ebed155231236c7704b94f4fb031938' {
            if ([long]$Rule.length -ne 10287) { return $false }
            @()
        }
        default { @() }
    }
    return @($RuleIds | Where-Object { [string]$_ -cin $excluded }).Count -eq 0
}

function Get-ContextualCopyrightHeaderState {
    param(
        [Parameter(Mandatory)][AllowEmptyString()][string]$Content,
        [Parameter(Mandatory)][string]$Path
    )
    if ($Path -imatch
            '(^|[\\/])(?:obj|generated|vendor|vendored|third_party|third-party|Ignore-AddedForReferenceOnly)([\\/]|$)|(?:\.g|\.designer)\.cs$') {
        return 'excluded'
    }
    $tree = [Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree]::ParseText($Content)
    $leading = $tree.GetRoot().GetLeadingTrivia().ToFullString()
    if ($leading -match '(?i)<auto-generated(?:\s|>)') {
        return 'excluded'
    }
    if ($Content -cmatch
        '\A\uFEFF?[ \t\r\n]*//[ \t]*-{3,}[ \t]*\r?\n[ \t]*//[ \t]*Copyright[ \t]+\(c\)[ \t]+(?:[0-9]{4}(?:[ \t]*-[ \t]*[0-9]{4})?[ \t]+)?Microsoft[ \t]+Corporation\.[ \t]+All[ \t]+rights[ \t]+reserved\.[ \t]*\r?\n[ \t]*//[ \t]*-{3,}[ \t]*(?:\r?\n|\z)') {
        return 'present'
    }
    return 'missing'
}

function Get-ContextualCopyrightHeaderEvidence {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Path,
        [AllowNull()][string]$OldPath = $null,
        [Parameter(Mandatory)][string]$ChangeType,
        [Parameter(Mandatory)][AllowNull()][AllowEmptyString()][object]$Content,
        [Parameter(Mandatory)][AllowNull()][AllowEmptyString()][object]$TargetContent,
        [Parameter(Mandatory)][ValidatePattern('^[0-9a-f]{40}$')][string]$SourceCommit,
        [Parameter(Mandatory)][ValidatePattern('^[0-9a-f]{40}$')][string]$TargetCommit
    )
    $type = switch -Regex ($ChangeType) {
        '^(?:add|added)$' { 'added'; break }
        '^(?:edit|modified)$' { 'modified'; break }
        '^delete(?:d)?$' { 'deleted'; break }
        '(?i)rename' { 'renamed'; break }
        default { throw 'Unsupported copyright changed-file type.' }
    }
    $sourceState = if ($type -ceq 'deleted') { 'excluded' }
        elseif ($Content -is [string]) {
            Get-ContextualCopyrightHeaderState -Content $Content -Path $Path
        } else { 'unavailable' }
    $targetState = if ($type -ceq 'added') { 'absent-added' }
        elseif ($type -ceq 'deleted') { 'not-read-deleted' }
        elseif ($TargetContent -is [string]) {
            Get-ContextualCopyrightHeaderState -Content $TargetContent -Path $Path
        } else { 'unavailable' }
    $origin = if ($sourceState -ceq 'excluded' -or $sourceState -ceq 'present') {
        'not-applicable'
    }
    elseif ($sourceState -ceq 'missing' -and $targetState -cin @('present', 'absent-added')) {
        'introduced'
    }
    elseif ($sourceState -ceq 'missing' -and $targetState -ceq 'missing') {
        'pre-existing'
    }
    else { 'unknown' }
    return [ordered]@{
        schemaVersion = 1
        kind = 'contextual-copyright-header-v1'
        path = $Path
        oldPath = $(if ($type -ceq 'renamed') { $OldPath } else { $null })
        changeType = $type
        sourceCommit = $SourceCommit
        targetCommit = $TargetCommit
        sourceDigest = $(if ($Content -is [string]) {
            Get-ContextualTextDigest $Content
        } else { 'unknown' })
        targetDigest = $(if ($TargetContent -is [string] -and $type -cne 'deleted') {
            Get-ContextualTextDigest $TargetContent
        } else { 'unknown' })
        sourceHeaderState = $sourceState
        targetHeaderState = $targetState
        origin = $origin
    }
}

function Test-ContextualCopyrightHeaderEvidence {
    [CmdletBinding()]
    param(
        [AllowNull()][object]$Evidence,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][AllowEmptyString()][string]$Content
    )
    if ($Evidence -isnot [Collections.IDictionary] -or
        (@($Evidence.Keys | Sort-Object -CaseSensitive) -join "`n") -cne
            "changeType`nkind`noldPath`norigin`npath`nschemaVersion`nsourceCommit`nsourceDigest`nsourceHeaderState`ntargetCommit`ntargetDigest`ntargetHeaderState" -or
        [int]$Evidence.schemaVersion -ne 1 -or
        [string]$Evidence.kind -cne 'contextual-copyright-header-v1' -or
        [string]$Evidence.path -cne $Path -or
        [string]$Evidence.changeType -cnotin @('added', 'modified', 'renamed') -or
        [string]$Evidence.sourceCommit -cnotmatch '^[0-9a-f]{40}$' -or
        [string]$Evidence.targetCommit -cnotmatch '^[0-9a-f]{40}$' -or
        [string]$Evidence.sourceDigest -cne (Get-ContextualTextDigest $Content) -or
        [string]$Evidence.targetDigest -cnotmatch '^v1:sha256:[0-9a-f]{64}$' -or
        [string]$Evidence.sourceHeaderState -cne
            (Get-ContextualCopyrightHeaderState -Content $Content -Path $Path)) {
        return $false
    }
    if ([string]$Evidence.changeType -ceq 'renamed') {
        if ([string]::IsNullOrWhiteSpace([string]$Evidence.oldPath) -or
            [string]$Evidence.oldPath -ieq $Path) { return $false }
    }
    elseif ($null -ne $Evidence.oldPath) { return $false }
    if ([string]$Evidence.changeType -ceq 'added') {
        if ([string]$Evidence.targetHeaderState -cne 'absent-added' -or
            [string]$Evidence.targetDigest -cne (Get-ContextualTextDigest '')) {
            return $false
        }
    }
    elseif ([string]$Evidence.targetHeaderState -cnotin @('present', 'missing', 'excluded')) {
        return $false
    }
    $origin = if ([string]$Evidence.sourceHeaderState -cin @('present', 'excluded')) {
        'not-applicable'
    }
    elseif ([string]$Evidence.targetHeaderState -cin @('present', 'absent-added')) {
        'introduced'
    }
    elseif ([string]$Evidence.targetHeaderState -ceq 'missing') { 'pre-existing' }
    else { 'unknown' }
    return [string]$Evidence.origin -ceq $origin -and $origin -cne 'unknown'
}

function Get-ContextualCopyrightHeaderOutcome {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][AllowEmptyString()][string]$Content,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][AllowEmptyCollection()][object[]]$SnapshotFiles
    )
    $files = @($SnapshotFiles | Where-Object { [string]$_.path -ceq $Path })
    $file = if ($files.Count -eq 1) { $files[0] } else { $null }
    $excluded = -not $Path.EndsWith('.cs', [StringComparison]::OrdinalIgnoreCase) -or
        ($null -ne $file -and (
            ($file.Contains('contextOnly') -and [bool]$file.contextOnly) -or
            ($file.Contains('changeType') -and [string]$file.changeType -ceq 'deleted'))) -or
        (Get-ContextualCopyrightHeaderState -Content $Content -Path $Path) -ceq 'excluded'
    if ($excluded) {
        return New-ContextualOutcome -RuleId file-copyright-header -State compliant `
            -Reason copyright-file-excluded -Path $Path
    }
    $proof = if ($null -ne $file -and $file.Contains('fileHeader')) { $file.fileHeader } else { $null }
    if ($null -eq $file -or
        ([string]$file.state -cne 'complete' -and
            (-not $file.Contains('sourceState') -or [string]$file.sourceState -cne 'complete')) -or
        -not (Test-ContextualCopyrightHeaderEvidence -Evidence $proof -Path $Path -Content $Content)) {
        return New-ContextualOutcome -RuleId file-copyright-header -State unknown `
            -Reason copyright-source-target-proof-unavailable -Path $Path
    }
    if ([string]$proof.sourceHeaderState -ceq 'present') {
        return New-ContextualOutcome -RuleId file-copyright-header -State compliant `
            -Reason standard-copyright-header-present -Path $Path
    }
    $outcome = New-ContextualOutcome -RuleId file-copyright-header -State violation `
        -Reason "missing-copyright-header-$([string]$proof.origin)" -Path $Path `
        -Line 1 -EndLine 1 -Symbol copyright-header `
        -Evidence 'Add the standard Microsoft copyright header before the code in this changed file.'
    $outcome['fileHeader'] = $proof
    return $outcome
}

function New-ContextualOutcome {
    param(
        [Parameter(Mandatory)][string]$RuleId,
        [Parameter(Mandatory)]
        [ValidateSet('compliant', 'violation', 'unknown')]
        [string]$State,
        [Parameter(Mandatory)][string]$Reason,
        [Parameter(Mandatory)][string]$Path,
        [int]$Line = 0,
        [int]$EndLine = 0,
        [string]$Symbol = 'file',
        [string]$Evidence = ''
    )
    $outcome = [ordered]@{
        ruleId = $RuleId
        state = $State
        reason = $Reason
        path = $Path
        line = $Line
        endLine = $EndLine
        symbol = $Symbol
        evidence = $Evidence
    }
    if ($State -ceq 'violation') {
        $collector = Get-Variable `
            -Name contextualCandidateOutcomes `
            -Scope 1 -ErrorAction SilentlyContinue
        if ($null -ne $collector -and
            $collector.Value -is
                [Collections.Generic.List[object]]) {
            [void]$collector.Value.Add($outcome)
        }
    }
    return $outcome
}

function Get-ContextualTextDigest {
        param(
            [Parameter(Mandatory)]
            [AllowEmptyString()]
            [string]$Value
        )
        return 'v1:sha256:' + [Convert]::ToHexString(
            [Security.Cryptography.SHA256]::HashData(
                [Text.UTF8Encoding]::new($false).GetBytes($Value))).
            ToLowerInvariant()
    }

    function Get-ContextualMarkdownSections {
        param(
            [Parameter(Mandatory)]
            [AllowEmptyString()]
            [string]$Content
        )
        $sections = [Collections.Generic.List[object]]::new()
        $current = $null
        $fence = $null
        $lineNumber = 0
        foreach ($line in [regex]::Split($Content, '\r?\n')) {
            $lineNumber++
            if ($line -match '^\s{0,3}>') {
                continue
            }
            if ($line -match '^\s{0,3}(?<fence>`{3,}|~{3,})') {
                $marker = [string]$Matches.fence
                if ($null -eq $fence) {
                    $fence = $marker.Substring(0, 1)
                }
                elseif ($marker.StartsWith(
                        [string]$fence,
                        [StringComparison]::Ordinal)) {
                    $fence = $null
                }
                continue
            }
            if ($null -ne $fence) {
                continue
            }
            $heading = $null
            if ($line -match
                '^\s{0,3}#{1,6}\s+(?<heading>.+?)\s*#*\s*$') {
                $heading = [string]$Matches.heading
            }
            elseif ($line -match
                '^\s*\*\*\s*(?<heading>[^*]{1,128}?)\s*:?\s*\*\*\s*$') {
                $heading = [string]$Matches.heading
            }
            if ($null -ne $heading) {
                $name = ($heading.Trim().TrimEnd(':').Trim() -replace
                        '\s+', ' ').ToLowerInvariant()
                $current = [ordered]@{
                    name = $name
                    line = $lineNumber
                    lines = [Collections.Generic.List[string]]::new()
                }
                [void]$sections.Add($current)
                continue
            }
            if ($null -ne $current) {
                [void]$current.lines.Add([string]$line)
            }
        }
        return $sections.ToArray()
    }

    function Test-ContextualMeaningfulSection {
        param(
            [Parameter(Mandatory)][object]$Section,
            [Parameter(Mandatory)]
            [AllowEmptyCollection()]
            [Collections.Generic.HashSet[string]]$PlaceholderLines
        )
        foreach ($line in @($Section.lines)) {
            $text = ([string]$line).Trim()
            if (-not $text -or
                $text -match '^<!--.*-->$' -or
                $text -match '^[-*+]\s+\[[ xX]\]\s+' -or
                $text -match '^(?i)(?:todo|tbd|n/?a|none|unknown|placeholder)[.!:;\s-]*$' -or
                $text -match '^<[^>]+>$') {
                continue
            }
            $normalized = ($text -replace '\s+', ' ').
                ToLowerInvariant()
            if ($PlaceholderLines.Contains($normalized)) {
                continue
            }
            return $true
        }
        return $false
    }

    function Get-ContextualPullRequestTemplateOutcome {
        [CmdletBinding()]
        param(
            [Parameter(Mandatory)]
            [Collections.IDictionary]$Metadata
        )
        $ruleId = 'pr-template-compliance'
        if ([string]$Metadata.state -cne 'complete') {
            return [ordered]@{
                ruleId = $ruleId
                state = 'unknown'
                reason = 'pr-template-authority-unavailable'
                missingSections = @()
                evidence = ''
            }
        }
        $template = $Metadata.template
        if ($template -isnot [Collections.IDictionary] -or
            [string]$Metadata.title -cne
                ([string]$Metadata.title).Trim() -or
            ([string]$Metadata.title).Length -gt 4096 -or
            ([string]$Metadata.description).Length -gt 131072 -or
            [string]$Metadata.descriptionDigest -cnotmatch
                '^v1:sha256:[0-9a-f]{64}$' -or
            [string]$Metadata.descriptionDigest -cne
                (Get-ContextualTextDigest `
                    -Value ([string]$Metadata.description)) -or
            [string]$template.path -cnotmatch
                '^/\.azuredevops/pull_request_template\.(?:md|txt)$' -or
            [string]$template.configurationRef -cnotmatch
                '^refs/heads/[^~^:?*\[\\]+$' -or
            [string]$template.configurationCommit -cnotmatch
                '^[0-9a-f]{40}$' -or
            [string]$template.blob -cnotmatch
                '^[0-9a-f]{40}$' -or
            [string]$template.contentDigest -cnotmatch
                '^v1:sha256:[0-9a-f]{64}$' -or
            [string]$template.contentDigest -cne
                (Get-ContextualTextDigest `
                    -Value ([string]$template.content)) -or
            [Text.Encoding]::UTF8.GetByteCount(
                [string]$template.content) -gt 65536) {
            return [ordered]@{
                ruleId = $ruleId
                state = 'unknown'
                reason = 'pr-template-authority-malformed'
                missingSections = @()
                evidence = ''
            }
        }

        $required = @('problem', 'solution', 'validation')
        $templateSections = @(
            Get-ContextualMarkdownSections `
                -Content ([string]$template.content))
        $templateRequiredValid = $true
        foreach ($requiredName in $required) {
            if (@($templateSections |
                    Where-Object {
                        [string]$_.name -ceq
                            $requiredName
                    }).Count -ne 1) {
                $templateRequiredValid = $false
                break
            }
        }
        if (-not $templateRequiredValid) {
            return [ordered]@{
                ruleId = $ruleId
                state = 'unknown'
                reason = 'pr-template-required-sections-unproven'
                missingSections = @()
                evidence = ''
            }
        }

        $descriptionSections = @(
            Get-ContextualMarkdownSections `
                -Content ([string]$Metadata.description))
        $missing = [Collections.Generic.List[string]]::new()
        foreach ($name in $required) {
            $matches = @($descriptionSections | Where-Object {
                    [string]$_.name -ceq $name
                })
            if ($matches.Count -ne 1) {
                [void]$missing.Add(
                    [Globalization.CultureInfo]::InvariantCulture.
                        TextInfo.ToTitleCase($name))
                continue
            }
            $placeholders =
                [Collections.Generic.HashSet[string]]::new(
                    [StringComparer]::OrdinalIgnoreCase)
            $templateSection = @($templateSections |
                Where-Object {
                    [string]$_.name -ceq $name
                })[0]
            foreach ($line in @($templateSection.lines)) {
                $text = ([string]$line).Trim()
                if ($text) {
                    [void]$placeholders.Add(
                        ($text -replace '\s+', ' ').
                        ToLowerInvariant())
                }
            }
            if (-not (Test-ContextualMeaningfulSection `
                    -Section $matches[0] `
                    -PlaceholderLines $placeholders)) {
                [void]$missing.Add(
                    [Globalization.CultureInfo]::InvariantCulture.
                        TextInfo.ToTitleCase($name))
            }
        }
        if ($missing.Count -gt 0) {
            return [ordered]@{
                ruleId = $ruleId
                state = 'violation'
                reason = 'required-pr-template-sections-missing-or-placeholder'
                missingSections = $missing.ToArray()
                evidence = (
                    'Add meaningful content under the required PR description ' +
                    "sections: $($missing -join ', ').")
            }
        }
        return [ordered]@{
            ruleId = $ruleId
            state = 'compliant'
            reason = 'required-pr-template-sections-complete'
            missingSections = @()
            evidence = ''
        }
}

function Test-ContextualChangedLine {
    param([int]$Line, [object[]]$Spans)
    return @($Spans | Where-Object {
            $Line -ge [int]$_.startLine -and
            $Line -le [int]$_.endLine
        }).Count -gt 0
}

function Get-ContextualTokenModel {
    param([Parameter(Mandatory)][string]$Content)
    $scan = & (Get-Module DevPilot.TestClassCoverage) {
        param($Text)
        Get-CoverageTokens -Text $Text -IncludeLiteralTokens
    } $Content
    $tokens = @($scan.tokens)
    $lines = [ordered]@{}
    foreach ($token in $tokens) {
        $line = [string][int]$token.line
        if (-not $lines.Contains($line)) {
            $lines[$line] =
                [Collections.Generic.List[string]]::new()
        }
        [void]$lines[$line].Add([string]$token.text)
    }
    $stack = [Collections.Generic.Stack[string]]::new()
    $pairs = @{
        ')' = '('
        ']' = '['
        '}' = '{'
    }
    $unbalanced = $false
    foreach ($token in $tokens) {
        $text = [string]$token.text
        if ($text -in @('(', '[', '{')) {
            $stack.Push($text)
        }
        elseif ($pairs.Contains($text)) {
            if ($stack.Count -eq 0 -or
                $stack.Pop() -cne $pairs[$text]) {
                $unbalanced = $true
                break
            }
        }
    }
    return [ordered]@{
        tokens = $tokens
        lines = $lines
        malformed = [bool](
            $scan.unterminated -or $scan.conditional -or
            $unbalanced -or $stack.Count -gt 0)
    }
}

function Find-ContextualTokenSequence {
    param(
        [Parameter(Mandatory)][object[]]$Tokens,
        [Parameter(Mandatory)][string[]]$Sequence,
        [Parameter(Mandatory)][object[]]$Spans
    )
    for ($index = 0;
        $index -le $Tokens.Count - $Sequence.Count;
        $index++) {
        $matched = $true
        for ($offset = 0;
            $offset -lt $Sequence.Count;
            $offset++) {
            if ([string]$Tokens[
                    $index + $offset].text -cne
                $Sequence[$offset]) {
                $matched = $false
                break
            }
        }
        if ($matched -and
            (Test-ContextualChangedLine `
                -Line ([int]$Tokens[$index].line) `
                -Spans $Spans)) {
            return $Tokens[$index]
        }
    }
    return $null
}

function Get-ContextualLineText {
    param(
        [Parameter(Mandatory)]
        [Collections.IDictionary]$Lines,
        [Parameter(Mandatory)][int]$Line
    )
    $key = [string]$Line
    if (-not $Lines.Contains($key)) {
        return ''
    }
    return @($Lines[$key]) -join ' '
}

function Find-ContextualChangedLine {
    param(
        [Parameter(Mandatory)]
        [Collections.IDictionary]$Lines,
        [Parameter(Mandatory)][object[]]$Spans,
        [Parameter(Mandatory)][scriptblock]$Predicate
    )
    foreach ($key in @($Lines.Keys |
            Sort-Object { [int]$_ })) {
        $line = [int]$key
        if (-not (Test-ContextualChangedLine `
                -Line $line -Spans $Spans)) {
            continue
        }
        $text = Get-ContextualLineText `
            -Lines $Lines -Line $line
        if (& $Predicate $text) {
            return [ordered]@{
                line = $line
                text = $text
            }
        }
    }
    return $null
}

function Get-ContextualCSharpOutcomes {
    param(
        [Parameter(Mandatory)][string]$Content,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$Spans
    )
    $model = Get-ContextualTokenModel -Content $Content
    $tokens = @($model.tokens)
    $lines = $model.lines
    $joined = @($tokens.text) -join ' '
    $contextualCandidateOutcomes =
        [Collections.Generic.List[object]]::new()
    $results = [ordered]@{}
    foreach ($rule in $script:RuleIds) {
        $results[$rule] = New-ContextualOutcome `
            -RuleId $rule -State compliant `
            -Reason 'no-applicable-violation' `
            -Path $Path
    }

    $logLine = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        $text -match
            '(Logger\s*\.\s*(?:Error|Critical)|\.\s*LogError)\s*\(' -and
        $text -match
            '\b(?:ex|exception)\s*\.\s*Message\b' -and
        $text -notmatch
            '\bexception\s*:\s*(?:ex|exception)\b'
    }
    if ($null -ne $logLine) {
        $results['exception-logging'] =
            New-ContextualOutcome `
                -RuleId exception-logging `
                -State violation `
                -Reason exception-object-not-logged `
                -Path $Path -Line $logLine.line `
                -EndLine $logLine.line `
                -Evidence (
                    'The logger receives exception text ' +
                    'but not the caught exception object.')
    }
    elseif ($joined -match
        '\bexception\s*:\s*(?:ex|exception)\b') {
        $results['exception-logging'] =
            New-ContextualOutcome `
                -RuleId exception-logging `
                -State compliant `
                -Reason terminal-exception-log `
                -Path $Path
    }

    $throwToken = Find-ContextualTokenSequence `
        -Tokens $tokens `
        -Sequence @('throw', 'ex', ';') `
        -Spans $Spans
    if ($null -ne $throwToken) {
        $results['exception-propagation'] =
            New-ContextualOutcome `
                -RuleId exception-propagation `
                -State violation `
                -Reason throw-expression-resets-stack `
                -Path $Path -Line ([int]$throwToken.line) `
                -EndLine ([int]$throwToken.line) `
                -Evidence (
                    'Rethrow the active exception with ' +
                    'a bare throw statement.')
    }
    else {
        $catchLine = Find-ContextualChangedLine `
            -Lines $lines -Spans $Spans -Predicate {
            param($text)
            $text -match
                'catch\s*\(\s*(?:System\s*\.\s*)?Exception\b' -and
            $text -notmatch
                'when\s*\(\s*!\s*\w+\s*\.\s*IsFatal\s*\('
        }
        if ($null -ne $catchLine -and
            $joined -notmatch
                'catch\s*\([^)]*Exception[^)]*\)\s*\{\s*throw\s*;') {
            $results['exception-propagation'] =
                New-ContextualOutcome `
                    -RuleId exception-propagation `
                    -State violation `
                    -Reason fatal-exception-filter-missing `
                    -Path $Path -Line $catchLine.line `
                    -EndLine $catchLine.line `
                    -Evidence (
                        'A generic catch handles fatal ' +
                        'exceptions without a when filter.')
        }
    }

    $messageDecision = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        $text -match
            '\b(?:if|switch)\b.*\b(?:ex|exception)\s*\.\s*(?:Message|StackTrace)\b'
    }
    if ($null -ne $messageDecision) {
        $results['type-based-decisions'] =
            New-ContextualOutcome `
                -RuleId type-based-decisions `
                -State violation `
                -Reason exception-text-controls-behavior `
                -Path $Path -Line $messageDecision.line `
                -EndLine $messageDecision.line `
                -Evidence (
                    'Branch on an exception type or typed ' +
                    'status instead of exception text.')
    }

    $stringVariables =
        [Collections.Generic.HashSet[string]]::new(
            [StringComparer]::Ordinal)
    for ($index = 0;
        $index -lt $tokens.Count - 1; $index++) {
        if ([string]$tokens[$index].text -ceq
                'string' -and
            [string]$tokens[$index + 1].text -cmatch
                '^@?[\p{L}_][\p{L}\p{N}_]*$') {
            [void]$stringVariables.Add(
                ([string]$tokens[$index + 1].text).
                    TrimStart('@'))
        }
    }
    $stringComparison = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        if ($text -match
            'StringComparison\s*\.|EqualsOrdinalInsensitively') {
            return $false
        }
        foreach ($name in $stringVariables) {
            if ($text -match (
                    "(?:\b$([regex]::Escape($name))\b\s*" +
                    "(?:=\s*=|!\s*=)|(?:=\s*=|!\s*=)\s*" +
                    "\b$([regex]::Escape($name))\b)")) {
                return $true
            }
        }
        return $text -match
            '\b(?:string|String)\s*\.\s*Equals\s*\([^,]+,[^,\)]+\)'
    }
    if ($null -ne $stringComparison) {
        $results['explicit-string-comparison'] =
            New-ContextualOutcome `
                -RuleId explicit-string-comparison `
                -State violation `
                -Reason string-comparison-not-explicit `
                -Path $Path -Line $stringComparison.line `
                -EndLine $stringComparison.line `
                -Evidence (
                    'Use explicit StringComparison semantics ' +
                    'or the canonical ordinal helper.')
    }

    $firstLine = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        $text -match
            '\.\s*First(?:OrDefault)?\s*\(' -or
        $text -match '\[\s*0\s*\]'
    }
    if ($null -ne $firstLine) {
        if ($joined -match
            '\.\s*OrderBy' -or
            $joined -match
            '\.\s*Count\s*(?:==|!=)\s*1' -or
            $joined -match
            '\.\s*Single(?:OrDefault)?\s*\(') {
            $results['collection-cardinality'] =
                New-ContextualOutcome `
                    -RuleId collection-cardinality `
                    -State compliant `
                    -Reason ordered-or-cardinality-validated `
                    -Path $Path -Line $firstLine.line `
                    -EndLine $firstLine.line
        }
        elseif ($joined -match
            '\.\s*Where\s*\(' -or
            $joined -match '\.\s*ToList\s*\(') {
            $results['collection-cardinality'] =
                New-ContextualOutcome `
                    -RuleId collection-cardinality `
                    -State violation `
                    -Reason ambiguous-first-selection `
                    -Path $Path -Line $firstLine.line `
                    -EndLine $firstLine.line `
                    -Evidence (
                        'Validate unique cardinality and use ' +
                        'Single, or order selection deliberately.')
        }
        else {
            $results['collection-cardinality'] =
                New-ContextualOutcome `
                    -RuleId collection-cardinality `
                    -State unknown `
                    -Reason collection-origin-or-order-unknown `
                    -Path $Path -Line $firstLine.line `
                    -EndLine $firstLine.line
        }
    }

    $validatorLine = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        $text -match '(?i)validat\w*\s*='
    }
    if ($null -ne $validatorLine) {
        if ($joined -match
            '(?i)validat\w*\s*=.*(?:await|Async\s*\(|File\s*\.|HttpClient|Repository\s*\.)') {
            $results['cheap-validation'] =
                New-ContextualOutcome `
                    -RuleId cheap-validation `
                    -State violation `
                    -Reason validation-delegate-does-io-or-heavy-work `
                    -Path $Path -Line $validatorLine.line `
                    -EndLine $validatorLine.line `
                    -Evidence (
                        'Keep request validation delegates to ' +
                        'cheap in-memory sanity checks.')
        }
        else {
            $results['cheap-validation'] =
                New-ContextualOutcome `
                    -RuleId cheap-validation `
                    -State compliant `
                    -Reason validation-delegate-is-in-memory `
                    -Path $Path -Line $validatorLine.line `
                    -EndLine $validatorLine.line
        }
    }

    $resultLine = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        $text -match '\.\s*(?:Result|Wait)\b'
    }
    if ($null -ne $resultLine -and
        $joined -match '\b\w+Async\b') {
        $results['async-all-the-way'] =
            New-ContextualOutcome `
                -RuleId async-all-the-way `
                -State violation `
                -Reason task-blocking `
                -Path $Path -Line $resultLine.line `
                -EndLine $resultLine.line `
                -Evidence (
                    'Await asynchronous work rather than ' +
                    'blocking on Result or Wait.')
    }

    $syncIo = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        $text -match
            '\bFile\s*\.\s*(?:ReadAllText|ReadAllBytes|WriteAllText|WriteAllBytes)\s*\(' -or
        $text -match
            '\.\s*(?:ReadToEnd|Read|Write)\s*\('
    }
    if ($null -ne $syncIo -and
        $joined -match '\basync\b') {
        $results['async-io'] =
            New-ContextualOutcome `
                -RuleId async-io -State violation `
                -Reason synchronous-io-in-async-method `
                -Path $Path -Line $syncIo.line `
                -EndLine $syncIo.line `
                -Evidence (
                    'Use the supported asynchronous I/O API.')
    }

    $blockingWait = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        $text -match
            '\bThread\s*\.\s*Sleep\s*\(' -or
        $text -match '\.\s*WaitOne\s*\('
    }
    if ($null -ne $blockingWait -and
        $joined -match '\basync\b') {
        $results['async-wait-sync'] =
            New-ContextualOutcome `
                -RuleId async-wait-sync `
                -State violation `
                -Reason blocking-wait-in-async-context `
                -Path $Path -Line $blockingWait.line `
                -EndLine $blockingWait.line `
                -Evidence (
                    'Use Task.Delay with cancellation or an ' +
                    'async-compatible synchronization primitive.')
    }

    $httpLine = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        $text -match '\bnew\s+HttpClient\s*\('
    }
    if ($null -ne $httpLine) {
        $systemHttpClient =
            $joined -match
                '\busing\s+System\s*\.\s*Net\s*\.\s*Http\s*;' -or
            $joined -match
                '\bnew\s+System\s*\.\s*Net\s*\.\s*Http\s*\.\s*HttpClient\s*\('
        $shared = $joined -match
            '\bstatic\s+readonly\s+HttpClient\b' -or
            $joined -match '\bIHttpClientFactory\b'
        $results['http-client-lifetime'] = if (
            -not $systemHttpClient) {
            New-ContextualOutcome `
                -RuleId http-client-lifetime `
                -State unknown `
                -Reason http-client-type-unproven `
                -Path $Path -Line $httpLine.line `
                -EndLine $httpLine.line
        }
        else {
            New-ContextualOutcome `
                -RuleId http-client-lifetime `
                -State $(if ($shared) {
                    'compliant'
                } else { 'violation' }) `
                -Reason $(if ($shared) {
                    'shared-or-factory-managed-client'
                } else {
                    'request-path-http-client-construction'
                }) `
                -Path $Path -Line $httpLine.line `
                -EndLine $httpLine.line `
                -Evidence $(if ($shared) { '' } else {
                    'Reuse a shared HttpClient or obtain one ' +
                    'from IHttpClientFactory.'
                })
        }
    }

    $lazyLine = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        $text -match
            '\bif\s*\([^)]*\b\w+\s*=\s*=\s*null' -or
        $text -match '\?\?='
    }
    if ($null -ne $lazyLine -and
        $joined -match '\bstatic\b' -and
        $joined -notmatch
            '\b(?:Lazy|Interlocked|lock)\b') {
        $results['thread-safe-immutable'] =
            New-ContextualOutcome `
                -RuleId thread-safe-immutable `
                -State violation `
                -Reason unsynchronized-shared-initialization `
                -Path $Path -Line $lazyLine.line `
                -EndLine $lazyLine.line `
                -Evidence (
                    'Use Lazy<T>, Interlocked, or a proven ' +
                    'synchronization boundary for shared state.')
    }

    $reflectionMatches = @(
        foreach ($key in @($lines.Keys |
                Sort-Object { [int]$_ })) {
            $line = [int]$key
            $text = Get-ContextualLineText `
                -Lines $lines -Line $line
            if ($text -match
                '\.\s*Get(?:Method|Methods|Property|Properties|CustomAttributes)\s*\(') {
                [ordered]@{
                    line = $line
                    text = $text
                }
            }
        })
    $reflectionLine = @($reflectionMatches |
        Where-Object {
            Test-ContextualChangedLine `
                -Line $_.line -Spans $Spans
        } | Select-Object -First 1)
    $reflectionRepeated =
        ([regex]::Matches(
                $joined,
                '\.\s*Get(?:Method|Methods|Property|Properties|CustomAttributes)\s*\(')).Count -gt 1 -or
        $joined -match
            '\b(?:for|foreach|while)\s*\([^)]*\).*Get(?:Method|Methods|Property|Properties|CustomAttributes)'
    if ($reflectionLine.Count -gt 0 -and
        $reflectionRepeated) {
        $cached = $joined -match
            '\bstatic\s+readonly\b.*\.\s*Get'
        $results['cache-streaming'] =
            New-ContextualOutcome `
                -RuleId cache-streaming `
                -State $(if ($cached) {
                    'compliant'
                } else { 'violation' }) `
                -Reason $(if ($cached) {
                    'expensive-work-cached'
                } else {
                    'repeated-reflection-not-cached'
                }) `
                -Path $Path -Line $reflectionLine[0].line `
                -EndLine $reflectionLine[0].line `
                -Evidence $(if ($cached) { '' } else {
                    'Cache repeated reflection or metadata ' +
                    'lookup results.'
                })
    }
    $bufferLine = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        $text -match
            '\.\s*(?:ReadAsByteArrayAsync|ReadAsStringAsync|ReadToEndAsync)\s*\('
    }
    if ($null -ne $bufferLine -and
        $joined -match
            '(?i)(?:ContentLength|Length)\s*(?:>|>=)\s*(?:1048576|1_048_576|[2-9][0-9]{6,})') {
        $results['cache-streaming'] =
            New-ContextualOutcome `
                -RuleId cache-streaming `
                -State violation `
                -Reason proven-large-payload-fully-buffered `
                -Path $Path -Line $bufferLine.line `
                -EndLine $bufferLine.line `
                -Evidence (
                    'Stream the payload instead of fully buffering ' +
                    'a response proven to exceed the large-payload bound.')
    }

    $jObjectVariables =
        [Collections.Generic.HashSet[string]]::new(
            [StringComparer]::Ordinal)
    for ($index = 0;
        $index -lt $tokens.Count - 1; $index++) {
        if ([string]$tokens[$index].text -ceq
                'JObject' -and
            [string]$tokens[$index + 1].text -cmatch
                '^@?[\p{L}_][\p{L}\p{N}_]*$') {
            [void]$jObjectVariables.Add(
                ([string]$tokens[$index + 1].text).
                    TrimStart('@'))
        }
    }
    foreach ($name in $jObjectVariables) {
        $count = ([regex]::Matches(
                $joined,
                "\b$([regex]::Escape($name))\s*\[\s*__literal__\s*\]")).Count
        if ($count -ge 2 -and
            $joined -notmatch '(?i)dynamic|extension') {
            $line = @($tokens | Where-Object {
                    [string]$_.text -ceq $name -and
                    (Test-ContextualChangedLine `
                        -Line ([int]$_.line) `
                        -Spans $Spans)
                } | Select-Object -First 1)
            $results['typed-contracts'] =
                New-ContextualOutcome `
                    -RuleId typed-contracts `
                    -State violation `
                    -Reason fixed-contract-accessed-by-json-keys `
                    -Path $Path `
                    -Line $(if ($line.Count) {
                        [int]$line[0].line
                    } else { 0 }) `
                    -Evidence (
                        'Declare and deserialize a typed ' +
                        'contract instead of repeatedly indexing known JSON fields.')
            break
        }
    }
    if ($joined -match
        '\[\s*JsonObject\s*\]|\[\s*JsonProperty') {
        $typeOptIn = $joined -match
            '\[\s*JsonObject\s*\(\s*MemberSerialization\s*\.\s*OptIn\s*\)\s*\]'
        $propertyLine = Find-ContextualChangedLine `
            -Lines $lines -Spans $Spans -Predicate {
            param($text)
            $text -match
                '\bpublic\s+[\w<>\[\]\?]+\s+\w+\s*\{\s*get\s*;'
        }
        if ($null -ne $propertyLine -and
            -not $typeOptIn -and
            $propertyLine.text -notmatch
                'JsonProperty|JsonIgnore|JsonInclude|JsonPropertyName|DataMember|IgnoreDataMember') {
            $results['json-contracts'] =
                New-ContextualOutcome `
                    -RuleId json-contracts `
                    -State violation `
                    -Reason json-property-not-declared `
                    -Path $Path -Line $propertyLine.line `
                    -EndLine $propertyLine.line `
                    -Evidence (
                        'Declare the serialized wire property ' +
                        'explicitly or ignore it deliberately.')
        }
    }

    $apiError = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        $text -match
            '\bnew\s+(?:Exception|InvalidOperationException)\s*\('
    }
    if ($null -ne $apiError -and
        ($joined -match
            'Controller|ApiEngine|\[\s*Http') -and
        $joined -notmatch
            'ErrorResponseMessage|GenerateResponseMessageFromException') {
        $results['api-errors'] =
            New-ContextualOutcome `
                -RuleId api-errors -State violation `
                -Reason nonstandard-api-error-path `
                -Path $Path -Line $apiError.line `
                -EndLine $apiError.line `
                -Evidence (
                    'Use the repository actionable API error contract.')
    }

    $secretLine = Find-ContextualChangedLine `
        -Lines $lines -Spans $Spans -Predicate {
        param($text)
        $text -match
            '(?i)\b(?:response|result)\s*\.\s*(?:password|secret|token|authorization|connectionString|apiKey)\s*='
    }
    if ($null -ne $secretLine) {
        $redacted = $secretLine.text -match
            '(?i)Redact|Mask|Sanitize'
        $rhsSensitive = $secretLine.text -match
            '(?i)=.*\b(?:password|secret|token|authorization|connectionString|apiKey)\b'
        $coldCache = $joined -match
            '(?i)\b(?:cache|cached|metadata)\b.*(?:=\s*=\s*null|is\s+null|miss)'
        if ($redacted) {
            $results['secret-redaction'] =
                New-ContextualOutcome `
                    -RuleId secret-redaction `
                    -State compliant `
                    -Reason response-value-redacted `
                    -Path $Path -Line $secretLine.line `
                    -EndLine $secretLine.line
        }
        elseif ($rhsSensitive -and $coldCache) {
            $results['secret-redaction'] =
                New-ContextualOutcome `
                    -RuleId secret-redaction `
                    -State violation `
                    -Reason cold-cache-sensitive-value-reaches-response `
                    -Path $Path -Line $secretLine.line `
                    -EndLine $secretLine.line `
                    -Evidence (
                        'Redact the sensitive field on the ' +
                        'proven cache-miss response path.')
        }
        else {
            $results['secret-redaction'] =
                New-ContextualOutcome `
                    -RuleId secret-redaction `
                    -State unknown `
                    -Reason sensitive-flow-or-cache-path-unproven `
                    -Path $Path -Line $secretLine.line `
                    -EndLine $secretLine.line
        }
    }

    if ($model.malformed) {
        foreach ($rule in $script:RuleIds) {
            if ([string]$results[$rule].state -cne
                'unknown') {
                $results[$rule].state = 'unknown'
                $results[$rule].reason =
                    'csharp-syntax-incomplete'
                $results[$rule].evidence = ''
            }
        }
    }
    return @($script:RuleIds | ForEach-Object {
            $results[$_]
        })
}

function Get-ContextualDependencyOutcome {
    param(
        [Parameter(Mandatory)][string]$Content,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    if ($Path -notmatch
        '(?i)(?:\.csproj|\.props|packages\.config)$') {
        return New-ContextualOutcome `
            -RuleId dependency-fanout `
            -State compliant `
            -Reason no-applicable-violation `
            -Path $Path
    }
    $matches = [regex]::Matches(
        $Content,
        '(?i)(?:PackageReference\s+Include|package\s+id)\s*=\s*["''](?<id>[^"'']+)["'']')
    if ($matches.Count -eq 0) {
        return New-ContextualOutcome `
            -RuleId dependency-fanout `
            -State compliant `
            -Reason no-applicable-violation `
            -Path $Path
    }
    $packageId = $matches[0].Groups['id'].Value
    $projectDirectory = [IO.Path]::GetDirectoryName(
        $Path.Replace('/', '\'))
    $activePackageReference = $Path.EndsWith(
            '.csproj',
            [StringComparison]::OrdinalIgnoreCase) -and
        $Content -match
            '(?is)<RestoreProjectStyle>\s*PackageReference\s*</RestoreProjectStyle>'
    $companion = @($SnapshotFiles | Where-Object {
            [string]$_.path -cne $Path -and
            [IO.Path]::GetDirectoryName(
                ([string]$_.path).Replace('/', '\')) -ceq
                $projectDirectory -and
            (-not $activePackageReference -or
                -not ([string]$_.path).EndsWith(
                    'packages.config',
                    [StringComparison]::OrdinalIgnoreCase)) -and
            [string]$_.content -match
                [regex]::Escape($packageId)
        })
    if ($companion.Count -eq 0) {
        return New-ContextualOutcome `
            -RuleId dependency-fanout `
            -State unknown `
            -Reason affected-dependency-graph-not-present `
            -Path $Path -Line 1 -EndLine 1 `
            -Symbol $packageId
    }
    $versions = @(
        @([ordered]@{
                content = $Content
                path = $Path
            }) + @($companion) |
            ForEach-Object {
                [regex]::Matches(
                    [string]$_.content,
                    ('(?i)' +
                        [regex]::Escape($packageId) +
                        '[^\r\n>]{0,256}(?:Version\s*=\s*["'']|version\s*=\s*["''])(?<version>[^"'']+)')) |
                    ForEach-Object {
                        $_.Groups['version'].Value
                    }
            } | Sort-Object -Unique)
    if ($versions.Count -gt 1) {
        return New-ContextualOutcome `
            -RuleId dependency-fanout `
            -State violation `
            -Reason dependency-version-mismatch `
            -Path $Path -Line 1 -EndLine 1 `
            -Symbol $packageId `
            -Evidence (
                'The same changed dependency has inconsistent ' +
                'versions across proven affected surfaces.')
    }
    return New-ContextualOutcome `
        -RuleId dependency-fanout `
        -State compliant `
        -Reason changed-dependency-surfaces-consistent `
        -Path $Path -Line 1 -EndLine 1 `
        -Symbol $packageId
}

function Get-ContextualNodeLine {
    param([Parameter(Mandatory)]$Node)
    return [int](
        $Node.GetLocation().
            GetLineSpan().StartLinePosition.Line + 1)
}

function Test-ContextualNodeChanged {
    param(
        [Parameter(Mandatory)]$Node,
        [Parameter(Mandatory)][object[]]$Spans
    )
    $lineSpan = $Node.GetLocation().GetLineSpan()
    $first = [int]$lineSpan.StartLinePosition.Line + 1
    $last = [int]$lineSpan.EndLinePosition.Line + 1
    return @($Spans | Where-Object {
            $first -le [int]$_.endLine -and
            $last -ge [int]$_.startLine
        }).Count -gt 0
}

function Test-ContextualEquivalentGroupRepresentativeSelection {
    param(
        [Parameter(Mandatory)]$Invocation,
        [Parameter(Mandatory)]$Method
    )

    $lambda = $Invocation.Parent
    if ($lambda -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.SimpleLambdaExpressionSyntax] -or
        $lambda.Body -ne $Invocation) {
        return $false
    }
    $groupParameter = [string]$lambda.Parameter.Identifier.ValueText
    if ([string]::IsNullOrWhiteSpace($groupParameter) -or
        [string]$Invocation.Expression.Expression.ToString() -cne
            $groupParameter) {
        return $false
    }
    $select = $lambda.Parent.Parent.Parent
    if ($select -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax] -or
        $select.Expression -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax] -or
        [string]$select.Expression.Name.Identifier.ValueText -cne 'Select') {
        return $false
    }
    $groupBy = $select.Expression.Expression
    if ($groupBy -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax] -or
        $groupBy.Expression -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax] -or
        [string]$groupBy.Expression.Name.Identifier.ValueText -cne 'GroupBy' -or
        $groupBy.ArgumentList.Arguments.Count -lt 1) {
        return $false
    }
    $keySelector = $groupBy.ArgumentList.Arguments[0].Expression
    if ($keySelector -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.SimpleLambdaExpressionSyntax]) {
        return $false
    }
    $keyParameter = [string]$keySelector.Parameter.Identifier.ValueText
    if ([string]$keySelector.Body.ToString() -ceq $keyParameter -and
        $groupBy.ArgumentList.Arguments.Count -eq 1) {
        $sourceName = [string]$groupBy.Expression.Expression.ToString()
        $sourceParameter = @(
            $Method.ParameterList.Parameters |
                Where-Object {
                    [string]$_.Identifier.ValueText -ceq $sourceName
                } |
                Select-Object -First 1)
        if ($sourceParameter.Count -eq 1 -and
            $null -ne $sourceParameter[0].Type) {
            $sourceType = [string]$sourceParameter[0].Type.ToString()
            $scalar = '(?:bool|byte|sbyte|short|ushort|int|uint|long|' +
                'ulong|char|decimal|double|float|string|Boolean|Byte|' +
                'SByte|Int16|UInt16|Int32|UInt32|Int64|UInt64|Char|' +
                'Decimal|Double|Single|String)'
            return $sourceType -match (
                "^(?:System\.)?$scalar\[\]$") -or
                $sourceType -match (
                    '^(?:(?:System\.)?Collections\.Generic\.)?' +
                    '(?:IEnumerable|IReadOnlyCollection|IReadOnlyList|' +
                    "ICollection|IList|List|HashSet)<\s*$scalar\s*>$")
        }
        return $false
    }
    if ($keySelector.Body -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax] -or
        [string]$keySelector.Body.Expression.ToString() -cne $keyParameter -or
        [string]$keySelector.Body.Name.Identifier.ValueText -cne 'Display' -or
        $groupBy.ArgumentList.Arguments.Count -ne 2 -or
        [string]$groupBy.ArgumentList.Arguments[1].Expression.ToString() -cne
            'StringComparer.OrdinalIgnoreCase') {
        return $false
    }
    $sourceSelect = $groupBy.Expression.Expression
    if ($sourceSelect -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax] -or
        $sourceSelect.Expression -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax] -or
        [string]$sourceSelect.Expression.Name.Identifier.ValueText -cne 'Select' -or
        $sourceSelect.ArgumentList.Arguments.Count -ne 1) {
        return $false
    }
    $sourceSelector = $sourceSelect.ArgumentList.Arguments[0].Expression
    if ($sourceSelector -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.SimpleLambdaExpressionSyntax] -or
        $sourceSelector.Body -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax]) {
        return $false
    }
    $factory = $sourceSelector.Body
    return [string]$factory.Expression.ToString() -match
        '^(?:Microsoft\.CodeAnalysis\.)?MetadataReference\.CreateFromFile$' -and
        $factory.ArgumentList.Arguments.Count -eq 1 -and
        [string]$factory.ArgumentList.Arguments[0].Expression.ToString() -ceq
            [string]$sourceSelector.Parameter.Identifier.ValueText
}

function Test-ContextualGroupRepresentativeSelection {
    param([Parameter(Mandatory)]$Invocation)

    $lambda = $Invocation.Parent
    if ($lambda -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.SimpleLambdaExpressionSyntax] -or
        $lambda.Body -ne $Invocation) {
        return $false
    }
    $groupParameter = [string]$lambda.Parameter.Identifier.ValueText
    if ([string]$Invocation.Expression.Expression.ToString() -cne
        $groupParameter) {
        return $false
    }
    $select = $lambda.Parent.Parent.Parent
    return $select -is [
        Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax] -and
        $select.Expression -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax] -and
        [string]$select.Expression.Name.Identifier.ValueText -ceq 'Select' -and
        $select.Expression.Expression -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax] -and
        $select.Expression.Expression.Expression -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax] -and
        [string]$select.Expression.Expression.Expression.Name.
            Identifier.ValueText -ceq 'GroupBy'
}

function Test-ContextualSynchronousAssertionCallback {
    param(
        [Parameter(Mandatory)]$Invocation,
        [Parameter(Mandatory)]$Method
    )
    if ([string]$Method.Modifiers.ToString() -match '\basync\b') {
        return $false
    }
    $lambda = @(
        $Invocation.Ancestors() |
            Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.ParenthesizedLambdaExpressionSyntax] -or
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.SimpleLambdaExpressionSyntax]
            } |
            Select-Object -First 1)
    if ($lambda.Count -ne 1) {
        return $false
    }
    $assertion = $lambda[0].Parent.Parent.Parent
    return $assertion -is [
        Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax] -and
        [string]$assertion.Expression.ToString() -match
            '^(?:Assert\.)?ThrowsException(?:<[^>]+>)?$'
}

function Get-ContextualAncestor {
    param(
        [Parameter(Mandatory)]$Node,
        [Parameter(Mandatory)][type]$Type
    )
    return @($Node.AncestorsAndSelf() |
        Where-Object { $_ -is $Type } |
        Select-Object -First 1)
}

function Get-ContextualMethodTypeMap {
    param([AllowNull()]$Method)
    $types = @{}
    if ($null -eq $Method) {
        return $types
    }
    foreach ($parameter in @(
            $Method.ParameterList.Parameters)) {
        if ($null -ne $parameter.Type) {
            $types[[string]$parameter.Identifier.ValueText] =
                [string]$parameter.Type.ToString()
        }
    }
    foreach ($declaration in @(
            $Method.DescendantNodes() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.VariableDeclarationSyntax]
                })) {
        foreach ($variable in @(
                $declaration.Variables)) {
            $types[[string]$variable.Identifier.ValueText] =
                [string]$declaration.Type.ToString()
        }
    }
    return $types
}

function Get-ContextualNormalizedTypeName {
    param(
        [Parameter(Mandatory)][string]$TypeName,
        [AllowNull()]$ContextNode
    )
    $value = ($TypeName -replace '\s+', '') -replace '^global::', ''
    if ($value.EndsWith('?')) {
        return 'System.Nullable<' +
            (Get-ContextualNormalizedTypeName `
                -TypeName $value.Substring(
                    0, $value.Length - 1) `
                -ContextNode $ContextNode) + '>'
    }
    if ($value -match '^(?:System\.)?Nullable<(?<inner>.+)>$') {
        return 'System.Nullable<' +
            (Get-ContextualNormalizedTypeName `
                -TypeName $Matches.inner `
                -ContextNode $ContextNode) + '>'
    }
    switch -CaseSensitive ($value) {
        'string' { return 'System.String' }
        'System.String' { return 'System.String' }
        'bool' { return 'System.Boolean' }
        'System.Boolean' { return 'System.Boolean' }
        'byte' { return 'System.Byte' }
        'System.Byte' { return 'System.Byte' }
        'sbyte' { return 'System.SByte' }
        'System.SByte' { return 'System.SByte' }
        'short' { return 'System.Int16' }
        'System.Int16' { return 'System.Int16' }
        'ushort' { return 'System.UInt16' }
        'System.UInt16' { return 'System.UInt16' }
        'int' { return 'System.Int32' }
        'System.Int32' { return 'System.Int32' }
        'uint' { return 'System.UInt32' }
        'System.UInt32' { return 'System.UInt32' }
        'long' { return 'System.Int64' }
        'System.Int64' { return 'System.Int64' }
        'ulong' { return 'System.UInt64' }
        'System.UInt64' { return 'System.UInt64' }
        'char' { return 'System.Char' }
        'System.Char' { return 'System.Char' }
        'decimal' { return 'System.Decimal' }
        'System.Decimal' { return 'System.Decimal' }
        'double' { return 'System.Double' }
        'System.Double' { return 'System.Double' }
        'float' { return 'System.Single' }
        'System.Single' { return 'System.Single' }
        'object' { return 'System.Object' }
        'System.Object' { return 'System.Object' }
        'System.Uri' { return 'System.Uri' }
        'System.StringComparison' {
            return 'System.StringComparison'
        }
    }
    $systemNames = @{
        String = 'System.String'
        Boolean = 'System.Boolean'
        Byte = 'System.Byte'
        SByte = 'System.SByte'
        Int16 = 'System.Int16'
        UInt16 = 'System.UInt16'
        Int32 = 'System.Int32'
        UInt32 = 'System.UInt32'
        Int64 = 'System.Int64'
        UInt64 = 'System.UInt64'
        Char = 'System.Char'
        Decimal = 'System.Decimal'
        Double = 'System.Double'
        Single = 'System.Single'
        Object = 'System.Object'
        Uri = 'System.Uri'
        StringComparison = 'System.StringComparison'
    }
    if ($systemNames.ContainsKey($value) -and
        $null -ne $ContextNode) {
        $root = $ContextNode.GetLocation().
            SourceTree.GetRoot()
        $usings = @($root.Usings)
        foreach ($ancestor in $ContextNode.Ancestors()) {
            if ($ancestor -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.BaseNamespaceDeclarationSyntax]) {
                $usings += @($ancestor.Usings)
            }
        }
        $systemImported = @($usings | Where-Object {
                $null -eq $_.Alias -and
                [string]$_.Name.ToString() -ceq
                    'System'
            }).Count -gt 0
        $shadowed = @($root.DescendantNodes() |
            Where-Object {
                (($_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]) -or
                    ($_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.EnumDeclarationSyntax])) -and
                [string]$_.Identifier.ValueText -ceq
                    $value
            }).Count -gt 0 -or
            @($usings | Where-Object {
                    $null -ne $_.Alias -and
                    [string]$_.Alias.Name.Identifier.ValueText -ceq
                        $value
                }).Count -gt 0
        if ($systemImported -and -not $shadowed) {
            return [string]$systemNames[$value]
        }
    }
    return $value
}

function Get-ContextualNamedCallLanguageState {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    $contents = [Collections.Generic.List[string]]::new()
    foreach ($file in $SnapshotFiles) {
        if ($file -isnot [Collections.IDictionary]) {
            continue
        }
        if ($file.Contains('projectContext') -and
            $file.projectContext -is [Collections.IDictionary] -and
            [string]$file.projectContext.state -ceq 'complete' -and
            $file.projectContext.content -is [string]) {
            [void]$contents.Add(
                [string]$file.projectContext.content)
        }
        if ([string]$file.state -ceq 'complete' -and
            [string]$file.path -imatch '\.csproj$' -and
            $file.content -is [string]) {
            [void]$contents.Add([string]$file.content)
        }
    }
    $versions = @(@(
            foreach ($content in $contents) {
            foreach ($match in [regex]::Matches(
                    $content,
                    '(?is)<LangVersion(?:\s+Condition\s*=\s*["''][^"'']+["''])?\s*>\s*(?<value>[^<]+)\s*</LangVersion>')) {
                if ($match.Value -match '(?i)Condition\s*=') {
                    return [pscustomobject]@{
                        State = 'unknown'
                        Reason =
                            'project-language-version-conditional'
                    }
                }
                $match.Groups['value'].Value.Trim()
            }
        }) | Sort-Object -Unique)
    if ($versions.Count -eq 0) {
        return [pscustomobject]@{
            State = 'unknown'
            Reason = 'project-language-version-unknown'
        }
    }
    if ($versions.Count -ne 1) {
        return [pscustomobject]@{
            State = 'unknown'
            Reason = 'project-language-version-ambiguous'
        }
    }
    $version = [string]$versions[0]
    if ($version -in @(
            'latest', 'latestMajor', 'preview', 'default')) {
        return [pscustomobject]@{
            State = 'supported'
            Version = $version
        }
    }
    $parsed = 0.0
    if (-not [double]::TryParse(
            $version,
            [Globalization.NumberStyles]::AllowDecimalPoint,
            [Globalization.CultureInfo]::InvariantCulture,
            [ref]$parsed)) {
        return [pscustomobject]@{
            State = 'unknown'
            Reason = 'project-language-version-unrecognized'
        }
    }
    return [pscustomobject]@{
        State = $(if ($parsed -ge 4.0) {
                'supported'
            } else { 'unsupported' })
        Version = $version
        Reason = $(if ($parsed -lt 4.0) {
                'named-arguments-language-version-unsupported'
            } else { $null })
    }
}

function Get-ContextualNamedCallSignatures {
    param(
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    $signatures = [Collections.Generic.List[object]]::new()
    $files = [Collections.Generic.List[object]]::new()
    [void]$files.Add([pscustomobject]@{
            path = $Path
            root = $Root
        })
    foreach ($file in $SnapshotFiles) {
        if ($file -isnot [Collections.IDictionary] -or
            [string]$file.state -cne 'complete' -or
            [string]$file.path -inotmatch '\.cs$' -or
            $file.content -isnot [string] -or
            [string]$file.path -ieq $Path) {
            continue
        }
        $tree = [
            Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree]::ParseText(
                [string]$file.content)
        if (@($tree.GetDiagnostics() | Where-Object {
                    $_.Severity -eq [
                        Microsoft.CodeAnalysis.DiagnosticSeverity]::Error
                }).Count -gt 0) {
            continue
        }
        [void]$files.Add([pscustomobject]@{
                path = [string]$file.path
                root = $tree.GetRoot()
            })
    }
    foreach ($file in $files) {
        foreach ($node in @($file.root.DescendantNodes() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.MethodDeclarationSyntax] -or
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.ConstructorDeclarationSyntax]
                })) {
            if ($node -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.MethodDeclarationSyntax] -and
                $null -ne $node.ExplicitInterfaceSpecifier) {
                continue
            }
            $type = @($node.Ancestors() | Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]
                } | Select-Object -First 1)
            if ($type.Count -ne 1) {
                continue
            }
            $parameters = @(
                foreach ($parameter in @(
                        $node.ParameterList.Parameters)) {
                    [ordered]@{
                        name =
                            [string]$parameter.Identifier.ValueText
                        type = Get-ContextualNormalizedTypeName `
                            -TypeName ([string]$parameter.Type) `
                            -ContextNode $parameter
                        modifier =
                            [string]$parameter.Modifiers.ToString()
                        optional =
                            $null -ne $parameter.Default
                        params =
                            @($parameter.Modifiers | Where-Object {
                                    [string]$_.Text -ceq 'params'
                                }).Count -gt 0
                    }
                })
            $namespace = @($type[0].Ancestors() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.BaseNamespaceDeclarationSyntax]
                } |
                Select-Object -First 1)
            $namespaceName = if ($namespace.Count -eq 1) {
                [string]$namespace[0].Name.ToString()
            }
            else { '' }
            $genericParameters =
                [Collections.Generic.List[string]]::new()
            if ($null -ne
                $type[0].TypeParameterList) {
                foreach ($parameter in @(
                        $type[0].TypeParameterList.
                            Parameters)) {
                    [void]$genericParameters.Add(
                        [string]$parameter.
                            Identifier.ValueText)
                }
            }
            if ($node -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.MethodDeclarationSyntax] -and
                $null -ne $node.TypeParameterList) {
                foreach ($parameter in @(
                        $node.TypeParameterList.
                            Parameters)) {
                    [void]$genericParameters.Add(
                        [string]$parameter.
                            Identifier.ValueText)
                }
            }
            $requiredCount = @($parameters | Where-Object {
                    -not [bool]$_['optional'] -and
                    -not [bool]$_['params']
                }).Count
            [void]$signatures.Add([pscustomobject]@{
                    Kind = $(if ($node -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.ConstructorDeclarationSyntax]) {
                            'constructor'
                        } else { 'method' })
                    Name = [string]$node.Identifier.ValueText
                    Container =
                        [string]$type[0].Identifier.ValueText
                    Namespace = $namespaceName
                    FullContainer = $(if (
                        [string]::IsNullOrWhiteSpace(
                            $namespaceName)) {
                            [string]$type[0].Identifier.ValueText
                        }
                        else {
                            "$namespaceName.$(
                                [string]$type[0].Identifier.ValueText)"
                        })
                    IsStatic = @($node.Modifiers |
                        Where-Object {
                            [string]$_.Text -ceq 'static'
                        }).Count -gt 0
                    GenericParameters = @(
                        $genericParameters |
                            Sort-Object -Unique)
                    RequiredCount = $requiredCount
                    MaximumCount = $parameters.Count
                    HasParams = @($parameters |
                        Where-Object {
                            [bool]$_['params']
                        }).Count -gt 0
                    Parameters = $parameters
                    Path = [string]$file.path
                })
        }
    }
    return $signatures.ToArray()
}

function Get-ContextualNamedCallBinding {
    param(
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    $sourceTree = $Root.GetLocation().SourceTree
    $trees = [Collections.Generic.List[Microsoft.CodeAnalysis.SyntaxTree]]::new()
    [void]$trees.Add($sourceTree)
    foreach ($file in $SnapshotFiles) {
        if ([string]$file.path -inotmatch '\.cs$' -or
            [string]$file.path -ieq $Path) {
            continue
        }
        if ([string]$file.state -cne 'complete' -or $file.content -isnot [string]) {
            return $null
        }
        [void]$trees.Add([Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree]::ParseText(
                [string]$file.content))
    }
    $conditionalSpans = @()
    foreach ($tree in $trees) {
        if (@($tree.GetDiagnostics() | Where-Object {
                    $_.Severity -eq [Microsoft.CodeAnalysis.DiagnosticSeverity]::Error
                }).Count -gt 0) {
            return $null
        }
        $conditional = Get-ContextualExceptionNamingConditionalState `
            -Root $tree.GetRoot() -Spans @() -Source
        if ($conditional.BindingUnknown) {
            return $null
        }
        if ($tree -eq $sourceTree) {
            $conditionalSpans = @($conditional.Spans)
        }
    }
    $reference = [Microsoft.CodeAnalysis.MetadataReference]::CreateFromFile(
        [object].Assembly.Location)
    $compilation = [Microsoft.CodeAnalysis.CSharp.CSharpCompilation]::Create(
        'ContextualNamedCalls', $trees.ToArray(),
        [Microsoft.CodeAnalysis.MetadataReference[]]@($reference),
        [Microsoft.CodeAnalysis.CSharp.CSharpCompilationOptions]::new(
            [Microsoft.CodeAnalysis.OutputKind]::DynamicallyLinkedLibrary))
    $core = [Microsoft.CodeAnalysis.IAssemblySymbol]$compilation.GetAssemblyOrModuleSymbol($reference)
    return [pscustomobject]@{
        Model = $compilation.GetSemanticModel($sourceTree)
        StringType = $core.GetTypeByMetadataName('System.String')
        ComparisonType = $core.GetTypeByMetadataName('System.StringComparison')
        ConditionalSpans = $conditionalSpans
    }
}

function Get-ContextualStringEqualsState {
    param(
        [Parameter(Mandatory)]$Node,
        [AllowNull()]$Binding
    )
    if ($Node -isnot [Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax]) {
        return 'other'
    }
    $expression = $Node.Expression
    $name = if ($expression -is [Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax]) {
        [string]$expression.Name.Identifier.ValueText
    }
    elseif ($expression -is [Microsoft.CodeAnalysis.CSharp.Syntax.SimpleNameSyntax]) {
        [string]$expression.Identifier.ValueText
    }
    else { '' }
    if ($name -cne 'Equals') { return 'other' }
    if ($null -eq $Binding -or
        @($Binding.ConditionalSpans | Where-Object { $_.IntersectsWith($Node.Span) }).Count -gt 0) {
        return 'unknown'
    }
    if (@($Node.ArgumentList.Arguments | Where-Object {
                $type = $Binding.Model.GetTypeInfo($_.Expression).Type
                $null -ne $type -and $type.TypeKind -eq [Microsoft.CodeAnalysis.TypeKind]::Dynamic
            }).Count -gt 0) {
        return 'unknown'
    }
    $symbol = $Binding.Model.GetSymbolInfo($Node).Symbol
    if ($symbol -isnot [Microsoft.CodeAnalysis.IMethodSymbol] -or
        @($Binding.Model.GetDiagnostics($Node.Span) | Where-Object {
                $_.Severity -eq [Microsoft.CodeAnalysis.DiagnosticSeverity]::Error
            }).Count -gt 0) {
        return 'unknown'
    }
    $method = [Microsoft.CodeAnalysis.IMethodSymbol]$symbol
    $same = [Microsoft.CodeAnalysis.SymbolEqualityComparer]::Default
    if (-not $method.IsStatic -or $method.IsGenericMethod -or
        $method.MethodKind -ne [Microsoft.CodeAnalysis.MethodKind]::Ordinary -or
        $method.ReturnType.SpecialType -ne [Microsoft.CodeAnalysis.SpecialType]::System_Boolean -or
        -not $same.Equals($method.ContainingType, $Binding.StringType) -or
        $method.Parameters.Length -notin @(2, 3)) {
        return 'not-exempt'
    }
    for ($index = 0; $index -lt $method.Parameters.Length; $index++) {
        $expected = if ($index -lt 2) { $Binding.StringType } else { $Binding.ComparisonType }
        if (-not $same.Equals($method.Parameters[$index].Type, $expected) -or
            $method.Parameters[$index].RefKind -ne [Microsoft.CodeAnalysis.RefKind]::None) {
            return 'not-exempt'
        }
    }
    return 'exception'
}

function Get-ContextualNamedCallSignature {
    param(
        [Parameter(Mandatory)]$Node,
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)]
        [AllowEmptyCollection()]
        [object[]]$Signatures
    )
    if ($null -eq $Node.ArgumentList) {
        return [pscustomobject]@{
            State = 'not-applicable'
        }
    }
    $arguments = @($Node.ArgumentList.Arguments)
    if ($arguments.Count -lt 1) {
        return [pscustomobject]@{
            State = 'not-applicable'
        }
    }
    $kind = 'method'
    $name = ''
    $container = ''
    $receiverKind = 'none'
    if ($Node -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax]) {
        $expression = $Node.Expression
        if ($expression -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax]) {
            $name = [string]$expression.Name.Identifier.ValueText
            $receiver = [string]$expression.Expression.ToString()
            if ($receiver -ceq 'this') {
                $receiverKind = 'instance'
                $owner = @($Node.Ancestors() | Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]
                    } | Select-Object -First 1)
                if ($owner.Count -eq 1) {
                    $container =
                        [string]$owner[0].Identifier.ValueText
                }
            }
            elseif ($receiver -ceq 'base') {
                $receiverKind = 'instance'
                $owner = @($Node.Ancestors() | Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]
                    } | Select-Object -First 1)
                if ($owner.Count -ne 1 -or
                    $null -eq $owner[0].BaseList -or
                    $owner[0].BaseList.Types.Count -ne 1) {
                    return [pscustomobject]@{
                        State = 'unknown'
                        Reason = 'call-receiver-type-unproven'
                    }
                }
                else {
                    $container = (
                        [string]$owner[0].BaseList.Types[0].Type.ToString() `
                            -split '\.')[-1]
                }
            }
            else {
                $receiverKind = 'static'
                if ($expression.Expression -isnot [
                        Microsoft.CodeAnalysis.CSharp.Syntax.IdentifierNameSyntax] -and
                    $expression.Expression -isnot [
                        Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax] -and
                    $expression.Expression -isnot [
                        Microsoft.CodeAnalysis.CSharp.Syntax.AliasQualifiedNameSyntax]) {
                    return [pscustomobject]@{
                        State = 'unknown'
                        Reason = 'call-receiver-type-unproven'
                    }
                }
                $receiver = $receiver -replace '^global::', ''
                $container = ($receiver -split '\.')[-1]
                $method = @($Node.Ancestors() | Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.MethodDeclarationSyntax] -or
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.ConstructorDeclarationSyntax]
                    } | Select-Object -First 1)
                $shadowed = $false
                if ($method.Count -eq 1) {
                    $shadowed =
                        @($method[0].ParameterList.Parameters |
                            Where-Object {
                                [string]$_.Identifier.ValueText -ceq
                                    $container
                            }).Count -gt 0 -or
                        @($method[0].DescendantNodes() |
                            Where-Object {
                                $_ -is [
                                    Microsoft.CodeAnalysis.CSharp.Syntax.VariableDeclaratorSyntax] -and
                                [string]$_.Identifier.ValueText -ceq
                                    $container
                            }).Count -gt 0
                }
                $owner = @($Node.Ancestors() | Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]
                    } | Select-Object -First 1)
                if ($owner.Count -eq 1) {
                    $shadowed = $shadowed -or
                        @($owner[0].Members | Where-Object {
                                ($_ -is [
                                        Microsoft.CodeAnalysis.CSharp.Syntax.FieldDeclarationSyntax] -and
                                    @($_.Declaration.Variables |
                                        Where-Object {
                                            [string]$_.Identifier.ValueText -ceq
                                                $container
                                        }).Count -gt 0) -or
                                ($_ -is [
                                        Microsoft.CodeAnalysis.CSharp.Syntax.PropertyDeclarationSyntax] -and
                                    [string]$_.Identifier.ValueText -ceq
                                        $container)
                            }).Count -gt 0
                }
                $usings = @($Root.Usings)
                foreach ($ancestor in $Node.Ancestors()) {
                    if ($ancestor -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.BaseNamespaceDeclarationSyntax]) {
                        $usings += @($ancestor.Usings)
                    }
                }
                $shadowed = $shadowed -or
                    @($usings | Where-Object {
                            $null -ne $_.Alias -and
                            [string]$_.Alias.Name.Identifier.ValueText -ceq
                                $container
                        }).Count -gt 0
                if ($shadowed) {
                    return [pscustomobject]@{
                        State = 'unknown'
                        Reason = 'call-receiver-type-unproven'
                    }
                }
            }
        }
        elseif ($expression -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.IdentifierNameSyntax] -or
            $expression -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.GenericNameSyntax]) {
            $name = [string]$expression.Identifier.ValueText
            $owner = @($Node.Ancestors() | Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]
                } | Select-Object -First 1)
            if ($owner.Count -eq 1) {
                $container =
                    [string]$owner[0].Identifier.ValueText
            }
        }
        if ($name -ceq 'AreEqual' -and
            [string]$expression.ToString() -match
                '(?:^|\.)Assert\.AreEqual$') {
            return [pscustomobject]@{
                State = 'excluded'
                Reason = 'mstest-areequal-owned-by-named-rule'
            }
        }
    }
    elseif ($Node -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.ObjectCreationExpressionSyntax]) {
        $kind = 'constructor'
        $container =
            ([string]$Node.Type.ToString() -split '\.')[-1]
        $name = $container
    }
    elseif ($Node -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.ConstructorInitializerSyntax]) {
        $kind = 'constructor'
        $owner = @($Node.Ancestors() | Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]
            } | Select-Object -First 1)
        if ($owner.Count -ne 1) {
            return [pscustomobject]@{
                State = 'unknown'
                Reason = 'constructor-container-unproven'
            }
        }
        if ([string]$Node.ThisOrBaseKeyword.Text -ceq 'this') {
            $container =
                [string]$owner[0].Identifier.ValueText
        }
        else {
            if ($null -eq $owner[0].BaseList) {
                return [pscustomobject]@{
                    State = 'unknown'
                    Reason = 'base-constructor-type-unproven'
                }
            }
            $bases = @($owner[0].BaseList.Types)
            if ($bases.Count -ne 1) {
                return [pscustomobject]@{
                    State = 'unknown'
                    Reason = 'base-constructor-type-unproven'
                }
            }
            $container =
                ([string]$bases[0].Type.ToString() -split '\.')[-1]
        }
        $name = $container
    }
    else {
        return [pscustomobject]@{
            State = 'not-applicable'
        }
    }
    if ([string]::IsNullOrWhiteSpace($name)) {
        return [pscustomobject]@{
            State = 'unknown'
            Reason = 'call-target-unproven'
        }
    }
    $candidates = @($Signatures | Where-Object {
            [string]$_.Kind -ceq $kind -and
            [string]$_.Name -ceq $name -and
            [int]$_.RequiredCount -le $arguments.Count -and
            ([bool]$_.HasParams -or
                [int]$_.MaximumCount -ge $arguments.Count)
        })
    if (-not [string]::IsNullOrWhiteSpace($container)) {
        $contained = @($candidates | Where-Object {
                [string]$_.Container -ceq $container -and
                ($(if ($receiverKind -ceq 'static') {
                        [bool]$_.IsStatic
                    }
                    elseif ($receiverKind -ceq 'instance') {
                        -not [bool]$_.IsStatic
                    }
                    else { $true }))
            })
        if ($receiverKind -ceq 'static' -and
            $contained.Count -gt 0) {
            $receiverText = (
                [string]$Node.Expression.Expression.ToString()) `
                -replace '^global::', ''
            $exact = @($contained | Where-Object {
                    [string]$_.FullContainer -ceq
                        $receiverText
                })
            if ($exact.Count -eq 1) {
                $contained = $exact
            }
            elseif ($receiverText -ceq $container) {
                $namespaces = @($contained.Namespace |
                    Sort-Object -Unique)
                if ($namespaces.Count -gt 1) {
                    return [pscustomobject]@{
                        State = 'unknown'
                        Reason = 'call-receiver-type-unproven'
                    }
                }
            }
            else {
                return [pscustomobject]@{
                    State = 'unknown'
                    Reason = 'call-receiver-type-unproven'
                }
            }
        }
        if ($contained.Count -gt 0) {
            $candidates = $contained
        }
        else {
            return [pscustomobject]@{
                State = 'unknown'
                Reason = 'call-receiver-type-unproven'
            }
        }
    }
    if ($candidates.Count -ne 1) {
        return [pscustomobject]@{
            State = 'unknown'
            Reason = $(if ($candidates.Count -gt 1) {
                    'selected-overload-ambiguous'
                } else { 'selected-overload-unavailable' })
        }
    }
    if ([bool]$candidates[0].HasParams) {
        return [pscustomobject]@{
            State = 'unknown'
            Reason = 'expanded-params-binding-unproven'
        }
    }
    return [pscustomobject]@{
        State = 'resolved'
        Signature = $candidates[0]
    }
}

function Test-ContextualConstantSyntax {
    param(
        [Parameter(Mandatory)]$Expression,
        [AllowEmptyCollection()]
        [string[]]$KnownNames = @()
    )
    if ($Expression -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.LiteralExpressionSyntax] -or
        $Expression -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.DefaultExpressionSyntax]) {
        return $true
    }
    if ($Expression -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.ParenthesizedExpressionSyntax]) {
        return Test-ContextualConstantSyntax `
            -Expression $Expression.Expression `
            -KnownNames $KnownNames
    }
    if ($Expression -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.PrefixUnaryExpressionSyntax] -and
        [string]$Expression.OperatorToken.Text -in @(
            '+', '-', '~', '!')) {
        return Test-ContextualConstantSyntax `
            -Expression $Expression.Operand `
            -KnownNames $KnownNames
    }
    if ($Expression -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.BinaryExpressionSyntax]) {
        return (Test-ContextualConstantSyntax `
                -Expression $Expression.Left `
                -KnownNames $KnownNames) -and
            (Test-ContextualConstantSyntax `
                -Expression $Expression.Right `
                -KnownNames $KnownNames)
    }
    if ($Expression -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax] -and
        [string]$Expression.Expression.ToString() -ceq 'nameof') {
        return $true
    }
    $text = [string]$Expression.ToString()
    return $text -cin $KnownNames
}

function Get-ContextualNamedCallConstants {
    param(
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    $constants = [Collections.Generic.List[object]]::new()
    $files = [Collections.Generic.List[object]]::new()
    [void]$files.Add([pscustomobject]@{
            path = $Path
            root = $Root
            current = $true
        })
    foreach ($file in $SnapshotFiles) {
        if ($file -isnot [Collections.IDictionary] -or
            [string]$file.state -cne 'complete' -or
            [string]$file.path -inotmatch '\.cs$' -or
            $file.content -isnot [string] -or
            [string]$file.path -ieq $Path) {
            continue
        }
        $tree = [
            Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree]::ParseText(
                [string]$file.content)
        if (@($tree.GetDiagnostics() | Where-Object {
                    $_.Severity -eq [
                        Microsoft.CodeAnalysis.DiagnosticSeverity]::Error
                }).Count -gt 0) {
            continue
        }
        [void]$files.Add([pscustomobject]@{
                path = [string]$file.path
                root = $tree.GetRoot()
                current = $false
            })
    }
    foreach ($file in $files) {
        $known = [Collections.Generic.List[string]]::new()
        foreach ($enum in @($file.root.DescendantNodes() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.EnumDeclarationSyntax]
                })) {
            foreach ($member in @($enum.Members)) {
                $qualified =
                    [string]$enum.Identifier.ValueText +
                    '.' +
                    [string]$member.Identifier.ValueText
                [void]$known.Add($qualified)
                [void]$constants.Add([pscustomobject]@{
                        Kind = 'enum'
                        Name =
                            [string]$member.Identifier.ValueText
                        QualifiedName = $qualified
                        Container =
                            [string]$enum.Identifier.ValueText
                        Path = [string]$file.path
                        Current = [bool]$file.current
                        Declaration = $member
                    })
            }
        }
        foreach ($field in @($file.root.DescendantNodes() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.FieldDeclarationSyntax] -and
                    @($_.Modifiers | Where-Object {
                            [string]$_.Text -ceq 'const'
                        }).Count -gt 0
                })) {
            $owner = @($field.Ancestors() | Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]
                } | Select-Object -First 1)
            if ($owner.Count -ne 1) {
                continue
            }
            foreach ($variable in @(
                    $field.Declaration.Variables)) {
                if ($null -eq $variable.Initializer -or
                    -not (Test-ContextualConstantSyntax `
                        -Expression $variable.Initializer.Value `
                        -KnownNames $known.ToArray())) {
                    continue
                }
                $qualified =
                    [string]$owner[0].Identifier.ValueText +
                    '.' +
                    [string]$variable.Identifier.ValueText
                [void]$known.Add(
                    [string]$variable.Identifier.ValueText)
                [void]$known.Add($qualified)
                [void]$constants.Add([pscustomobject]@{
                        Kind = 'field'
                        Name =
                            [string]$variable.Identifier.ValueText
                        QualifiedName = $qualified
                        Container =
                            [string]$owner[0].Identifier.ValueText
                        Path = [string]$file.path
                        Current = [bool]$file.current
                        Declaration = $variable
                    })
            }
        }
        if (-not [bool]$file.current) {
            continue
        }
        foreach ($local in @($file.root.DescendantNodes() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.LocalDeclarationStatementSyntax] -and
                    @($_.Modifiers | Where-Object {
                            [string]$_.Text -ceq 'const'
                        }).Count -gt 0
                })) {
            $method = @($local.Ancestors() | Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.MethodDeclarationSyntax] -or
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.ConstructorDeclarationSyntax]
                } | Select-Object -First 1)
            if ($method.Count -ne 1) {
                continue
            }
            foreach ($variable in @(
                    $local.Declaration.Variables)) {
                if ($null -eq $variable.Initializer -or
                    -not (Test-ContextualConstantSyntax `
                        -Expression $variable.Initializer.Value `
                        -KnownNames $known.ToArray())) {
                    continue
                }
                [void]$known.Add(
                    [string]$variable.Identifier.ValueText)
                [void]$constants.Add([pscustomobject]@{
                        Kind = 'local'
                        Name =
                            [string]$variable.Identifier.ValueText
                        QualifiedName = ''
                        Container = ''
                        Path = [string]$file.path
                        Current = $true
                        MethodStart =
                            [int]$method[0].SpanStart
                        ScopeStart =
                            [int]$local.Parent.SpanStart
                        ScopeEnd =
                            [int]$local.Parent.Span.End
                        Declaration = $variable
                    })
            }
        }
    }
    return $constants.ToArray()
}

function Test-ContextualCompileTimeConstantArgument {
    param(
        [Parameter(Mandatory)]$Expression,
        [Parameter(Mandatory)]$CallNode,
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)]
        [AllowEmptyCollection()]
        [object[]]$Constants
    )
    if (Test-ContextualConstantSyntax `
            -Expression $Expression) {
        return $true
    }
    $text = [string]$Expression.ToString()
    if ($Expression -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax]) {
        return @($Constants | Where-Object {
                [string]$_.QualifiedName -ceq $text
            }).Count -eq 1
    }
    if ($Expression -isnot [
            Microsoft.CodeAnalysis.CSharp.Syntax.IdentifierNameSyntax]) {
        return $false
    }
    $name = [string]$Expression.Identifier.ValueText
    $method = @($CallNode.Ancestors() | Where-Object {
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.MethodDeclarationSyntax] -or
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.ConstructorDeclarationSyntax]
        } | Select-Object -First 1)
    if ($method.Count -eq 1) {
        if (@($method[0].ParameterList.Parameters |
                Where-Object {
                    [string]$_.Identifier.ValueText -ceq
                        $name
                }).Count -gt 0) {
            return $false
        }
        $locals = @($method[0].DescendantNodes() |
            Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.VariableDeclaratorSyntax] -and
                [string]$_.Identifier.ValueText -ceq
                    $name -and
                [int]$_.SpanStart -lt
                    [int]$CallNode.SpanStart
            } | Sort-Object {
                -[int]$_.SpanStart
            })
        if ($locals.Count -gt 0) {
            return @($Constants | Where-Object {
                    [string]$_.Kind -ceq 'local' -and
                    [string]$_.Name -ceq $name -and
                    [int]$_.MethodStart -eq
                        [int]$method[0].SpanStart -and
                    [int]$_.Declaration.SpanStart -eq
                        [int]$locals[0].SpanStart -and
                    [int]$_.ScopeStart -le
                        [int]$CallNode.SpanStart -and
                    [int]$_.ScopeEnd -ge
                        [int]$CallNode.Span.End
                }).Count -eq 1
        }
    }
    $owner = @($CallNode.Ancestors() | Where-Object {
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]
        } | Select-Object -First 1)
    if ($owner.Count -ne 1) {
        return $false
    }
    $members = @($owner[0].Members | Where-Object {
            ($_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.FieldDeclarationSyntax] -and
                @($_.Declaration.Variables | Where-Object {
                        [string]$_.Identifier.ValueText -ceq $name
                    }).Count -gt 0) -or
            ($_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.PropertyDeclarationSyntax] -and
                [string]$_.Identifier.ValueText -ceq $name)
        })
    if ($members.Count -ne 1) {
        return $false
    }
    return @($Constants | Where-Object {
            [string]$_.Kind -ceq 'field' -and
            [bool]$_.Current -and
            [string]$_.Container -ceq
                [string]$owner[0].Identifier.ValueText -and
            [string]$_.Name -ceq $name
        }).Count -eq 1
}

function Test-ContextualNamedCallExpressionTree {
    param([Parameter(Mandatory)]$Node)
    $lambda = @($Node.Ancestors() | Where-Object {
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.ParenthesizedLambdaExpressionSyntax] -or
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.SimpleLambdaExpressionSyntax]
        } | Select-Object -First 1)
    if ($lambda.Count -ne 1) {
        return $false
    }
    $outer = @($lambda[0].Ancestors() | Where-Object {
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax]
        } | Select-Object -First 1)
    return $outer.Count -eq 1 -and
        [string]$outer[0].Expression.ToString() -match
            '(?:^|\.)(?:Setup|Verify|SetupGet|SetupSet)$'
}

function Get-ContextualNamedCallOutcome {
    param(
        [Parameter(Mandatory)]$Node,
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$Spans,
        [Parameter(Mandatory)]
        [AllowEmptyCollection()]
        [object[]]$Signatures,
        [Parameter(Mandatory)]$Language,
        [Parameter(Mandatory)]
        [AllowEmptyCollection()]
        [object[]]$Constants,
        [AllowNull()]$Binding
    )
    if (-not (Test-ContextualNodeChanged `
            -Node $Node -Spans $Spans)) {
        return $null
    }
    if ($null -eq $Node.ArgumentList) {
        return $null
    }
    $arguments = @($Node.ArgumentList.Arguments)
    if ($arguments.Count -lt 1) {
        return $null
    }
    $lineSpan = $Node.GetLocation().GetLineSpan()
    $first = [int]$lineSpan.StartLinePosition.Line + 1
    $last = [int]$lineSpan.EndLinePosition.Line + 1
    $anchors = @(
        foreach ($span in $Spans) {
            if ($first -le [int]$span.endLine -and
                $last -ge [int]$span.startLine) {
                [Math]::Max($first, [int]$span.startLine)
            }
        })
    if ($anchors.Count -eq 0) {
        return $null
    }
    $anchor = [int](
        $anchors | Measure-Object -Minimum).Minimum
    $allNamed = @($arguments | Where-Object {
            $null -ne $_.NameColon
        }).Count -eq $arguments.Count
    if ($allNamed) {
        return $null
    }
    $constantArguments = @($arguments | Where-Object {
            Test-ContextualCompileTimeConstantArgument `
                -Expression $_.Expression `
                -CallNode $Node -Root $Root `
                -Constants $Constants
        })
    $literalTrigger =
        $constantArguments.Count -gt 0
    $argumentLines = @($arguments | ForEach-Object {
            [int]$_.GetLocation().GetLineSpan().
                StartLinePosition.Line + 1
        })
    $multilineTrigger = $arguments.Count -gt 1 -and
        @($argumentLines | Sort-Object -Unique).Count -eq
            $arguments.Count
    if ([string]$Language.State -cne 'supported' -and
        ($literalTrigger -or $multilineTrigger -or
            $arguments.Count -ge 2)) {
        return New-ContextualOutcome `
            -RuleId named-call-arguments `
            -State unknown `
            -Reason $(if ($Language.Reason) {
                    [string]$Language.Reason
                } else {
                    'project-language-version-unknown'
                }) `
            -Path $Path -Line $anchor `
            -EndLine $anchor `
            -Symbol 'unresolved-call'
    }
    $equality = Get-ContextualStringEqualsState -Node $Node -Binding $Binding
    if ($equality -ceq 'exception') {
        return New-ContextualOutcome -RuleId named-call-arguments `
            -State compliant -Reason symmetric-string-equals-exception `
            -Path $Path -Line $anchor -EndLine $anchor -Symbol Equals
    }
    if ($equality -ceq 'unknown') {
        return New-ContextualOutcome -RuleId named-call-arguments `
            -State unknown -Reason string-equals-binding-unproven `
            -Path $Path -Line $anchor -EndLine $anchor -Symbol Equals
    }
    $signatureResult =
        Get-ContextualNamedCallSignature `
            -Node $Node -Root $Root `
            -Signatures $Signatures
    if ([string]$signatureResult.State -ceq 'excluded' -or
        [string]$signatureResult.State -ceq 'not-applicable') {
        return $null
    }
    if ([string]$signatureResult.State -cne 'resolved') {
        if ($equality -cne 'not-exempt' -and -not $literalTrigger -and
            -not $multilineTrigger -and
            -not ($arguments.Count -ge 2 -and
                [string]$signatureResult.Reason -cin @(
                    'selected-overload-ambiguous',
                    'expanded-params-binding-unproven',
                    'generic-type-parameter-binding-unproven',
                    'call-receiver-type-unproven'))) {
            return $null
        }
        return New-ContextualOutcome `
            -RuleId named-call-arguments `
            -State unknown `
            -Reason ([string]$signatureResult.Reason) `
            -Path $Path -Line $anchor `
            -EndLine $anchor `
            -Symbol 'unresolved-call'
    }
    $signature = $signatureResult.Signature
    $parameters = @($signature.Parameters)
    if ($arguments.Count -ge 2 -and
        @($parameters | Where-Object {
                $parameterType = [string]$_['type']
                @($signature.GenericParameters |
                    Where-Object {
                        $parameterType -match (
                            '(?:^|[^A-Za-z0-9_])' +
                            [regex]::Escape([string]$_) +
                            '(?:$|[^A-Za-z0-9_])')
                    }).Count -gt 0
            }).Count -gt 0) {
        return New-ContextualOutcome `
            -RuleId named-call-arguments `
            -State unknown `
            -Reason generic-type-parameter-binding-unproven `
            -Path $Path -Line $anchor `
            -EndLine $anchor `
            -Symbol ([string]$signature.Name)
    }
    $mapped = [Collections.Generic.HashSet[int]]::new()
    foreach ($argument in $arguments) {
        $parameterIndex = -1
        if ($null -ne $argument.NameColon) {
            $name = [string]$argument.NameColon.Name.Identifier.ValueText
            $indices = @(for ($i = 0; $i -lt $parameters.Count; $i++) {
                    if ([string]$parameters[$i].name -ceq $name) {
                        $i
                    }
                })
            if ($indices.Count -ne 1 -or
                -not $mapped.Add([int]$indices[0])) {
                return New-ContextualOutcome `
                    -RuleId named-call-arguments `
                    -State unknown `
                    -Reason named-argument-binding-invalid `
                    -Path $Path -Line $anchor `
                    -EndLine $anchor `
                    -Symbol ([string]$signature.Name)
            }
            $parameterIndex = [int]$indices[0]
        }
        else {
            $next = @(0..($parameters.Count - 1) |
                Where-Object {
                    -not $mapped.Contains([int]$_)
                } | Select-Object -First 1)
            if ($next.Count -ne 1) {
                return New-ContextualOutcome `
                    -RuleId named-call-arguments `
                    -State unknown `
                    -Reason positional-argument-binding-invalid `
                    -Path $Path -Line $anchor `
                    -EndLine $anchor `
                    -Symbol ([string]$signature.Name)
            }
            $parameterIndex = [int]$next[0]
            [void]$mapped.Add($parameterIndex)
        }
        $argumentModifier =
            [string]$argument.RefKindKeyword.Text
        $parameterModifier =
            [string]$parameters[
                $parameterIndex].modifier
        if ($parameterModifier -match '\b(ref|out|in)\b') {
            $expectedModifier =
                [string]$Matches[1]
            if ($argumentModifier -cne
                $expectedModifier) {
                return New-ContextualOutcome `
                    -RuleId named-call-arguments `
                    -State unknown `
                    -Reason argument-modifier-binding-unproven `
                    -Path $Path -Line $anchor `
                    -EndLine $anchor `
                    -Symbol ([string]$signature.Name)
            }
        }
        elseif (-not [string]::IsNullOrWhiteSpace(
                $argumentModifier)) {
            return New-ContextualOutcome `
                -RuleId named-call-arguments `
                -State unknown `
                -Reason argument-modifier-binding-unproven `
                -Path $Path -Line $anchor `
                -EndLine $anchor `
                -Symbol ([string]$signature.Name)
        }
    }
    $mappedParameters = @($mapped | Sort-Object | ForEach-Object {
            $parameters[[int]$_]
        })
    $repeatedTypeTrigger = @($mappedParameters |
        Group-Object {
            [string]$_['type']
        } |
        Where-Object {
            -not [string]::IsNullOrWhiteSpace(
                [string]$_.Name) -and
            $_.Count -gt 1
        }).Count -gt 0
    if (-not $literalTrigger -and
        -not $multilineTrigger -and
        -not $repeatedTypeTrigger) {
        return $null
    }
    if (Test-ContextualNamedCallExpressionTree `
            -Node $Node) {
        return New-ContextualOutcome `
            -RuleId named-call-arguments `
            -State unknown `
            -Reason expression-tree-named-arguments-unproven `
            -Path $Path -Line $anchor `
            -EndLine $anchor `
            -Symbol ([string]$signature.Name)
    }
    $method = @($Node.Ancestors() | Where-Object {
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.MethodDeclarationSyntax] -or
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.ConstructorDeclarationSyntax]
        } | Select-Object -First 1)
    $types = if ($method.Count -eq 1) {
        Get-ContextualMethodTypeMap -Method $method[0]
    }
    else { @{} }
    foreach ($argument in $arguments) {
        if ($argument.Expression -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.IdentifierNameSyntax] -and
            $types.Contains(
                [string]$argument.Expression.Identifier.ValueText) -and
            [string]$types[
                [string]$argument.Expression.Identifier.ValueText] -ceq
                'dynamic') {
            return New-ContextualOutcome `
                -RuleId named-call-arguments `
                -State unknown `
                -Reason dynamic-argument-binding-unproven `
                -Path $Path -Line $anchor `
                -EndLine $anchor `
                -Symbol ([string]$signature.Name)
        }
    }
    $triggers = [Collections.Generic.List[string]]::new()
    if ($repeatedTypeTrigger) {
        [void]$triggers.Add('repeated-formal-type')
    }
    if ($multilineTrigger) {
        [void]$triggers.Add('one-argument-per-line')
    }
    if ($literalTrigger) {
        [void]$triggers.Add('compile-time-constant')
    }
    $allNamesRequired =
        $repeatedTypeTrigger -or
        $multilineTrigger
    $unnamedConstants =
        @($constantArguments |
            Where-Object {
                $null -eq $_.NameColon
            })
    $violation = if ($allNamesRequired) {
        -not $allNamed
    }
    else {
        $unnamedConstants.Count -gt 0
    }
    return New-ContextualOutcome `
        -RuleId named-call-arguments `
        -State $(if ($violation) {
                'violation'
            } else { 'compliant' }) `
        -Reason $(if (-not $violation) {
                $(if ($allNamesRequired) {
                        'documented-trigger-arguments-named'
                    }
                    else {
                        'documented-constant-arguments-named'
                    })
            }
            elseif ($allNamesRequired) {
                'documented-trigger-positional-arguments'
            }
            else {
                'documented-constant-argument-positional'
            }) `
        -Path $Path -Line $anchor `
        -EndLine $anchor `
        -Symbol ([string]$signature.Name) `
        -Evidence $(if (-not $violation) { '' }
        elseif ($allNamesRequired) {
            'Name every supplied argument because this call ' +
            'has: ' + ($triggers -join ', ') + '.'
        }
        else {
            'Name each compile-time constant argument; ' +
            'other distinct nonconstant arguments do not ' +
            'need names.'
        })
}

function Get-ContextualReceiverType {
    param(
        [Parameter(Mandatory)]$Expression,
        [AllowNull()]$Method
    )
    if ($Expression -is [
        Microsoft.CodeAnalysis.CSharp.Syntax.TypeOfExpressionSyntax]) {
        return 'System.Type'
    }
    if ($Expression -is [
        Microsoft.CodeAnalysis.CSharp.Syntax.IdentifierNameSyntax]) {
        $types = Get-ContextualMethodTypeMap `
            -Method $Method
        $name = [string]$Expression.Identifier.ValueText
        if ($types.Contains($name)) {
            return [string]$types[$name]
        }
    }
    return [string]$Expression.ToString()
}

function Get-ContextualCoverageAttributeState {
    param(
        [Parameter(Mandatory)]$Type,
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    $namespace = 'System.Diagnostics.CodeAnalysis'
    $full = "$namespace.ExcludeFromCodeCoverage"
    $usingNodes = @($Root.Usings)
    foreach ($ancestor in @($Type.Ancestors())) {
        if ($ancestor -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.BaseNamespaceDeclarationSyntax]) {
            $usingNodes += @($ancestor.Usings)
        }
    }
    $imports = @($usingNodes | Where-Object {
            $null -eq $_.Alias
        } | ForEach-Object {
            ([string]$_.Name.ToString()) -replace '^global::', ''
        })
    $aliases = @{}
    foreach ($using in @($usingNodes | Where-Object {
                $null -ne $_.Alias
            })) {
        $aliases[[string]$using.Alias.Name.Identifier.ValueText] =
            ((([string]$using.Name.ToString()) -replace '^global::', '') `
                -replace 'Attribute$', '')
    }
    foreach ($list in @($Type.AttributeLists)) {
        if ($null -ne $list.Target) {
            continue
        }
        foreach ($attribute in @($list.Attributes)) {
            $name = ([string]$attribute.Name.ToString()) `
                -replace '^global::', '' `
                -replace 'Attribute$', ''
            if ($name -ceq $full) {
                return 'present'
            }
            $localShadow = @($Root.DescendantNodes() |
                Where-Object {
                    ($_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.ClassDeclarationSyntax] -or
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.StructDeclarationSyntax]) -and
                    [string]$_.Identifier.ValueText -cin @(
                        'ExcludeFromCodeCoverage',
                        'ExcludeFromCodeCoverageAttribute')
                }).Count -gt 0
            if ($name -ceq 'ExcludeFromCodeCoverage' -and
                -not $localShadow -and
                -not $aliases.ContainsKey(
                    'ExcludeFromCodeCoverage')) {
                if ($namespace -cin $imports) {
                    return 'present'
                }
                foreach ($file in @($SnapshotFiles |
                        Where-Object {
                            [string]$_.state -ceq 'complete' -and
                            [string]$_.path -imatch '\.cs$' -and
                            $_.content -is [string]
                        })) {
                    $tree = [
                        Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree]::ParseText(
                            [string]$file.content)
                    $globalImports = @($tree.GetRoot().Usings |
                        Where-Object {
                            [string]$_.GlobalKeyword.Text -ceq
                                'global' -and
                            $null -eq $_.Alias
                        } | ForEach-Object {
                            ([string]$_.Name.ToString()) `
                                -replace '^global::', ''
                        })
                    if ($namespace -cin $globalImports) {
                        return 'present'
                    }
                }
                return 'ambiguous'
            }
            $parts = $name -split '\.|::', 2
            if ($aliases.ContainsKey($parts[0])) {
                $resolved = [string]$aliases[$parts[0]]
                if ($parts.Count -gt 1) {
                    $resolved += '.' + $parts[1]
                }
                if ($resolved -ceq $full) {
                    return 'present'
                }
            }
        }
    }
    return 'missing'
}

function Get-ContextualTestProject {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    $candidates = @($SnapshotFiles | Where-Object {
            [string]$_.state -ceq 'complete' -and
            [string]$_.path -imatch '\.csproj$' -and
            $Path.StartsWith(
                ([IO.Path]::GetDirectoryName(
                    ([string]$_.path).Replace(
                        '/', [IO.Path]::DirectorySeparatorChar)).
                    Replace(
                        [IO.Path]::DirectorySeparatorChar, '/') + '/'),
                [StringComparison]::OrdinalIgnoreCase)
        } | Sort-Object {
            -([string]$_.path).Length
        })
    if ($candidates.Count -lt 1) {
        return [pscustomobject]@{
            State = 'unknown'
            Reason = 'test-project-evidence-missing'
        }
    }
    $directoryLength = [IO.Path]::GetDirectoryName(
        ([string]$candidates[0].path).Replace(
            '/', [IO.Path]::DirectorySeparatorChar)).Length
    $nearest = @($candidates | Where-Object {
            [IO.Path]::GetDirectoryName(
                ([string]$_.path).Replace(
                    '/', [IO.Path]::DirectorySeparatorChar)).Length -eq
                $directoryLength
        })
    if ($nearest.Count -ne 1) {
        return [pscustomobject]@{
            State = 'unknown'
            Reason = 'test-project-evidence-ambiguous'
        }
    }
    $content = [string]$nearest[0].content
    try {
        [xml]$xml = $content
    }
    catch {
        return [pscustomobject]@{
            State = 'unknown'
            Reason = 'test-project-xml-invalid'
        }
    }
    $testNodes = @($xml.SelectNodes(
            '//*[local-name()="IsTestProject"]') |
        Where-Object {
            [string]$_.InnerText -match '^\s*true\s*$'
        })
    $sdkNodes = @($xml.SelectNodes(
            '//*[local-name()="PackageReference"]') |
        Where-Object {
            [string]$_.GetAttribute('Include') -ceq
                'Microsoft.NET.Test.Sdk'
        })
    if (@($testNodes + $sdkNodes | Where-Object {
                -not [string]::IsNullOrWhiteSpace(
                    [string]$_.GetAttribute('Condition'))
            }).Count -gt 0) {
        return [pscustomobject]@{
            State = 'unknown'
            Reason = 'test-project-condition-unproven'
        }
    }
    $isTest = $testNodes.Count -gt 0 -or
        $sdkNodes.Count -gt 0
    if (-not $isTest) {
        return [pscustomobject]@{
            State = 'not-test'
            Path = [string]$nearest[0].path
        }
    }
    $compileSetting = @($xml.SelectNodes(
            '//*[local-name()="EnableDefaultCompileItems"]') |
        Where-Object {
            [string]$_.InnerText -match '^\s*false\s*$'
        })
    if ($compileSetting.Count -gt 0) {
        return [pscustomobject]@{
            State = 'unknown'
            Reason = 'test-project-compile-membership-unproven'
        }
    }
    $projectDirectory = [IO.Path]::GetDirectoryName(
        ([string]$nearest[0].path).Replace(
            '/', [IO.Path]::DirectorySeparatorChar))
    $relative = [IO.Path]::GetRelativePath(
        $projectDirectory,
        $Path.Replace(
            '/', [IO.Path]::DirectorySeparatorChar)).
        Replace([IO.Path]::DirectorySeparatorChar, '\')
    foreach ($node in @($xml.SelectNodes(
            '//*[local-name()="Compile" and @Remove]'))) {
        $pattern = [
            System.Management.Automation.WildcardPattern]::new(
            ([string]$node.GetAttribute('Remove')).Replace('/', '\'),
            [System.Management.Automation.WildcardOptions]::IgnoreCase)
        if ($pattern.IsMatch($relative)) {
            return [pscustomobject]@{
                State = 'excluded'
                Path = [string]$nearest[0].path
            }
        }
    }
    return [pscustomobject]@{
        State = 'test'
        Path = [string]$nearest[0].path
    }
}

function Get-ContextualCoverageOutcomes {
    param(
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$Spans,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    $project = Get-ContextualTestProject `
        -Path $Path -SnapshotFiles $SnapshotFiles
    if ([string]$project.State -ceq 'unknown') {
        return , (New-ContextualOutcome `
            -RuleId test-class-code-coverage `
            -State unknown -Reason $project.Reason `
            -Path $Path)
    }
    if ([string]$project.State -cne 'test') {
        return , (New-ContextualOutcome `
            -RuleId test-class-code-coverage `
            -State compliant -Reason not-a-compiled-test-project-class `
            -Path $Path)
    }
    $types = @($Root.DescendantNodes() | Where-Object {
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.ClassDeclarationSyntax] -or
            ($_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.RecordDeclarationSyntax] -and
                [string]$_.ClassOrStructKeyword.Text -cne 'struct')
        })
    $outcomes = [Collections.Generic.List[object]]::new()
    foreach ($type in $types) {
        $keywordLine = [int](
            $type.Keyword.GetLocation().
                GetLineSpan().StartLinePosition.Line + 1)
        $identifierLine = [int](
            $type.Identifier.GetLocation().
                GetLineSpan().StartLinePosition.Line + 1)
        $attributeLines = @($type.AttributeLists | ForEach-Object {
                Get-ContextualNodeLine $_
            })
        $headerLines = @($keywordLine..$identifierLine)
        $changedLines = @($attributeLines + $headerLines |
            Where-Object {
                Test-ContextualChangedLine `
                    -Line $_ -Spans $Spans
            } | Sort-Object -Unique)
        if ($changedLines.Count -lt 1) {
            continue
        }
        $anchorLine = if (
            Test-ContextualChangedLine `
                -Line $identifierLine -Spans $Spans) {
            $identifierLine
        }
        else {
            [int]$changedLines[0]
        }
        $attributeState =
            Get-ContextualCoverageAttributeState `
                -Type $type -Root $Root `
                -SnapshotFiles $SnapshotFiles
        if ($attributeState -ceq 'present') {
            continue
        }
        if ($attributeState -ceq 'ambiguous') {
            [void]$outcomes.Add(
                (New-ContextualOutcome `
                    -RuleId test-class-code-coverage `
                    -State unknown `
                    -Reason coverage-attribute-binding-unproven `
                    -Path $Path -Line $anchorLine `
                    -EndLine $anchorLine `
                    -Symbol ([string]$type.Identifier.ValueText)))
            continue
        }
        if (@($type.Modifiers | Where-Object {
                    [string]$_.Text -ceq 'partial'
                }).Count -gt 0) {
            [void]$outcomes.Add(
                (New-ContextualOutcome `
                    -RuleId test-class-code-coverage `
                    -State unknown `
                    -Reason partial-class-coverage-attribute-unproven `
                    -Path $Path -Line $anchorLine `
                    -EndLine $anchorLine `
                    -Symbol ([string]$type.Identifier.ValueText)))
            continue
        }
        [void]$outcomes.Add(
            (New-ContextualOutcome `
                -RuleId test-class-code-coverage `
                -State violation `
                -Reason test-class-coverage-exclusion-missing `
                -Path $Path -Line $anchorLine `
                -EndLine $anchorLine `
                -Symbol ([string]$type.Identifier.ValueText) `
                -Evidence (
                    'Add System.Diagnostics.CodeAnalysis.' +
                    'ExcludeFromCodeCoverage to this test-project class.')))
    }
    if ($outcomes.Count -gt 0) {
        $definite = @($outcomes | Where-Object {
                [string]$_.state -ceq 'violation'
            })
        if ($definite.Count -gt 0) {
            return $definite
        }
        return $outcomes.ToArray()
    }
    return , (New-ContextualOutcome `
        -RuleId test-class-code-coverage `
        -State compliant -Reason no-changed-class-without-coverage-exclusion `
        -Path $Path)
}

function Get-ContextualBlockIndentationOutcome {
    param(
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][string]$Content,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$Spans
    )
    $ruleId = 'block-body-indentation'
    if ($Path -imatch
            '(^|[\\/])(?:obj|generated|Ignore-AddedForReferenceOnly)([\\/]|$)|(?:\.g|\.designer)\.cs$' -or
        $Content -match
            '(?im)^\s*//\s*<auto-generated(?:\s|>)') {
        return New-ContextualOutcome `
            -RuleId $ruleId -State compliant `
            -Reason generated-code-excluded -Path $Path
    }
    $conditional = @($Root.DescendantTrivia($null, $true) |
        Where-Object {
            $_.HasStructure -and
            $_.GetStructure().GetType().Name -cin @(
                'IfDirectiveTriviaSyntax',
                'ElifDirectiveTriviaSyntax',
                'ElseDirectiveTriviaSyntax',
                'EndIfDirectiveTriviaSyntax',
                'DefineDirectiveTriviaSyntax',
                'UndefDirectiveTriviaSyntax')
        })
    if ($conditional.Count -gt 0) {
        return New-ContextualOutcome `
            -RuleId $ruleId -State unknown `
            -Reason block-indentation-preprocessor-context-unproven `
            -Path $Path
    }
    $lines = @($Content -split "`r?`n")
    $unknown = $false
    foreach ($block in @($Root.DescendantNodes() |
            Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.BlockSyntax]
            })) {
        if (@($block.Ancestors() | Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.InterpolatedStringExpressionSyntax]
                }).Count -gt 0) {
            continue
        }
        $braceSpan =
            $block.OpenBraceToken.GetLocation().GetLineSpan()
        $braceLine =
            [int]$braceSpan.StartLinePosition.Line + 1
        $braceColumn =
            [int]$braceSpan.StartLinePosition.Character
        $bracePrefix =
            $lines[$braceLine - 1].Substring(0, $braceColumn)
        $changedTryBoundary =
            $block.Parent -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.TryStatementSyntax] -and
            (Test-ContextualChangedLine -Line $braceLine -Spans $Spans) -and
            (Test-ContextualChangedLine `
                -Line (Get-ContextualNodeLine $block.Parent) -Spans $Spans)
        foreach ($statement in $block.Statements) {
            $token = $statement.GetFirstToken($false, $false, $false, $false)
            $span = $token.GetLocation().GetLineSpan()
            $line = [int]$span.StartLinePosition.Line + 1
            $statementChanged = Test-ContextualChangedLine `
                -Line $line -Spans $Spans
            if (-not $statementChanged -and -not $changedTryBoundary) {
                continue
            }
            $column = [int]$span.StartLinePosition.Character
            $prefix = $lines[$line - 1].Substring(0, $column)
            if ($line -le $braceLine -or
                $bracePrefix -cnotmatch '^ *$' -or
                $prefix -cnotmatch '^[ \t]*$' -or
                $statement -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.LabeledStatementSyntax]) {
                $unknown = $true
                continue
            }
            $expected = $braceColumn + 4
            if ($prefix -cnotmatch "`t" -and
                $prefix.Length -eq $expected) {
                continue
            }
            $actual = if ($prefix.Contains("`t")) {
                'tab indentation'
            }
            else { "$($prefix.Length) leading spaces" }
            $outcome = New-ContextualOutcome `
                -RuleId $ruleId -State violation `
                -Reason block-body-not-one-four-space-increment `
                -Path $Path `
                -Line $(if ($statementChanged) { $line } else { $braceLine }) `
                -EndLine $(if ($statementChanged) { $line } else { $braceLine }) `
                -Symbol (
                    $block.Parent.GetType().Name.
                        Replace('Syntax', '') + ' body') `
                -Evidence (
                    "Indent the direct block statement at line $line one level " +
                    "(four spaces) from its opening brace; expected " +
                    "$expected leading spaces, found $actual.")
            $outcome['indentationContext'] = [ordered]@{
                blockStartLine = $braceLine
                blockEndLine = [int](
                    $block.CloseBraceToken.GetLocation().
                        GetLineSpan().StartLinePosition.Line + 1)
                statementLine = $line
            }
            return $outcome
        }
    }
    return New-ContextualOutcome `
        -RuleId $ruleId `
        -State $(if ($unknown) { 'unknown' } else { 'compliant' }) `
        -Reason $(if ($unknown) {
                'block-indentation-layout-unproven'
            } else { 'no-applicable-block-indentation-violation' }) `
        -Path $Path
}

function Get-ContextualXmlSummaryLayoutOutcome {
    param(
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][string]$Content,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$Spans
    )
    if ($Path -imatch
            '(^|/)(?:obj|generated|Ignore-AddedForReferenceOnly)(/|$)|(?:\.g|\.designer)\.cs$' -or
        $Content -match
            '(?im)^\s*//\s*<auto-generated(?:\s|>)') {
        return New-ContextualOutcome `
            -RuleId xml-summary-layout `
            -State compliant `
            -Reason generated-code-excluded `
            -Path $Path
    }
    $lines = @($Content -split "`r?`n")
    foreach ($declaration in @($Root.DescendantNodes() |
            Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.MemberDeclarationSyntax]
            })) {
        foreach ($trivia in @(
                $declaration.GetLeadingTrivia())) {
            if (-not $trivia.HasStructure) {
                continue
            }
            $documentation = $trivia.GetStructure()
            if ($documentation -isnot [
                    Microsoft.CodeAnalysis.CSharp.Syntax.DocumentationCommentTriviaSyntax]) {
                continue
            }
            foreach ($summary in @(
                    $documentation.Content |
                        Where-Object {
                            ($_ -is [
                                    Microsoft.CodeAnalysis.CSharp.Syntax.XmlElementSyntax] -and
                                [string]$_.StartTag.Name.LocalName.ValueText -ceq
                                    'summary') -or
                            ($_ -is [
                                    Microsoft.CodeAnalysis.CSharp.Syntax.XmlEmptyElementSyntax] -and
                                [string]$_.Name.LocalName.ValueText -ceq
                                    'summary')
                        })) {
                $span = $summary.GetLocation().GetLineSpan()
                $first =
                    [int]$span.StartLinePosition.Line + 1
                $last =
                    [int]$span.EndLinePosition.Line + 1
                $changed = @($Spans | Where-Object {
                        $first -le [int]$_.endLine -and
                        $last -ge [int]$_.startLine
                    })
                if ($changed.Count -eq 0) {
                    continue
                }
                if ($first -lt 1 -or
                    $last -gt $lines.Count -or
                    $first -gt $last) {
                    return New-ContextualOutcome `
                        -RuleId xml-summary-layout `
                        -State unknown `
                        -Reason xml-summary-source-span-unavailable `
                        -Path $Path -Line $first `
                        -EndLine $last
                }
                $opening = [string]$lines[$first - 1]
                $closing = [string]$lines[$last - 1]
                $openingMatch = [regex]::Match(
                    $opening,
                    '^(?<indent>[ \t]*)///[ \t]*<summary>[ \t]*$')
                $openingStandalone =
                    -not ($summary -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.XmlEmptyElementSyntax]) -and
                    $openingMatch.Success
                $indent = if ($openingMatch.Success) {
                    [string]$openingMatch.Groups['indent'].Value
                }
                else { $null }
                $linePrefix = if ($openingMatch.Success) {
                    '^' + [regex]::Escape($indent) + '///'
                }
                else { '(?!)' }
                $closingStandalone =
                    $openingStandalone -and
                    $closing -cmatch (
                        $linePrefix +
                        '[ \t]*</summary>[ \t]*$')
                $bodyLines = @(
                    if ($last -gt $first + 1) {
                        $lines[$first..($last - 2)]
                    })
                $bodyStandalone =
                    $bodyLines.Count -gt 0 -and
                    @($bodyLines | Where-Object {
                            [string]$_ -cnotmatch (
                                $linePrefix + '(?:[ \t]|$)')
                        }).Count -eq 0 -and
                    @($bodyLines | Where-Object {
                            [string]$_ -cmatch (
                                $linePrefix + '[ \t]*\S')
                        }).Count -gt 0
                $documentationSpan =
                    $documentation.GetLocation().GetLineSpan()
                $documentationFirst =
                    [int]$documentationSpan.
                        StartLinePosition.Line + 1
                $documentationLast =
                    [int]$documentationSpan.
                        EndLinePosition.Line + 1
                if ($documentationSpan.
                        EndLinePosition.Character -eq 0 -and
                    $documentationLast -gt
                        $documentationFirst) {
                    $documentationLast--
                }
                $documentationLines = @(
                    if ($documentationFirst -ge 1 -and
                        $documentationLast -le
                            $lines.Count -and
                        $documentationFirst -le
                            $documentationLast) {
                        $lines[(
                            $documentationFirst - 1
                        )..(
                            $documentationLast - 1
                        )]
                    })
                $documentationAligned =
                    $documentationLines.Count -gt 0 -and
                    @($documentationLines | Where-Object {
                            [string]$_ -cnotmatch $linePrefix
                        }).Count -eq 0
                if ($openingStandalone -and
                    $closingStandalone -and
                    $bodyStandalone -and
                    $documentationAligned) {
                    continue
                }
                $anchors = @(
                    foreach ($change in $changed) {
                        [Math]::Max(
                            $first,
                            [int]$change.startLine)
                    })
                $anchor = [int](
                    $anchors |
                        Measure-Object -Minimum).
                    Minimum
                $symbol = if (
                    $declaration.PSObject.Properties[
                        'Identifier']) {
                    [string]$declaration.Identifier.ValueText
                }
                elseif ($declaration.PSObject.Properties[
                        'Declaration'] -and
                    $null -ne $declaration.Declaration -and
                    $declaration.Declaration.Variables.Count -gt 0) {
                    [string]$declaration.Declaration.
                        Variables[0].Identifier.ValueText
                }
                elseif ($declaration -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.IndexerDeclarationSyntax]) {
                    'this'
                }
                else { 'declaration' }
                return New-ContextualOutcome `
                    -RuleId xml-summary-layout `
                    -State violation `
                    -Reason xml-summary-tags-not-standalone `
                    -Path $Path -Line $anchor `
                    -EndLine $anchor `
                    -Symbol $symbol `
                    -Evidence (
                        'Put summary tags on standalone /// lines ' +
                        'with the body on intervening /// lines.')
            }
        }
    }
    return New-ContextualOutcome `
        -RuleId xml-summary-layout `
        -State compliant `
        -Reason no-changed-nonstandard-summary-layout `
        -Path $Path
}

function Get-ContextualConstantProjectBinding {
    param([Parameter(Mandatory)]$File)
    if ($File -isnot [Collections.IDictionary] -or
        -not $File.Contains('projectContext') -or
        $File.projectContext -isnot
            [Collections.IDictionary] -or
        -not $File.projectContext.Contains('state') -or
        -not $File.projectContext.Contains('path') -or
        -not $File.projectContext.Contains('content') -or
        [string]$File.projectContext.state -cne
            'complete' -or
        [string]::IsNullOrWhiteSpace(
            [string]$File.projectContext.path) -or
        $File.projectContext.content -isnot [string]) {
        return [pscustomobject]@{
            State = 'unknown'
        }
    }
    $content = [string]$File.projectContext.content
    if ($content -match
        '(?is)<(?:IsTestProject|PackageReference\b[^>]*Include\s*=\s*["'']Microsoft\.NET\.Test\.Sdk["''])') {
        return [pscustomobject]@{
            State = 'test'
        }
    }
    if ($content -match
        '(?is)<(?:LangVersion|Compile|DefineConstants)\b[^>]*Condition\s*=') {
        return [pscustomobject]@{
            State = 'conditional'
        }
    }
    return [pscustomobject]@{
        State = 'complete'
        Path = [string]$File.projectContext.path
        Digest = $(if (
            $File.projectContext.Contains('sourceDigest') -and
            [string]$File.projectContext.sourceDigest -match
                '^v1:sha256:[0-9a-f]{64}$') {
                [string]$File.projectContext.sourceDigest
            }
            else {
                'v1:sha256:' +
                [Convert]::ToHexString(
                    [Security.Cryptography.SHA256]::HashData(
                        [Text.Encoding]::UTF8.GetBytes(
                            $content))).ToLowerInvariant()
            })
    }
}

function Get-ContextualDuplicateConstantDeclarations {
    param(
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    $declarations =
        [Collections.Generic.List[object]]::new()
    $files = [Collections.Generic.List[object]]::new()
    $currentFile = @($SnapshotFiles | Where-Object {
            $_ -is [Collections.IDictionary] -and
            [string]$_.path -ieq $Path
        })
    [void]$files.Add([pscustomobject]@{
            Path = $Path
            Root = $Root
            Current = $true
            Conditional = [regex]::IsMatch(
                $Root.ToFullString(),
                '(?m)^[ \t]*#(?:if|elif|else|endif)\b')
            Project = $(if ($currentFile.Count -eq 1) {
                    Get-ContextualConstantProjectBinding `
                        -File $currentFile[0]
                } else {
                    [pscustomobject]@{
                        State = 'unknown'
                    }
                })
        })
    foreach ($file in $SnapshotFiles) {
        if ($file -isnot [Collections.IDictionary] -or
            [string]$file.path -ieq $Path -or
            [string]$file.path -inotmatch '\.cs$' -or
            [string]$file.state -cne 'complete' -or
            $file.content -isnot [string]) {
            continue
        }
        if ([string]$file.path -imatch
                '(^|/)(?:obj|generated|Ignore-AddedForReferenceOnly)(/|$)|(?:\.g|\.designer)\.cs$' -or
            [string]$file.content -match
                '(?im)^\s*//\s*<auto-generated(?:\s|>)') {
            continue
        }
        $tree = [
            Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree]::ParseText(
                [string]$file.content)
        if (@($tree.GetDiagnostics() | Where-Object {
                    $_.Severity -eq [
                        Microsoft.CodeAnalysis.DiagnosticSeverity]::Error
                }).Count -gt 0) {
            continue
        }
        [void]$files.Add([pscustomobject]@{
                Path = [string]$file.path
                Root = $tree.GetRoot()
                Current = $false
                Conditional = [regex]::IsMatch(
                    [string]$file.content,
                    '(?m)^[ \t]*#(?:if|elif|else|endif)\b')
                Project =
                    Get-ContextualConstantProjectBinding `
                        -File $file
            })
    }
    foreach ($file in $files) {
        foreach ($type in @(
                $file.Root.DescendantNodes() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.ClassDeclarationSyntax]
                    })) {
            $typeModifiers = @($type.Modifiers |
                ForEach-Object {
                    [string]$_.Text
                })
            if ('static' -cnotin $typeModifiers -or
                'internal' -cnotin $typeModifiers) {
                continue
            }
            $namespace = @($type.Ancestors() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.BaseNamespaceDeclarationSyntax]
                } | Select-Object -First 1)
            if ($namespace.Count -ne 1) {
                continue
            }
            $typeDocs =
                [string]$type.GetLeadingTrivia().
                    ToFullString()
            $nested = @($type.Ancestors() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]
                }).Count -gt 0
            $contractTokens = @(
                [regex]::Matches(
                    $typeDocs,
                    '(?is)<c>\s*(?<token>[^<]{1,256})\s*</c>') |
                    ForEach-Object {
                        $windowStart =
                            [Math]::Max(
                                0,
                                $_.Index - 160)
                        $windowLength =
                            [Math]::Min(
                                $typeDocs.Length -
                                    $windowStart,
                                $_.Length + 320)
                        $window =
                            $typeDocs.Substring(
                                $windowStart,
                                $windowLength)
                        if ($window -match
                            '(?i)\bcontract\b') {
                            $_.Groups[
                                'token'].Value.Trim()
                        }
                    } |
                    Where-Object {
                        [string]$_ -cmatch
                            '^[A-Za-z0-9][A-Za-z0-9._/-]{1,254}[A-Za-z0-9]$' -and
                        [string]$_ -cmatch '[./-]' -and
                        [string]$_ -cnotin @(
                            'true',
                            'false',
                            'null')
                    } |
                    Sort-Object -Unique)
            foreach ($field in @(
                    $type.Members | Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.FieldDeclarationSyntax]
                    })) {
                $modifiers = @($field.Modifiers |
                    ForEach-Object {
                        [string]$_.Text
                    })
                if ('const' -cnotin $modifiers -or
                    'internal' -cnotin $modifiers -or
                    $field.Declaration.Type -isnot [
                        Microsoft.CodeAnalysis.CSharp.Syntax.PredefinedTypeSyntax] -or
                    [string]$field.Declaration.Type.Keyword.Text -cne
                        'string') {
                    continue
                }
                foreach ($variable in @(
                        $field.Declaration.Variables)) {
                    if ($null -eq $variable.Initializer -or
                        [int]$variable.Initializer.Value.RawKind -ne
                            [int][
                                Microsoft.CodeAnalysis.CSharp.SyntaxKind]::
                                    StringLiteralExpression -or
                        [string]$variable.Initializer.Value.Token.ValueText -ceq
                            '') {
                        continue
                    }
                    [void]$declarations.Add(
                        [pscustomobject]@{
                            Path = [string]$file.Path
                            Current =
                                [bool]$file.Current
                            Project = $file.Project
                            Namespace =
                                [string]$namespace[0].
                                    Name.ToString()
                            TypeName =
                                [string]$type.Identifier.ValueText
                            Name =
                                [string]$variable.Identifier.ValueText
                            ConstantType =
                                'System.String'
                            Value =
                                [string]$variable.Initializer.Value.
                                    Token.ValueText
                            Line =
                                Get-ContextualNodeLine `
                                    $variable
                            ContractTokens =
                                $contractTokens
                            Unsupported =
                                [bool]$file.Conditional -or
                                $nested
                        })
                }
            }
        }
    }
    return $declarations.ToArray()
}

function Get-ContextualDuplicateConstantOutcome {
    param(
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][string]$Content,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$Spans,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    if ($Path -imatch
            '(^|/)(?:obj|generated|Ignore-AddedForReferenceOnly)(/|$)|(?:\.g|\.designer)\.cs$' -or
        $Content -match
            '(?im)^\s*//\s*<auto-generated(?:\s|>)') {
        return New-ContextualOutcome `
            -RuleId duplicate-constant-declarations `
            -State compliant `
            -Reason generated-code-excluded `
            -Path $Path
    }
    $declarations =
        @(Get-ContextualDuplicateConstantDeclarations `
            -Root $Root -Path $Path `
            -SnapshotFiles $SnapshotFiles)
    $changed = @($declarations |
        Where-Object {
            [bool]$_.Current -and
            (Test-ContextualChangedLine `
                -Line ([int]$_.Line) `
                -Spans $Spans)
        })
    if ($changed.Count -eq 0) {
        return New-ContextualOutcome `
            -RuleId duplicate-constant-declarations `
            -State compliant `
            -Reason no-changed-eligible-constant `
            -Path $Path
    }
    if (@($changed | Where-Object {
                [bool]$_.Unsupported
            }).Count -gt 0) {
        $firstUnsupported = @($changed |
            Where-Object {
                [bool]$_.Unsupported
            } |
            Sort-Object Line)[0]
        return New-ContextualOutcome `
            -RuleId duplicate-constant-declarations `
            -State unknown `
            -Reason duplicate-constant-scope-unproven `
            -Path $Path `
            -Line ([int]$firstUnsupported.Line) `
            -EndLine ([int]$firstUnsupported.Line) `
            -Symbol ([string]$firstUnsupported.TypeName)
    }
    $violations =
        [Collections.Generic.List[object]]::new()
    $unknowns =
        [Collections.Generic.List[object]]::new()
    foreach ($candidate in $changed) {
        foreach ($comparison in @(
                $declarations | Where-Object {
                    (-not (
                        [string]$_.Path -ieq
                            [string]$candidate.Path -and
                        [string]$_.TypeName -ceq
                            [string]$candidate.TypeName)) -and
                    [string]$_.Name -ceq
                        [string]$candidate.Name -and
                    [string]$_.ConstantType -ceq
                        [string]$candidate.ConstantType -and
                    [string]$_.Value -ceq
                        [string]$candidate.Value
                })) {
            $projectProven =
                [string]$candidate.Project.State -ceq
                    'complete' -and
                [string]$comparison.Project.State -ceq
                    'complete' -and
                [string]$candidate.Project.Path -ieq
                    [string]$comparison.Project.Path -and
                [string]$candidate.Project.Digest -ceq
                    [string]$comparison.Project.Digest
            $sameNamespace =
                [string]$candidate.Namespace -ceq
                    [string]$comparison.Namespace
            $sharedContract = @(
                $candidate.ContractTokens |
                    Where-Object {
                        [string]$_ -cin
                            @($comparison.ContractTokens)
                    })
            if ($projectProven -and
                $sameNamespace -and
                $sharedContract.Count -eq 1 -and
                -not [bool]$comparison.Unsupported) {
                [void]$violations.Add([pscustomobject]@{
                        Candidate = $candidate
                        Comparison = $comparison
                        Contract =
                            [string]$sharedContract[0]
                    })
            }
            else {
                [void]$unknowns.Add([pscustomobject]@{
                        Candidate = $candidate
                        Comparison = $comparison
                    })
            }
        }
    }
    $contracts = @($violations |
        ForEach-Object {
            [string]$_.Contract
        } |
        Sort-Object -Unique)
    if ($unknowns.Count -gt 0 -or
        $contracts.Count -gt 1) {
        $first = @(
            @($unknowns) + @($violations) |
                Sort-Object {
                    [int]$_.Candidate.Line
                })[0]
        return New-ContextualOutcome `
            -RuleId duplicate-constant-declarations `
            -State unknown `
            -Reason duplicate-constant-relation-unproven `
            -Path $Path `
            -Line ([int]$first.Candidate.Line) `
            -EndLine ([int]$first.Candidate.Line) `
            -Symbol ([string]$first.Candidate.TypeName)
    }
    if ($violations.Count -gt 0) {
        $ordered = @($violations | Sort-Object {
                [int]$_.Candidate.Line
            })
        $first = $ordered[0]
        $lastLine = [int](
            $ordered.Candidate.Line |
                Measure-Object -Maximum).Maximum
        $pairs = @($ordered | ForEach-Object {
                [string]$_.Candidate.Name +
                '="' +
                [string]$_.Candidate.Value +
                '"'
            } | Sort-Object -Unique)
        return New-ContextualOutcome `
            -RuleId duplicate-constant-declarations `
            -State violation `
            -Reason duplicate-shared-contract-constants `
            -Path $Path `
            -Line ([int]$first.Candidate.Line) `
            -EndLine $lastLine `
            -Symbol ([string]$first.Candidate.TypeName) `
            -Evidence (
                'Consolidate duplicated constants ' +
                ($pairs -join ', ') +
                ' for shared contract ' +
                [string]$first.Contract + '.')
    }
    return New-ContextualOutcome `
        -RuleId duplicate-constant-declarations `
        -State compliant `
        -Reason no-matching-constant-declaration `
        -Path $Path
}

function Test-ContextualExceptionNamingGeneratedFile {
    param([string]$Path, [AllowEmptyString()][string]$Content)
    return (
        $Path.Replace('\', '/') -imatch
            '(^|/)(?:obj|generated|Ignore-AddedForReferenceOnly)(/|$)|(?:\.g|\.designer)\.cs$' -or
        $Content -match '(?im)^\s*//\s*<auto-generated(?:\s|>)')
}

function Test-ContextualExceptionNamingGeneratedAncestor {
    param([Parameter(Mandatory)]$Node)
    foreach ($ancestor in $Node.AncestorsAndSelf()) {
        $attributes = $ancestor.PSObject.Properties['AttributeLists']
        if ($null -ne $attributes -and
            @($attributes.Value | ForEach-Object { $_.Attributes } | Where-Object {
                    $_.Name.ToString() -cmatch
                        '(?:^|\.|::)(?:GeneratedCode|CompilerGenerated)(?:Attribute)?$'
                }).Count -gt 0) {
            return $true
        }
    }
    return $false
}

function Get-ContextualExceptionNamingBindingTree {
    param(
        [Parameter(Mandatory)]$Root,
        [switch]$GeneratedFile
    )
    $bodies = @($Root.DescendantNodes() | Where-Object {
            ($_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.BaseMethodDeclarationSyntax] -or
                $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.AccessorDeclarationSyntax] -or
                $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.LocalFunctionStatementSyntax]) -and
            $null -ne $_.Body -and
            -not $_.Body.OpenBraceToken.IsMissing -and
            -not $_.Body.CloseBraceToken.IsMissing -and
            ($GeneratedFile -or
                (Test-ContextualExceptionNamingGeneratedAncestor -Node $_))
        } | ForEach-Object { $_.Body } | Sort-Object { $_.Span.Start })
    if ($bodies.Count -eq 0) {
        return $Root.GetLocation().SourceTree
    }
    $characters = $Root.ToFullString().ToCharArray()
    $lastEnd = 0
    foreach ($body in $bodies) {
        $first = $body.OpenBraceToken.Span.End
        $last = $body.CloseBraceToken.Span.Start
        if ($first -lt $lastEnd) {
            continue
        }
        # Preserve declarations, braces, and original coordinates for type binding.
        for ($index = $first; $index -lt $last; $index++) {
            if ($characters[$index] -notin @("`r", "`n")) {
                $characters[$index] = ' '
            }
        }
        $lastEnd = $last
    }
    return [Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree]::ParseText(
        [string]::new($characters))
}

function Get-ContextualExceptionNamingConditionalState {
    param(
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][AllowEmptyCollection()][object[]]$Spans,
        [switch]$Source
    )
    $bindingUnknown = $false
    $changedCatchUnknown = $false
    $conditionals = [Collections.Generic.List[Microsoft.CodeAnalysis.Text.TextSpan]]::new()
    $starts = [Collections.Generic.Stack[int]]::new()
    $sourceText = $Root.GetLocation().SourceTree.GetText(
        [Threading.CancellationToken]::None)
    foreach ($trivia in $Root.DescendantTrivia(
            [Func[Microsoft.CodeAnalysis.SyntaxNode, bool]]$null, $true)) {
        if ($trivia.RawKind -eq [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::IfDirectiveTrivia) {
            $starts.Push($trivia.Span.Start)
        }
        elseif ($trivia.RawKind -eq [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::EndIfDirectiveTrivia -and
            $starts.Count -gt 0) {
            [void]$conditionals.Add(
                [Microsoft.CodeAnalysis.Text.TextSpan]::FromBounds(
                    $starts.Pop(), $trivia.Span.End))
        }
        elseif ($trivia.RawKind -eq [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::DisabledTextTrivia) {
            $insideBody = @($trivia.Token.Parent.AncestorsAndSelf() | Where-Object {
                    ($_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.BaseMethodDeclarationSyntax] -or
                        $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.AccessorDeclarationSyntax] -or
                        $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.LocalFunctionStatementSyntax]) -and
                    (($null -ne $_.Body -and $_.Body.FullSpan.Contains($trivia.Span)) -or
                        ($null -ne $_.ExpressionBody -and $_.ExpressionBody.FullSpan.Contains($trivia.Span)))
                }).Count -gt 0
            $tokens = @([Microsoft.CodeAnalysis.CSharp.SyntaxFactory]::ParseTokens(
                    $trivia.ToString()))
            for ($index = 0; $index -lt $tokens.Count; $index++) {
                $token = $tokens[$index]
                if ($Source -and $token.RawKind -eq
                    [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::CatchKeyword) {
                    $line = $sourceText.Lines.GetLineFromPosition(
                        $trivia.Span.Start + $token.Span.Start).LineNumber + 1
                    if (Test-ContextualChangedLine -Line $line -Spans $Spans) {
                        $changedCatchUnknown = $true
                    }
                }
                $recordDeclaration = $token.Text -ceq 'record' -and
                    $index + 1 -lt $tokens.Count -and
                    $tokens[$index + 1].RawKind -in @(
                        [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::ClassKeyword,
                        [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::StructKeyword,
                        [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::IdentifierToken)
                if (-not $insideBody -and (
                        $token.RawKind -in @(
                            [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::NamespaceKeyword,
                            [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::ClassKeyword,
                            [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::StructKeyword,
                            [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::InterfaceKeyword,
                            [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::EnumKeyword,
                            [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::DelegateKeyword) -or
                        $recordDeclaration)) {
                    $bindingUnknown = $true
                }
                if ($token.RawKind -eq [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::UsingKeyword -and
                    (($Source -and -not $insideBody) -or
                        ($index -gt 0 -and $tokens[$index - 1].Text -ceq 'global'))) {
                    $bindingUnknown = $true
                }
            }
        }
    }
    if ($conditionals.Count -gt 0) {
        foreach ($node in $Root.DescendantNodes()) {
            $bindingSpan = if ($node -is [Microsoft.CodeAnalysis.CSharp.Syntax.UsingDirectiveSyntax] -and
                ($Source -or $node.GlobalKeyword.RawKind -ne 0)) {
                $node.Span
            }
            elseif ($node -is [Microsoft.CodeAnalysis.CSharp.Syntax.BaseNamespaceDeclarationSyntax]) {
                $node.Name.Span
            }
            elseif ($node -is [Microsoft.CodeAnalysis.CSharp.Syntax.BaseTypeDeclarationSyntax] -or
                $node -is [Microsoft.CodeAnalysis.CSharp.Syntax.DelegateDeclarationSyntax]) {
                $node.Identifier.Span
            }
            else { $null }
            if ($null -ne $bindingSpan -and
                @($conditionals | Where-Object { $_.IntersectsWith($bindingSpan) }).Count -gt 0) {
                $bindingUnknown = $true
            }
        }
    }
    return [pscustomobject]@{
        BindingUnknown = $bindingUnknown
        ChangedCatchUnknown = $changedCatchUnknown
        Spans = $conditionals.ToArray()
    }
}

function Get-ContextualExceptionNamingOutcomes {
    param(
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][string]$Content,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$Spans,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    $ruleId = 'generic-exception-naming'
    if (Test-ContextualExceptionNamingGeneratedFile -Path $Path -Content $Content) {
        return New-ContextualOutcome -RuleId $ruleId -State compliant `
            -Reason generated-code-excluded -Path $Path
    }
    $sourceTree = Get-ContextualExceptionNamingBindingTree -Root $Root
    $Root = $sourceTree.GetRoot()
    $conditional = Get-ContextualExceptionNamingConditionalState `
        -Root $Root -Spans $Spans -Source
    $catches = @($Root.DescendantNodes() | Where-Object {
            $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.CatchDeclarationSyntax] -and
            -not $_.Identifier.IsMissing -and
            $_.Identifier.ValueText.Length -gt 0 -and
            -not (Test-ContextualExceptionNamingGeneratedAncestor -Node $_) -and
            (Test-ContextualNodeChanged -Node $_ -Spans $Spans)
        })
    if ($catches.Count -eq 0) {
        if ($conditional.ChangedCatchUnknown) {
            return New-ContextualOutcome -RuleId $ruleId -State unknown `
                -Reason conditional-catch-binding-unproven -Path $Path
        }
        return New-ContextualOutcome -RuleId $ruleId -State compliant `
            -Reason no-applicable-violation -Path $Path
    }
    $trees = [Collections.Generic.List[Microsoft.CodeAnalysis.SyntaxTree]]::new()
    [void]$trees.Add($sourceTree)
    $bindingUnknown = $conditional.BindingUnknown
    foreach ($file in $SnapshotFiles) {
        if (-not ([string]$file.path).EndsWith(
                '.cs', [StringComparison]::OrdinalIgnoreCase) -or
            [string]$file.path -ieq $Path -or
            ([string]$file.path).Replace('\', '/') -imatch
                '(^|/)(?:obj|Ignore-AddedForReferenceOnly)(/|$)') {
            continue
        }
        if ([string]$file.state -cne 'complete' -or
            $file.content -isnot [string]) {
            $bindingUnknown = $true
            continue
        }
        $snapshotRoot = [Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree]::ParseText(
            [string]$file.content).GetRoot()
        $generatedFile = Test-ContextualExceptionNamingGeneratedFile `
            -Path ([string]$file.path) -Content ([string]$file.content)
        $snapshotTree = Get-ContextualExceptionNamingBindingTree `
            -Root $snapshotRoot -GeneratedFile:$generatedFile
        $snapshotConditional = Get-ContextualExceptionNamingConditionalState `
            -Root $snapshotTree.GetRoot() -Spans @()
        if ($snapshotConditional.BindingUnknown) {
            $bindingUnknown = $true
        }
        [void]$trees.Add($snapshotTree)
    }
    foreach ($tree in $trees) {
        if (@($tree.GetDiagnostics() | Where-Object {
                    $_.Severity -eq [Microsoft.CodeAnalysis.DiagnosticSeverity]::Error
                }).Count -gt 0) {
            $bindingUnknown = $true
        }
    }
    $model = $null
    $systemException = $null
    if (-not $bindingUnknown) {
        $references = [Microsoft.CodeAnalysis.MetadataReference[]]@(
            [Microsoft.CodeAnalysis.MetadataReference]::CreateFromFile(
                [object].Assembly.Location))
        $compilation = [Microsoft.CodeAnalysis.CSharp.CSharpCompilation]::Create(
            'ContextualExceptionNaming', $trees.ToArray(), $references,
            [Microsoft.CodeAnalysis.CSharp.CSharpCompilationOptions]::new(
                [Microsoft.CodeAnalysis.OutputKind]::DynamicallyLinkedLibrary))
        $systemException = $compilation.GetSpecialType(
            [Microsoft.CodeAnalysis.SpecialType]::System_Object).
            ContainingAssembly.GetTypeByMetadataName('System.Exception')
        $model = $compilation.GetSemanticModel($sourceTree)
    }
    if ($conditional.ChangedCatchUnknown) {
        New-ContextualOutcome -RuleId $ruleId -State unknown `
            -Reason conditional-catch-binding-unproven -Path $Path
    }
    foreach ($declaration in $catches) {
        $changedTokens = @((@($declaration.Type.DescendantTokens()) +
                @($declaration.Identifier)) | Where-Object {
                Test-ContextualChangedLine `
                    -Line ($_.GetLocation().GetLineSpan().StartLinePosition.Line + 1) `
                    -Spans $Spans
            })
        if ($changedTokens.Count -eq 0) {
            continue
        }
        $line = [int]$changedTokens[0].GetLocation().
            GetLineSpan().StartLinePosition.Line + 1
        $identifierLine = [int]$declaration.Identifier.GetLocation().
            GetLineSpan().StartLinePosition.Line + 1
        if (Test-ContextualChangedLine -Line $identifierLine -Spans $Spans) {
            $line = $identifierLine
        }
        $variable = [string]$declaration.Identifier.ValueText
        $type = if ($null -ne $model) {
            $model.GetTypeInfo($declaration.Type).Type
        }
        else { $null }
        if ($bindingUnknown -or
            @($conditional.Spans | Where-Object { $_.IntersectsWith($declaration.Span) }).Count -gt 0 -or
            $null -eq $type -or
            $null -eq $systemException -or
            $type.TypeKind -ne [Microsoft.CodeAnalysis.TypeKind]::Class) {
            New-ContextualOutcome -RuleId $ruleId -State unknown `
                -Reason generic-exception-type-binding-unproven `
                -Path $Path -Line $line -EndLine $line -Symbol $variable
            continue
        }
        $generic = [Microsoft.CodeAnalysis.SymbolEqualityComparer]::Default.Equals(
            $type, $systemException)
        $baseType = $type
        while ($null -ne $baseType -and
            -not [Microsoft.CodeAnalysis.SymbolEqualityComparer]::Default.Equals(
                $baseType, $systemException)) {
            $baseType = $baseType.BaseType
        }
        if ($null -eq $baseType) {
            New-ContextualOutcome -RuleId $ruleId -State unknown `
                -Reason catch-exception-base-type-unproven `
                -Path $Path -Line $line -EndLine $line -Symbol $variable
            continue
        }
        if ($generic -and $variable -cne 'ex') {
            New-ContextualOutcome -RuleId $ruleId -State violation `
                -Reason generic-exception-variable-not-ex `
                -Path $Path -Line $line -EndLine $line -Symbol $variable `
                -Evidence (
                    "Name the System.Exception catch variable '$variable' 'ex' " +
                    'and update its uses, including the filter and catch body. ' +
                    'This convention does not prescribe names for specialized exceptions.')
        }
        else {
            New-ContextualOutcome -RuleId $ruleId -State compliant `
                -Reason $(if ($generic) {
                    'generic-exception-variable-is-ex'
                }
                else { 'not-system-exception' }) `
                -Path $Path -Line $line -EndLine $line -Symbol $variable
        }
    }
}

function Get-ContextualStringLiteralProject {
    param([AllowNull()]$File)
    if ($null -eq $File -or
        $File -isnot [Collections.IDictionary] -or
        -not $File.Contains('projectContext') -or
        $File.projectContext -isnot [Collections.IDictionary] -or
        -not $File.projectContext.Contains('state') -or
        -not $File.projectContext.Contains('path') -or
        -not $File.projectContext.Contains('content') -or
        [string]$File.projectContext.state -cne 'complete') {
        return [pscustomobject]@{ State = 'unknown' }
    }
    $context = $File.projectContext
    try {
        [xml]$xml = [string]$context.content
    }
    catch {
        return [pscustomobject]@{ State = 'unknown' }
    }
    $conditional = @($xml.SelectNodes(
            '//*[(local-name()="IsTestProject" or local-name()="LangVersion") and ancestor-or-self::*[@Condition]] | //*[@Condition and (local-name()="Compile" or local-name()="DefineConstants" or local-name()="PackageReference")]'))
    if ($conditional.Count -gt 0 -or
        $null -eq $xml.DocumentElement -or
        $xml.DocumentElement.LocalName -cne 'Project') {
        return [pscustomobject]@{ State = 'unknown' }
    }
    $test = @($xml.SelectNodes(
            '//*[local-name()="IsTestProject"]') |
        Where-Object { $_.InnerText.Trim() -ieq 'true' }).Count -gt 0 -or
        @($xml.SelectNodes(
            '//*[local-name()="PackageReference"]') |
        Where-Object {
            $_.GetAttribute('Include') -ceq 'Microsoft.NET.Test.Sdk'
        }).Count -gt 0
    if ($test) {
        return [pscustomobject]@{ State = 'test' }
    }
    if ([string]$context.path -inotmatch '\.csproj$' -or
        ($context.Contains('sourceDigest') -and
            [string]$context.sourceDigest -cne
                (Get-ContextualTextDigest -Value ([string]$context.content)))) {
        return [pscustomobject]@{ State = 'unknown' }
    }
    $directory = [IO.Path]::GetDirectoryName(
        ([string]$context.path).Replace('/', [IO.Path]::DirectorySeparatorChar))
    if ($directory -and -not ([string]$File.path).Replace('\', '/').StartsWith(
            $directory.Replace('\', '/') + '/', [StringComparison]::OrdinalIgnoreCase)) {
        return [pscustomobject]@{ State = 'unknown' }
    }
    $language = Get-ContextualNamedCallLanguageState -Path ([string]$File.path) -SnapshotFiles @($File)
    $rawSupported = [string]$language.State -ceq 'supported' -and
        ([string]$language.Version -cin @('latest', 'latestMajor', 'preview') -or
            [string]$language.Version -match '^(?:1[1-9]|[2-9][0-9])(?:\.0)?$')
    return [pscustomobject]@{
        State = 'complete'
        Path = [string]$context.path
        Digest = Get-ContextualTextDigest -Value ([string]$context.content)
        RawStringsSupported = $rawSupported
    }
}

function Get-ContextualStringComparisonRoot {
    param([Parameter(Mandatory)]$File)
    $keys = @('comparison','sourceCommit','targetCommit')
    if (@($keys | Where-Object { -not $File.Contains($_) }).Count -gt 0 -or
        $File.comparison -isnot [Collections.IDictionary]) { return $null }
    $baseline = $File.comparison
    $required = @('schemaVersion','state','path','targetPath','sourceCommit','targetCommit',
        'sourceDigest','targetDigest','byteLength','content','targetState')
    if (@($required | Where-Object { -not $baseline.Contains($_) }).Count -gt 0 -or
        [string]$File.sourceCommit -cnotmatch '^[0-9a-f]{40}$' -or
        [string]$File.targetCommit -cnotmatch '^[0-9a-f]{40}$' -or
        [string]$baseline.schemaVersion -cne '1' -or [string]$baseline.state -cne 'complete' -or
        $baseline.content -isnot [string] -or
        [string]$baseline.path -cne [string]$File.path -or
        [string]$baseline.targetPath -cne $(if ($File.Contains('oldPath') -and $File.oldPath) {
            [string]$File.oldPath
        } else { [string]$File.path }) -or
        [string]$baseline.sourceCommit -cne [string]$File.sourceCommit -or
        [string]$baseline.targetCommit -cne [string]$File.targetCommit -or
        [string]$baseline.sourceDigest -cne (Get-ContextualTextDigest ([string]$File.content)) -or
        [string]$baseline.targetDigest -cne (Get-ContextualTextDigest ([string]$baseline.content)) -or
        [string]$baseline.byteLength -cne [string][Text.Encoding]::UTF8.GetByteCount([string]$baseline.content) -or
        ([string]$baseline.targetState -ceq 'absent' -and (
            -not $File.Contains('changeType') -or [string]$File.changeType -cne 'added' -or
            [string]$baseline.content -cne '')) -or
        ($File.Contains('changeType') -and [string]$File.changeType -ceq 'added' -and
            [string]$baseline.targetState -cne 'absent') -or
        [string]$baseline.targetState -cnotin @('present','absent') -or
        [string]$baseline.content -match '(?m)^[ \t]*#(?:if|elif|else|endif)\b') {
        return $null
    }
    $tree = [Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree]::ParseText([string]$baseline.content)
    if (@($tree.GetDiagnostics() | Where-Object {
        $_.Severity -eq [Microsoft.CodeAnalysis.DiagnosticSeverity]::Error
    }).Count -gt 0) { return $null }
    return $tree.GetRoot()
}

function Get-ContextualReusedStringOutcomes {
    param(
        [Parameter(Mandatory)]$Root,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$Spans,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    $ruleId = 'reused-string-literals'
    $uses = [Collections.Generic.List[object]]::new()
    $byValue = [Collections.Generic.Dictionary[string,object]]::new(
        [StringComparer]::Ordinal)
    $targetCounts = [Collections.Generic.Dictionary[string,int]]::new([StringComparer]::Ordinal)
    $constants = [Collections.Generic.List[object]]::new()
    $baselineUnknown = $false
    $incompletePeer = $false
    $conditionalCurrent = $false
    $currentFiles = @($SnapshotFiles | Where-Object {
            [string]$_.path -ieq $Path
        })
    $currentFile = if ($currentFiles.Count -eq 1) {
        $currentFiles[0]
    } else { $null }
    $sources = @([ordered]@{
            path = $Path
            state = 'complete'
            content = $Root.ToFullString()
            spans = $Spans
            projectContext = $(if ($null -ne $currentFile -and
                    $currentFile.Contains('projectContext')) {
                    $currentFile.projectContext
                } else { $null })
        }) + @($SnapshotFiles | Where-Object {
            [string]$_.path -ine $Path -and
            [string]$_.path -imatch '\.cs$'
        })
    foreach ($key in @('comparison','sourceCommit','targetCommit','changeType','oldPath')) {
        if ($null -ne $currentFile -and $currentFile.Contains($key)) {
            $sources[0][$key] = $currentFile[$key]
        }
    }
    foreach ($file in $sources) {
        $filePath = ([string]$file.path).Replace('\', '/')
        $current = $filePath -ieq $Path.Replace('\', '/')
        if ($filePath -imatch
                '(^|/)(?:obj|generated|Ignore-AddedForReferenceOnly)(/|$)|(?:\.g|\.designer)\.cs$' -or
            [string]$file.content -match
                '(?im)^\s*//\s*<auto-generated(?:\s|>)') {
            continue
        }
        if ([string]$file.state -cne 'complete' -or
            $file.content -isnot [string]) {
            $incompletePeer = $true
            $baselineUnknown = $true
            continue
        }
        $tree = [Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree]::ParseText(
            [string]$file.content)
        if (@($tree.GetDiagnostics() | Where-Object {
                    $_.Severity -eq
                        [Microsoft.CodeAnalysis.DiagnosticSeverity]::Error
                }).Count -gt 0) {
            $incompletePeer = $true
            $baselineUnknown = $true
            continue
        }
        $project = Get-ContextualStringLiteralProject -File $file
        if ([string]$project.State -ceq 'test') {
            continue
        }
        $conditional = [regex]::IsMatch(
            [string]$file.content, '(?m)^[ \t]*#(?:if|elif|else|endif)\b')
        if ($current -and $conditional) { $conditionalCurrent = $true }
        $targetRoot = Get-ContextualStringComparisonRoot -File $file
        if ($null -eq $targetRoot) { $baselineUnknown = $true }
        $scans = @(@{Root=$tree.GetRoot();Target=$false})
        if ($null -ne $targetRoot) { $scans += @{Root=$targetRoot;Target=$true} }
        $fileSpans = @(if ($file.Contains('spans')) { $file.spans })
        foreach ($scan in $scans) {
        foreach ($literal in @($scan.Root.DescendantNodes() |
                Where-Object {
                    $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.LiteralExpressionSyntax] -and
                    [int]$_.RawKind -eq
                        [int][Microsoft.CodeAnalysis.CSharp.SyntaxKind]::StringLiteralExpression
                })) {
            $ancestors = @($literal.Ancestors())
            if (@($ancestors | Where-Object {
                        $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.AttributeSyntax]
                    }).Count -gt 0) {
                continue
            }
            $constant = @($ancestors | Where-Object {
                ($_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.FieldDeclarationSyntax] -or
                    $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.LocalDeclarationStatementSyntax]) -and
                'const' -cin @($_.Modifiers | ForEach-Object { $_.Text })
            })
            if ([bool]$scan.Target) {
                if ($constant.Count -eq 0) {
                    $value = [string]$literal.Token.ValueText
                    if (-not $targetCounts.ContainsKey($value)) { $targetCounts[$value] = 0 }
                    $targetCounts[$value]++
                }
                continue
            }
            $type = @($ancestors | Where-Object {
                    $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]
                } | Select-Object -First 1)
            if ($type.Count -ne 1) {
                continue
            }
            $names = @($ancestors | Where-Object {
                    $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax] -or
                    $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.BaseNamespaceDeclarationSyntax]
                } | ForEach-Object {
                    if ($_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]) {
                        $_.Identifier.ValueText + '`' + $_.Arity
                    } else { $_.Name.ToString() }
                })
            [array]::Reverse($names)
            if ($constant.Count -gt 0) {
                $field = $constant[0]
                $variable = @($ancestors | Where-Object {
                    $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.VariableDeclaratorSyntax]
                } | Select-Object -First 1)
                if ($field -is [Microsoft.CodeAnalysis.CSharp.Syntax.FieldDeclarationSyntax] -and
                    $field.Declaration.Type.ToString() -cin @('string','System.String') -and
                    $variable.Count -eq 1 -and $null -ne $variable[0].Initializer -and
                    $variable[0].Initializer.Value -eq $literal -and
                    -not $conditional -and @($ancestors | Where-Object {
                        $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax] -and $_.Arity -gt 0
                    }).Count -eq 0) {
                    $visibility = @($field.Modifiers | ForEach-Object { $_.Text })
                    $constantNames = @($names | ForEach-Object { $_ -replace '`0$', '' })
                    $constants.Add([pscustomobject]@{
                        Value=[string]$literal.Token.ValueText
                        Symbol=($names -join '.')
                        Name=($constantNames -join '.') + '.' + $variable[0].Identifier.ValueText
                        Project=$project
                        Shared=(('public' -cin $visibility -or 'internal' -cin $visibility) -and
                            @($type[0].Ancestors() | Where-Object {
                                $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]
                            }).Count -eq 0)
                    })
                }
                continue
            }
            $line = Get-ContextualNodeLine $literal
            $use = [pscustomobject]@{
                Path = $filePath
                Line = $line
                Column = $literal.GetLocation().GetLineSpan().StartLinePosition.Character + 1
                EndLine = $literal.GetLocation().GetLineSpan().EndLinePosition.Line + 1
                Symbol = $names -join '.'
                Value = [string]$literal.Token.ValueText
                Project = $project
                Unsupported = $conditional -or (
                    [string]$literal.Token.Text -match '^"{3,}' -and
                    ([string]$project.State -cne 'complete' -or -not $project.RawStringsSupported))
                Current = $current
                Changed = Test-ContextualChangedLine -Line $line -Spans $fileSpans
            }
            [void]$uses.Add($use)
            if (-not $byValue.ContainsKey($use.Value)) {
                $byValue[$use.Value] = [Collections.Generic.List[object]]::new()
            }
            [void]$byValue[$use.Value].Add($use)
        }
        }
    }
    $outcomes = [Collections.Generic.List[object]]::new()
    $values = [string[]]@($byValue.Keys)
    [array]::Sort($values, [StringComparer]::Ordinal)
    foreach ($value in $values) {
        $peers = @($byValue[$value] | Sort-Object Path, Line, Column -CaseSensitive)
        $changed = @($peers | Where-Object { $_.Current -and $_.Changed })
        if ($changed.Count -eq 0) { continue }
        if ($peers.Count -lt 2) {
            if ($incompletePeer) {
                $outcomes.Add((New-ContextualOutcome -RuleId $ruleId -State unknown `
                    -Reason reused-string-scope-unproven -Path $Path))
            }
            continue
        }
        if ($baselineUnknown -or @($peers | Where-Object {
            $_.Unsupported -or [string]$_.Project.State -cne 'complete'
        }).Count -gt 0) {
            $outcomes.Add((New-ContextualOutcome -RuleId $ruleId -State unknown `
                -Reason reused-string-baseline-unproven -Path $Path))
            continue
        }
        $priorCount = if ($targetCounts.ContainsKey($value)) { $targetCounts[$value] } else { 0 }
        if ($peers.Count -le $priorCount) { continue }
        $leader = @($peers | Where-Object Changed | Sort-Object Path, Line, Column -CaseSensitive)[0]
        if ([string]$leader.Path -ine $Path) { continue }
        $ordered = @($changed | Where-Object {
            [StringComparer]::Ordinal.Equals([string]$_.Symbol, [string]$leader.Symbol)
        } | Sort-Object Line, Column)
        if ($peers.Count -gt 1024) {
            $outcomes.Add((New-ContextualOutcome -RuleId $ruleId -State unknown `
                -Reason reused-string-evidence-cap-exhausted -Path $Path))
            continue
        }
            $projects = @($peers.Project.Path | Sort-Object -Unique)
            $types = [Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
            foreach ($peer in $peers) {
                [void]$types.Add($peer.Symbol)
            }
            $placement = if ($projects.Count -gt 1) {
                'Use public const string in a shared Constants class in the lowest common project dependency; the exact dependency is not proven here.'
            } elseif ($types.Count -gt 1) {
                'Use public const string in a common Constants class for the project.'
            } else {
                'Use private const string atop the class.'
            }
            $existing = @($constants | Where-Object {
                [StringComparer]::Ordinal.Equals([string]$_.Value, $value) -and
                [string]$_.Project.State -ceq 'complete' -and
                $projects.Count -eq 1 -and [string]$_.Project.Path -ieq $projects[0] -and
                [string]$_.Project.Digest -ceq [string]$leader.Project.Digest -and
                ($_.Shared -or ($types.Count -eq 1 -and
                    [StringComparer]::Ordinal.Equals([string]$_.Symbol, [string]$leader.Symbol)))
            })
            $escaped = ConvertTo-Json -InputObject $value -Compress
            $display = if ($escaped.Length -le 64) { $escaped } else { $escaped.Substring(0,61) + '...' }
            $advice = if ($existing.Count -eq 1) {
                "Reuse $($existing[0].Name) for $display instead of declaring another constant."
            } elseif ($existing.Count -gt 1) {
                "Reuse an existing accessible constant for $display; do not declare another."
            } else {
                "Declare constants for reused string $display. $placement Reuse an existing accessible constant instead of duplicating its declaration."
            }
            $outcome = New-ContextualOutcome -RuleId $ruleId -State violation `
                -Reason reused-string-requires-constant -Path $Path `
                -Line $ordered[0].Line -EndLine ([int]($ordered.EndLine | Measure-Object -Maximum).Maximum) `
                -Symbol ([string]$leader.Symbol) -Evidence $advice
            $outcome['literalValues'] = @($value)
            $outcome['occurrenceCounts'] = [ordered]@{source=$peers.Count;target=$priorCount}
            $outcome['relatedUses'] = @($peers | ForEach-Object {
                    [ordered]@{
                        path = $_.Path
                        line = $_.Line
                        column = $_.Column
                        endLine = $_.EndLine
                        symbol = $_.Symbol
                        value = $_.Value
                    }
                })
            [void]$outcomes.Add($outcome)
    }
    if ($outcomes.Count -eq 0) {
        if ($conditionalCurrent) {
            return New-ContextualOutcome -RuleId $ruleId -State unknown `
                -Reason reused-string-scope-unproven -Path $Path
        }
        return New-ContextualOutcome -RuleId $ruleId -State compliant `
            -Reason no-changed-reused-string -Path $Path
    }
    return $outcomes.ToArray()
}

function Get-ContextualRoslynOutcomes {
    param(
        [Parameter(Mandatory)][string]$Content,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][object[]]$Spans,
        [Parameter(Mandatory)][object[]]$SnapshotFiles
    )
    $tree = [
        Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree]::
        ParseText($Content)
    $root = $tree.GetRoot()
    $reusedStringOutcomes = @(Get-ContextualReusedStringOutcomes `
            -Root $root -Path $Path -Spans $Spans -SnapshotFiles $SnapshotFiles)
    $parseErrors = @($tree.GetDiagnostics() |
        Where-Object {
            $_.Severity -eq [
                Microsoft.CodeAnalysis.DiagnosticSeverity]::Error
        })
    $contextualCandidateOutcomes =
        [Collections.Generic.List[object]]::new()
    $results = [ordered]@{}
    foreach ($rule in $script:RuleIds) {
        $results[$rule] = New-ContextualOutcome `
            -RuleId $rule -State compliant `
            -Reason no-applicable-violation `
            -Path $Path
    }
    $coverageOutcomes = @(
        Get-ContextualCoverageOutcomes `
            -Root $root -Path $Path -Spans $Spans `
            -SnapshotFiles $SnapshotFiles)
    $indentationOutcome =
        Get-ContextualBlockIndentationOutcome `
            -Root $root -Content $Content `
            -Path $Path -Spans $Spans
    $results['block-body-indentation'] =
        $indentationOutcome
    if ([string]$indentationOutcome.state -ceq 'violation') {
        [void]$contextualCandidateOutcomes.Add(
            $indentationOutcome)
    }
    $exceptionNamingOutcomes = @(
        Get-ContextualExceptionNamingOutcomes `
            -Root $root -Content $Content -Path $Path -Spans $Spans `
            -SnapshotFiles $SnapshotFiles)
    if ($exceptionNamingOutcomes.Count -eq 0) {
        $exceptionNamingOutcomes = @(
            New-ContextualOutcome -RuleId generic-exception-naming `
                -State compliant -Reason no-applicable-violation -Path $Path)
    }
    $xmlSummaryOutcome =
        Get-ContextualXmlSummaryLayoutOutcome `
            -Root $root -Content $Content `
            -Path $Path -Spans $Spans
    $results['xml-summary-layout'] =
        $xmlSummaryOutcome
    if ([string]$xmlSummaryOutcome.state -ceq
        'violation') {
        [void]$contextualCandidateOutcomes.Add(
            $xmlSummaryOutcome)
    }
    $duplicateConstantOutcome =
        Get-ContextualDuplicateConstantOutcome `
            -Root $root -Content $Content `
            -Path $Path -Spans $Spans `
            -SnapshotFiles $SnapshotFiles
    $results['duplicate-constant-declarations'] =
        $duplicateConstantOutcome
    if ([string]$duplicateConstantOutcome.state -ceq
        'violation') {
        [void]$contextualCandidateOutcomes.Add(
            $duplicateConstantOutcome)
    }
    $nodes = @($root.DescendantNodes())
    $methods = @($nodes | Where-Object {
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.MethodDeclarationSyntax]
        })
    $catches = @($nodes | Where-Object {
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.CatchClauseSyntax]
        })
    $namedCallLanguage =
        Get-ContextualNamedCallLanguageState `
            -Path $Path `
            -SnapshotFiles $SnapshotFiles
    $namedCallSignatures =
        @(Get-ContextualNamedCallSignatures `
            -Root $root -Path $Path `
            -SnapshotFiles $SnapshotFiles)
    $namedCallConstants =
        @(Get-ContextualNamedCallConstants `
            -Root $root -Path $Path `
            -SnapshotFiles $SnapshotFiles)
    $callNodes = @(
        $nodes | Where-Object {
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax] -or
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.ObjectCreationExpressionSyntax] -or
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.ConstructorInitializerSyntax]
        })
    $namedCallBinding = if (@($callNodes | Where-Object {
                $_ -is [Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax] -and
                (($_.Expression -is [Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax] -and
                    $_.Expression.Name.Identifier.ValueText -ceq 'Equals') -or
                ($_.Expression -is [Microsoft.CodeAnalysis.CSharp.Syntax.SimpleNameSyntax] -and
                    $_.Expression.Identifier.ValueText -ceq 'Equals'))
            }).Count -gt 0) {
        Get-ContextualNamedCallBinding -Root $root -Path $Path -SnapshotFiles $SnapshotFiles
    }
    else { $null }
    foreach ($call in $callNodes) {
        $outcome = Get-ContextualNamedCallOutcome `
            -Node $call -Root $root `
            -Path $Path -Spans $Spans `
            -Signatures $namedCallSignatures `
            -Language $namedCallLanguage `
            -Constants $namedCallConstants -Binding $namedCallBinding
        if ($null -eq $outcome) {
            continue
        }
        if ([string]$outcome.state -ceq 'violation') {
            [void]$contextualCandidateOutcomes.Add(
                $outcome)
            $results['named-call-arguments'] =
                $outcome
        }
        elseif ([string]$results[
                'named-call-arguments'].state -ceq
                'compliant') {
            $results['named-call-arguments'] =
                $outcome
        }
    }

    foreach ($catch in $catches) {
        if ($null -eq $catch.Declaration -or
            -not (Test-ContextualNodeChanged `
                -Node $catch -Spans $Spans)) {
            continue
        }
        $variable = [string]$catch.Declaration.
            Identifier.ValueText
        $logs = @($catch.Block.DescendantNodes() |
            Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax] -and
                [string]$_.Expression.ToString() -match
                    '(?:Logger\.(?:Error|Critical)|\.LogError)$'
            })
        $throws = @($catch.Block.DescendantNodes() |
            Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.ThrowStatementSyntax]
            })
        foreach ($log in $logs) {
            $arguments = @($log.ArgumentList.Arguments)
            $includesException = @($arguments |
                Where-Object {
                    [string]$_.Expression.ToString() -ceq
                        $variable
                }).Count -gt 0
            $messageOnly = @($arguments |
                Where-Object {
                    [string]$_.Expression.ToString() -ceq
                        "$variable.Message"
                }).Count -gt 0
            if (($messageOnly -and
                    -not $includesException) -or
                $throws.Count -gt 0) {
                $results['exception-logging'] =
                    New-ContextualOutcome `
                        -RuleId exception-logging `
                        -State violation `
                        -Reason $(if ($throws.Count) {
                            'log-and-rethrow'
                        }
                        else {
                            'exception-object-not-logged'
                        }) `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $log) `
                        -EndLine (Get-ContextualNodeLine $log) `
                        -Symbol (
                            [string]$catch.Declaration.Type) `
                        -Evidence (
                            'Log the exception exactly once and ' +
                            'pass the caught exception object.')
                break
            }
        }
        foreach ($throw in $throws) {
            if ($null -ne $throw.Expression -and
                [string]$throw.Expression.ToString() -ceq
                    $variable) {
                $results['exception-propagation'] =
                    New-ContextualOutcome `
                        -RuleId exception-propagation `
                        -State violation `
                        -Reason throw-expression-resets-stack `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $throw) `
                        -EndLine (Get-ContextualNodeLine $throw) `
                        -Symbol $variable `
                        -Evidence (
                            'Use a bare throw to preserve the stack.')
            }
        }
        $generic = [string]$catch.Declaration.Type -in @(
            'Exception', 'System.Exception')
        $filterText = if ($null -ne $catch.Filter) {
            [string]$catch.Filter.FilterExpression.ToString()
        }
        else { '' }
        $hasFilter = -not [string]::IsNullOrWhiteSpace($filterText)
        $fatalFiltered = $hasFilter -and
            $filterText -match '!\s*\w+\.IsFatal\s*\('
        $onlyThrow = $catch.Block.Statements.Count -eq 1 -and
            $catch.Block.Statements[0] -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.ThrowStatementSyntax] -and
            $null -eq $catch.Block.Statements[0].Expression
        if ($generic -and $hasFilter -and -not $fatalFiltered -and
            -not $onlyThrow) {
            $results['exception-propagation'] =
                New-ContextualOutcome `
                    -RuleId exception-propagation `
                    -State unknown `
                    -Reason typed-filter-fatal-semantics-unproven `
                    -Path $Path `
                    -Line (Get-ContextualNodeLine $catch) `
                    -EndLine (Get-ContextualNodeLine $catch) `
                    -Symbol $variable
        }
        elseif ($generic -and -not $hasFilter -and
            -not $onlyThrow) {
            $results['exception-propagation'] =
                New-ContextualOutcome `
                    -RuleId exception-propagation `
                    -State violation `
                    -Reason fatal-exception-filter-missing `
                    -Path $Path `
                    -Line (Get-ContextualNodeLine $catch) `
                    -EndLine (Get-ContextualNodeLine $catch) `
                    -Symbol $variable `
                    -Evidence (
                        'Let fatal exceptions escape through ' +
                        'the repository IsFatal catch filter.')
        }
        foreach ($decision in @(
                $catch.Block.DescendantNodes() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.IfStatementSyntax] -or
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.SwitchStatementSyntax]
                    })) {
            $condition = if ($decision -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.IfStatementSyntax]) {
                $decision.Condition
            }
            else {
                $decision.Expression
            }
            if ([string]$condition.ToString() -match
                "\b$([regex]::Escape($variable))\.(?:Message|StackTrace)\b") {
                $results['type-based-decisions'] =
                    New-ContextualOutcome `
                        -RuleId type-based-decisions `
                        -State violation `
                        -Reason exception-text-controls-behavior `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $condition) `
                        -EndLine (Get-ContextualNodeLine $condition) `
                        -Symbol $variable `
                        -Evidence (
                            'Use exception types or typed status ' +
                            'codes for behavior decisions.')
                break
            }
        }
    }

    foreach ($method in $methods) {
        $typeMap =
            Get-ContextualMethodTypeMap -Method $method
        $methodChanged = Test-ContextualNodeChanged `
            -Node $method -Spans $Spans
        if (-not $methodChanged) {
            continue
        }
        foreach ($binary in @(
                $method.DescendantNodes() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.BinaryExpressionSyntax] -and
                        [string]$_.OperatorToken.Text -in @(
                            '==', '!=')
                    })) {
            $left = [string]$binary.Left.ToString()
            $right = [string]$binary.Right.ToString()
            if ($left -ceq 'null' -or $right -ceq 'null') {
                continue
            }
            $leftString = $typeMap.Contains($left) -and
                [string]$typeMap[$left] -ceq 'string'
            $rightString = $typeMap.Contains($right) -and
                [string]$typeMap[$right] -ceq 'string'
            if ($leftString -or $rightString) {
                $results['explicit-string-comparison'] =
                    New-ContextualOutcome `
                        -RuleId explicit-string-comparison `
                        -State violation `
                        -Reason string-comparison-not-explicit `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $binary) `
                        -EndLine (Get-ContextualNodeLine $binary) `
                        -Symbol (
                            [string]$method.Identifier.ValueText) `
                        -Evidence (
                            'Use explicit StringComparison semantics.')
                break
            }
        }
        $exceptionParameters = @(
            $method.ParameterList.Parameters |
                Where-Object {
                    [string]$_.Type.ToString() -match
                        '(?:^|\.)Exception$'
                } |
                ForEach-Object {
                    [string]$_.Identifier.ValueText
                })
        foreach ($parameter in $exceptionParameters) {
            $textDecisions = @(
                $method.DescendantNodes() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.IfStatementSyntax] -and
                        [string]$_.Condition.ToString() -match
                            "\b$([regex]::Escape($parameter))\.(?:Message|StackTrace)\b"
                    })
            if ($textDecisions.Count -gt 0) {
                $results['type-based-decisions'] =
                    New-ContextualOutcome `
                        -RuleId type-based-decisions `
                        -State violation `
                        -Reason exception-text-controls-behavior `
                        -Path $Path `
                        -Line (
                            Get-ContextualNodeLine `
                                $textDecisions[0]) `
                        -EndLine (
                            Get-ContextualNodeLine `
                                $textDecisions[0]) `
                        -Symbol $parameter `
                        -Evidence (
                            'Use exception types or typed status ' +
                            'codes for behavior decisions.')
            }
        }
        foreach ($first in @(
                $method.DescendantNodes() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax] -and
                        [string]$_.Expression.ToString() -match
                            '\.First(?:OrDefault)?$'
                    })) {
            $predicateSelection = $first.ArgumentList.Arguments.Count -gt 0

            $receiver = if ($first.Expression -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax]) {
                [string]$first.Expression.Expression.ToString()
            }
            else {
                ''
            }
            if ([string]::IsNullOrWhiteSpace(
                    $receiver)) {
                continue
            }
            $offset = [Math]::Max(
                0,
                $first.SpanStart -
                $method.SpanStart)
            $priorText = [string]$method.ToString().
                Substring(
                    0,
                    [Math]::Min(
                        $method.ToString().Length,
                        $offset))
            $normalizedReceiver = $receiver.Replace('?.', '.')
            $normalizedMethodText = ([string]$method.ToString()).Replace('?.', '.')
            $predicateUniquenessProof = $predicateSelection -and
                $normalizedMethodText -match (
                    [regex]::Escape($normalizedReceiver) +
                    '(?:\.Values)?\.Single(?:OrDefault)?(?:<[^>]+>)?\s*\(')
            if ($predicateSelection -and -not $predicateUniquenessProof) {
                if (Test-ContextualNodeChanged -Node $first -Spans $Spans) {
                    $results['collection-cardinality'] =
                        New-ContextualOutcome `
                            -RuleId collection-cardinality `
                            -State unknown `
                            -Reason predicate-selection-cardinality-unproven `
                            -Path $Path `
                            -Line (Get-ContextualNodeLine $first) `
                            -EndLine (Get-ContextualNodeLine $first) `
                            -Symbol ([string]$method.Identifier.ValueText)
                }
                continue
            }
            if (-not $predicateSelection -and
                (Test-ContextualEquivalentGroupRepresentativeSelection `
                    -Invocation $first -Method $method)) {
                if (Test-ContextualNodeChanged -Node $first -Spans $Spans) {
                    $results['collection-cardinality'] =
                        New-ContextualOutcome `
                            -RuleId collection-cardinality `
                            -State compliant `
                            -Reason equivalent-group-representative-dedup `
                            -Path $Path `
                            -Line (Get-ContextualNodeLine $first) `
                            -EndLine (Get-ContextualNodeLine $first) `
                            -Symbol ([string]$method.Identifier.ValueText)
                }
                continue
            }
            if (-not $predicateSelection -and
                (Test-ContextualGroupRepresentativeSelection `
                    -Invocation $first)) {
                if (Test-ContextualNodeChanged -Node $first -Spans $Spans) {
                    $results['collection-cardinality'] =
                        New-ContextualOutcome `
                            -RuleId collection-cardinality `
                            -State unknown `
                            -Reason group-representative-equivalence-unproven `
                            -Path $Path `
                            -Line (Get-ContextualNodeLine $first) `
                            -EndLine (Get-ContextualNodeLine $first) `
                            -Symbol ([string]$method.Identifier.ValueText)
                }
                continue
            }
            $orderedSelection = $receiver -match
                '\.(?:OrderBy|OrderByDescending|ThenBy|ThenByDescending)\s*\(' -or
                $receiver -match '\.Split\s*\(' -or
                $receiver -match '\.Statements$'
            if (-not $orderedSelection -and $receiver -match '^[A-Za-z_][A-Za-z0-9_]*$') {
                $orderedSelection = @(
                    $method.DescendantNodes() |
                        Where-Object {
                            $_ -is [
                                Microsoft.CodeAnalysis.CSharp.Syntax.VariableDeclaratorSyntax] -and
                            [string]$_.Identifier.ValueText -ceq $receiver -and
                            $_.SpanStart -lt $first.SpanStart -and
                            $null -ne $_.Initializer -and
                            [string]$_.Initializer.Value.ToString() -match
                                '\.(?:OrderBy|OrderByDescending|ThenBy|ThenByDescending)\s*\('
                        }).Count -gt 0
            }
            $validated = $priorText -match (
                "\b$([regex]::Escape($receiver))\." +
                '(?:Count\s*(?:\(\s*\))?\s*(?:==|!=)\s*1|' +
                'Single\s*\()')
            $positionalContractUnproven =
                $receiver -match '(?i)(?:Headers\.GetValues|HeaderValues|\.GetValues\s*\()' -or
                $receiver -match '\.OfType\s*<' -or
                $receiver -match '(?:^|\.)Triggers$' -or
                $priorText -match (
                    [regex]::Escape($receiver) + '\.Any\s*\(')
            if (-not $validated -and -not $orderedSelection -and
                $positionalContractUnproven) {
                if (Test-ContextualNodeChanged -Node $first -Spans $Spans) {
                    $results['collection-cardinality'] =
                        New-ContextualOutcome `
                            -RuleId collection-cardinality `
                            -State unknown `
                            -Reason positional-selection-cardinality-unproven `
                            -Path $Path `
                            -Line (Get-ContextualNodeLine $first) `
                            -EndLine (Get-ContextualNodeLine $first) `
                            -Symbol ([string]$method.Identifier.ValueText)
                }
                continue
            }
            if (-not $validated -and -not $orderedSelection) {
                $results['collection-cardinality'] =
                    New-ContextualOutcome `
                        -RuleId collection-cardinality `
                        -State violation `
                        -Reason arbitrary-first-selection `
                        -Path $Path `
                        -Line (
                            Get-ContextualNodeLine $first) `
                        -EndLine (
                            Get-ContextualNodeLine $first) `
                        -Symbol (
                            [string]$method.Identifier.ValueText) `
                        -Evidence (
                            'Validate cardinality before selecting an item.')
            }
        }
        foreach ($member in @(
                $method.DescendantNodes() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax] -and
                        [string]$_.Name.Identifier.ValueText -ceq
                            'Result'
                    })) {
            $receiverType = Get-ContextualReceiverType `
                -Expression $member.Expression `
                -Method $method
            if ($receiverType -match
                    '^(?:System\.)?Threading\.Tasks\.Task' -or
                [string]$member.Expression.ToString() -match
                    'Async\s*\(\s*\)$') {
                $results['async-all-the-way'] =
                    New-ContextualOutcome `
                        -RuleId async-all-the-way `
                        -State violation `
                        -Reason task-result-blocking `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $member) `
                        -EndLine (Get-ContextualNodeLine $member) `
                        -Symbol (
                            [string]$method.Identifier.ValueText) `
                        -Evidence (
                            'Await the Task instead of blocking on Result.')
            }
        }
        $invocations = @(
            $method.DescendantNodes() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax]
                })
        foreach ($invocation in $invocations) {
            $expression =
                [string]$invocation.Expression.ToString()
            if ($expression -match
                '^(?:(?:System\.)?IO\.)?File\.(?:ReadAllText|ReadAllBytes|WriteAllText|WriteAllBytes)$') {
                if (Test-ContextualSynchronousAssertionCallback `
                    -Invocation $invocation -Method $method) {
                    if (Test-ContextualNodeChanged `
                        -Node $invocation -Spans $Spans) {
                        $results['async-io'] =
                            New-ContextualOutcome `
                                -RuleId async-io -State unknown `
                                -Reason assertion-callback-io-context-unproven `
                                -Path $Path `
                                -Line (Get-ContextualNodeLine $invocation) `
                                -EndLine (Get-ContextualNodeLine $invocation) `
                                -Symbol (
                                    [string]$method.Identifier.ValueText)
                    }
                    continue
                }
                $results['async-io'] =
                    New-ContextualOutcome `
                        -RuleId async-io -State violation `
                        -Reason synchronous-io-in-async-method `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $invocation) `
                        -EndLine (Get-ContextualNodeLine $invocation) `
                        -Symbol (
                            [string]$method.Identifier.ValueText) `
                        -Evidence 'Use the supported asynchronous I/O API.'
            }
            if ($expression -match
                '^(?:System\.Threading\.)?Thread\.Sleep$' -or
                $expression -match '\.WaitOne$') {
                if ($method.Modifiers.ToString() -match '\basync\b') {
                    $results['async-wait-sync'] =
                        New-ContextualOutcome `
                            -RuleId async-wait-sync `
                            -State violation `
                            -Reason blocking-wait-in-async-context `
                            -Path $Path `
                            -Line (Get-ContextualNodeLine $invocation) `
                            -EndLine (Get-ContextualNodeLine $invocation) `
                            -Symbol (
                                [string]$method.Identifier.ValueText) `
                            -Evidence (
                                'Use an async-compatible wait with cancellation.')
                }
            }
        }
        foreach ($lambda in @(
                $method.DescendantNodes() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.AnonymousFunctionExpressionSyntax]
                    })) {
            $validationCallback = $false
            $argument = @($lambda.AncestorsAndSelf() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.ArgumentSyntax]
                } | Select-Object -First 1)
            if ($argument.Count -eq 1) {
                $argumentName = if ($null -ne $argument[0].NameColon) {
                    [string]$argument[0].NameColon.Name.Identifier.ValueText
                }
                else { '' }
                $invocation = @($argument[0].Ancestors() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax]
                    } | Select-Object -First 1)
                $invocationName = if ($invocation.Count -eq 1) {
                    [string]$invocation[0].Expression.ToString()
                }
                else { '' }
                $validationCallback = $argumentName -match
                    '(?i)^(?:validator|validation(?:Delegate|Callback)?)$' -or
                    $invocationName -match
                    '(?i)(?:^|\.)(?:Validate|ValidateAsync|RegisterValidation|SetValidator)$'
            }
            if (-not $validationCallback) {
                $declarator = @($lambda.AncestorsAndSelf() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.VariableDeclaratorSyntax]
                    } | Select-Object -First 1)
                $validationCallback = $declarator.Count -eq 1 -and
                    [string]$declarator[0].Identifier.ValueText -match
                        '(?i)validat'
            }
            if (-not $validationCallback) {
                continue
            }
            $lambdaInvocations = @(
                $lambda.DescendantNodes() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.InvocationExpressionSyntax]
                    })
            $expensive = @($lambdaInvocations |
                Where-Object {
                    [string]$_.Expression.ToString() -match
                        '(?:Async|^(?:System\.)?IO\.File\.|HttpClient|Database|Repository\.)'
                }).Count -gt 0 -or
                @($lambda.DescendantNodes() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.AwaitExpressionSyntax]
                    }).Count -gt 0
            $results['cheap-validation'] =
                New-ContextualOutcome `
                    -RuleId cheap-validation `
                    -State $(if ($expensive) {
                        'violation'
                    } else { 'compliant' }) `
                    -Reason $(if ($expensive) {
                        'validation-delegate-does-io-or-heavy-work'
                    } else {
                        'validation-delegate-is-in-memory'
                    }) `
                    -Path $Path `
                    -Line (Get-ContextualNodeLine $lambda) `
                    -EndLine (Get-ContextualNodeLine $lambda) `
                    -Symbol (
                        [string]$method.Identifier.ValueText) `
                    -Evidence $(if ($expensive) {
                        'Keep request validation delegates cheap.'
                    } else { '' })
        }
        $jObjectParameters = @($method.ParameterList.
            Parameters | Where-Object {
                [string]$_.Type.ToString() -in @(
                    'JObject',
                    'Newtonsoft.Json.Linq.JObject')
            } | ForEach-Object {
                [string]$_.Identifier.ValueText
            })
        foreach ($name in $jObjectParameters) {
            $accesses = @($method.DescendantNodes() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.ElementAccessExpressionSyntax] -and
                    [string]$_.Expression.ToString() -ceq
                        $name -and
                    $_.ArgumentList.Arguments.Count -eq 1 -and
                    $_.ArgumentList.Arguments[
                        0].Expression -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.LiteralExpressionSyntax]
                })
            if ($accesses.Count -ge 2 -and
                [string]$method.Identifier.ValueText -notmatch
                    '(?i)dynamic|extension') {
                $results['typed-contracts'] =
                    New-ContextualOutcome `
                        -RuleId typed-contracts `
                        -State violation `
                        -Reason fixed-contract-accessed-by-json-keys `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $accesses[0]) `
                        -EndLine (Get-ContextualNodeLine $accesses[0]) `
                        -Symbol (
                            [string]$method.Identifier.ValueText) `
                        -Evidence (
                            'Use a typed contract for the proven fixed JSON shape.')
            }
        }
        $reflection = @($invocations |
            Where-Object {
                if ($_.Expression -isnot [
                    Microsoft.CodeAnalysis.CSharp.Syntax.MemberAccessExpressionSyntax]) {
                    return $false
                }
                if ([string]$_.Expression.Name.
                    Identifier.ValueText -notmatch
                    '^Get(?:Method|Methods|Property|Properties|CustomAttributes)$') {
                    return $false
                }
                $receiver = $_.Expression.Expression
                if ($receiver -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.TypeOfExpressionSyntax]) {
                    return $true
                }
                return (Get-ContextualReceiverType `
                        -Expression $receiver `
                        -Method $method) -in @(
                            'Type',
                            'System.Type')
            })
        if ($reflection.Count -gt 1) {
            $results['cache-streaming'] =
                New-ContextualOutcome `
                    -RuleId cache-streaming `
                    -State violation `
                    -Reason repeated-reflection-not-cached `
                    -Path $Path `
                    -Line (Get-ContextualNodeLine $reflection[0]) `
                    -EndLine (Get-ContextualNodeLine $reflection[0]) `
                    -Symbol (
                        [string]$method.Identifier.ValueText) `
                    -Evidence 'Cache repeated reflection lookup results.'
        }
        $buffer = @($invocations | Where-Object {
                [string]$_.Expression.ToString() -match
                    '\.(?:ReadAsByteArrayAsync|ReadAsStringAsync|ReadToEndAsync)$'
            } | Select-Object -First 1)
        if ($buffer.Count -eq 1) {
            $bufferStatement = @($buffer[0].Ancestors() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.StatementSyntax]
                } | Select-Object -First 1)
            $priorLargeGuard = @($method.DescendantNodes() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.IfStatementSyntax] -and
                    $_.SpanStart -lt $buffer[0].SpanStart -and
                    [string]$_.Condition.ToString() -match
                        '(?i)(?:ContentLength|Length)\s*(?:>|>=)\s*(?:1048576|1_048_576|[2-9][0-9]{6,})'
                } | Select-Object -Last 1)
            $guardTerminates = $priorLargeGuard.Count -eq 1 -and
                @($priorLargeGuard[0].Statement.
                    DescendantNodesAndSelf() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.ThrowStatementSyntax] -or
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.ReturnStatementSyntax]
                    }).Count -gt 0
            if ($priorLargeGuard.Count -eq 1 -and
                -not $guardTerminates) {
                $results['cache-streaming'] =
                    New-ContextualOutcome `
                        -RuleId cache-streaming `
                        -State violation `
                        -Reason proven-large-payload-fully-buffered `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $buffer[0]) `
                        -EndLine (Get-ContextualNodeLine $buffer[0]) `
                        -Symbol (
                            [string]$method.Identifier.ValueText) `
                        -Evidence (
                            'Stream the payload proven to exceed the large bound.')
            }
        }
    }

    $localHttpClient = @($nodes | Where-Object {
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax] -and
            [string]$_.Identifier.ValueText -ceq
                'HttpClient'
        }).Count -gt 0
    $getHttpUsingContext = {
        param([Parameter(Mandatory)]$Node)
        $applicable = [Collections.Generic.List[object]]::new()
        foreach ($using in @($root.Usings)) {
            [void]$applicable.Add($using)
        }
        foreach ($namespace in @($Node.Ancestors() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.BaseNamespaceDeclarationSyntax]
                })) {
            foreach ($using in @($namespace.Usings)) {
                [void]$applicable.Add($using)
            }
        }
        $aliases = @{}
        foreach ($using in @($applicable |
                Where-Object {
                    $null -ne $_.Alias
                })) {
            $aliases[
                [string]$using.Alias.Name.Identifier.ValueText
            ] = ([string]$using.Name.ToString()) -replace
                '^global::', ''
        }
        return [ordered]@{
            usingSystemHttp = @($applicable |
                Where-Object {
                    $null -eq $_.Alias -and
                    (([string]$_.Name.ToString()) -replace
                        '^global::', '') -ceq
                        'System.Net.Http'
                }).Count -gt 0
            aliases = $aliases
        }
    }.GetNewClosure()
    $resolveHttpClientType = {
        param(
            [Parameter(Mandatory)][string]$TypeText,
            [Parameter(Mandatory)]$Node
        )
        $normalized = $TypeText -replace '^global::', ''
        $usingContext =
            & $getHttpUsingContext $Node
        if ($normalized -ceq
            'System.Net.Http.HttpClient') {
            return 'system'
        }
        if ($usingContext.aliases.ContainsKey(
                $normalized)) {
            return $(if (
                [string]$usingContext.aliases[
                    $normalized] -ceq
                    'System.Net.Http.HttpClient'
            ) {
                'system'
            }
            else { 'unknown' })
        }
        if ($normalized -ceq 'HttpClient') {
            if ($localHttpClient) {
                return 'shadowed'
            }
            if ([bool]$usingContext.usingSystemHttp) {
                return 'system'
            }
            return 'unknown'
        }
        if ($normalized -match
            '(?:^|\.)HttpClient$') {
            return 'unknown'
        }
        return 'not-http-client'
    }.GetNewClosure()
    $getCreationType = {
        param([Parameter(Mandatory)]$Creation)
        if ($Creation -is [
            Microsoft.CodeAnalysis.CSharp.Syntax.ObjectCreationExpressionSyntax]) {
            return [string]$Creation.Type.ToString()
        }
        $declaration = @($Creation.Ancestors() |
            Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.VariableDeclarationSyntax]
            } | Select-Object -First 1)
        if ($declaration.Count -eq 1) {
            return [string]$declaration[0].Type.ToString()
        }
        return ''
    }.GetNewClosure()
    foreach ($creation in @($nodes | Where-Object {
                ($_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.ObjectCreationExpressionSyntax] -or
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.ImplicitObjectCreationExpressionSyntax]) -and
                (Test-ContextualNodeChanged `
                    -Node $_ -Spans $Spans)
            })) {
        $fullType =
            & $getCreationType $creation
        if ([string]::IsNullOrWhiteSpace(
                $fullType)) {
            continue
        }
        $httpMethod = @($creation.Ancestors() |
            Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.MethodDeclarationSyntax]
            } | Select-Object -First 1)
        $httpConstructor = @($creation.Ancestors() |
            Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.ConstructorDeclarationSyntax]
            } | Select-Object -First 1)
        $httpSymbol = if ($httpMethod.Count -eq 1) {
            [string]$httpMethod[0].Identifier.ValueText
        }
        elseif ($httpConstructor.Count -eq 1) {
            [string]$httpConstructor[0].Identifier.ValueText
        }
        else { 'file' }
        $typeState =
            & $resolveHttpClientType $fullType $creation
        if ($typeState -ceq
            'not-http-client') {
            continue
        }
        if ($typeState -ceq 'shadowed') {
            $results['http-client-lifetime'] =
                New-ContextualOutcome `
                    -RuleId http-client-lifetime `
                    -State unknown `
                    -Reason http-client-type-shadowed `
                    -Path $Path `
                    -Line (Get-ContextualNodeLine $creation) `
                    -EndLine (Get-ContextualNodeLine $creation) `
                    -Symbol $httpSymbol
            continue
        }
        if ($typeState -cne 'system') {
            $results['http-client-lifetime'] =
                New-ContextualOutcome `
                    -RuleId http-client-lifetime `
                    -State unknown `
                    -Reason http-client-type-unproven `
                    -Path $Path `
                    -Line (Get-ContextualNodeLine $creation) `
                    -EndLine (Get-ContextualNodeLine $creation) `
                    -Symbol $httpSymbol
            continue
        }
        $field = @($creation.Ancestors() |
            Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.FieldDeclarationSyntax]
            } | Select-Object -First 1)
        $constructor = $httpConstructor
        $customHandler =
            $creation.ArgumentList.Arguments.Count -gt 0
        $sharedField = $field.Count -eq 1 -and
            [string]$field[0].Modifiers.ToString() -match
                '\bstatic\b' -and
            [string]$field[0].Modifiers.ToString() -match
                '\breadonly\b' -and
            (& $resolveHttpClientType (
                [string]$field[0].Declaration.Type.ToString()
            ) $field[0]) -ceq 'system'
        $staticConstructorAssignment = $false
        if ($constructor.Count -eq 1 -and
            [string]$constructor[0].Modifiers.ToString() -match
                '\bstatic\b') {
            $containingType = @(
                $constructor[0].Ancestors() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.TypeDeclarationSyntax]
                    } |
                    Select-Object -First 1)
            $sameTypeStaticReadonlyClients = if (
                $containingType.Count -eq 1
            ) {
                @($containingType[0].Members |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.FieldDeclarationSyntax] -and
                        [string]$_.Modifiers.ToString() -match
                            '\bstatic\b' -and
                        [string]$_.Modifiers.ToString() -match
                            '\breadonly\b' -and
                        (& $resolveHttpClientType (
                            [string]$_.Declaration.Type.ToString()
                        ) $_) -ceq 'system'
                    } | ForEach-Object {
                        $_.Declaration.Variables |
                            ForEach-Object {
                                [string]$_.Identifier.ValueText
                            }
                    })
            }
            else { @() }
            $assignment = @($creation.Ancestors() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.AssignmentExpressionSyntax]
                } | Select-Object -First 1)
            if ($assignment.Count -eq 1) {
                $target = ([string]$assignment[0].Left.ToString()).
                    Split('.')[-1]
                $staticConstructorAssignment =
                    $target -cin
                        $sameTypeStaticReadonlyClients
            }
        }
        if ($sharedField -or
            $staticConstructorAssignment) {
            $results['http-client-lifetime'] =
                New-ContextualOutcome `
                    -RuleId http-client-lifetime `
                    -State compliant `
                    -Reason shared-http-client-singleton `
                    -Path $Path `
                    -Line (Get-ContextualNodeLine $creation) `
                    -EndLine (Get-ContextualNodeLine $creation) `
                    -Symbol $httpSymbol
            continue
        }
        if ($customHandler) {
            $results['http-client-lifetime'] =
                New-ContextualOutcome `
                    -RuleId http-client-lifetime `
                    -State unknown `
                    -Reason custom-handler-lifetime-unproven `
                    -Path $Path `
                    -Line (Get-ContextualNodeLine $creation) `
                    -EndLine (Get-ContextualNodeLine $creation) `
                    -Symbol $httpSymbol
            continue
        }
        $results['http-client-lifetime'] =
            New-ContextualOutcome `
                -RuleId http-client-lifetime `
                -State violation `
                -Reason request-path-http-client-construction `
                -Path $Path `
                -Line (Get-ContextualNodeLine $creation) `
                -EndLine (Get-ContextualNodeLine $creation) `
                -Symbol $httpSymbol `
                -Evidence (
                    'Reuse System.Net.Http.HttpClient or use IHttpClientFactory.')
    }

    $staticFields = @($nodes | Where-Object {
            $_ -is [
                Microsoft.CodeAnalysis.CSharp.Syntax.FieldDeclarationSyntax] -and
            [string]$_.Modifiers.ToString() -match
                '\bstatic\b'
        } | ForEach-Object {
            $_.Declaration.Variables |
                ForEach-Object {
                    [string]$_.Identifier.ValueText
                }
        })
    foreach ($statement in @($nodes | Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.IfStatementSyntax] -and
                (Test-ContextualNodeChanged `
                    -Node $_ -Spans $Spans)
            })) {
        $condition = [string]$statement.Condition.ToString()
        foreach ($field in $staticFields) {
            if ($condition -notmatch (
                "\b$([regex]::Escape($field))\b\s*==\s*null")) {
                continue
            }
            $assigns = @($statement.Statement.
                DescendantNodesAndSelf() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.AssignmentExpressionSyntax] -and
                    [string]$_.Left.ToString() -match (
                        "(?:^|\.)$([regex]::Escape($field))$")
                }).Count -gt 0
            $synchronized = @($statement.Ancestors() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.LockStatementSyntax]
                }).Count -gt 0 -or
                [string]$statement.ToString() -match
                    '\bInterlocked\.'
            if ($assigns -and -not $synchronized) {
                $results['thread-safe-immutable'] =
                    New-ContextualOutcome `
                        -RuleId thread-safe-immutable `
                        -State violation `
                        -Reason unsynchronized-shared-initialization `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $statement) `
                        -EndLine (Get-ContextualNodeLine $statement) `
                        -Symbol $field `
                        -Evidence (
                            'Protect shared lazy initialization with Lazy<T>, Interlocked, or a lock.')
            }
        }
    }

    foreach ($type in @($nodes | Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.ClassDeclarationSyntax]
            })) {
        $typeText = [string]$type.AttributeLists.ToString()
        $properties = @($type.Members | Where-Object {
                $_ -is [
                    Microsoft.CodeAnalysis.CSharp.Syntax.PropertyDeclarationSyntax]
            })
        $serialized = $typeText -match
                'JsonObject|DataContract' -or
            @($properties | Where-Object {
                    [string]$_.AttributeLists.ToString() -match
                        'JsonProperty|JsonIgnore|JsonInclude|JsonPropertyName|DataMember|IgnoreDataMember'
                }).Count -gt 0
        $optIn = $typeText -match
            'JsonObject\s*\(\s*MemberSerialization\.OptIn'
        if (-not $serialized -or $optIn) {
            continue
        }
        foreach ($property in $properties) {
            if (-not (Test-ContextualNodeChanged `
                    -Node $property -Spans $Spans)) {
                continue
            }
            $attributes =
                [string]$property.AttributeLists.ToString()
            if ($attributes -notmatch
                'JsonProperty|JsonIgnore|JsonInclude|JsonPropertyName|DataMember|IgnoreDataMember') {
                $results['json-contracts'] =
                    New-ContextualOutcome `
                        -RuleId json-contracts `
                        -State violation `
                        -Reason json-property-not-declared `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $property) `
                        -EndLine (Get-ContextualNodeLine $property) `
                        -Symbol (
                            [string]$type.Identifier.ValueText) `
                        -Evidence (
                            'Declare or ignore the serialized property deliberately.')
            }
        }
    }

    foreach ($method in $methods) {
        if (-not (Test-ContextualNodeChanged `
                -Node $method -Spans $Spans)) {
            continue
        }
        $api = [string]$method.AttributeLists.ToString() -match
                '\bHttp' -or
            @($method.Ancestors() | Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.ClassDeclarationSyntax] -and
                    [string]$_.Identifier.ValueText -match
                        'Controller|ApiEngine'
                }).Count -gt 0
        if ($api) {
            $badException = @($method.DescendantNodes() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.ObjectCreationExpressionSyntax] -and
                    [string]$_.Type.ToString() -in @(
                        'Exception',
                        'InvalidOperationException',
                        'System.InvalidOperationException')
                } | Select-Object -First 1)
            if ($badException.Count -eq 1 -and
                [string]$method.ToString() -notmatch
                    'ErrorResponseMessage|GenerateResponseMessageFromException') {
                $results['api-errors'] =
                    New-ContextualOutcome `
                        -RuleId api-errors `
                        -State violation `
                        -Reason nonstandard-api-error-path `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $badException[0]) `
                        -EndLine (Get-ContextualNodeLine $badException[0]) `
                        -Symbol (
                            [string]$method.Identifier.ValueText) `
                        -Evidence (
                            'Use the repository actionable API error contract.')
            }
        }
        foreach ($assignment in @(
                $method.DescendantNodes() |
                    Where-Object {
                        $_ -is [
                            Microsoft.CodeAnalysis.CSharp.Syntax.AssignmentExpressionSyntax] -and
                        (Test-ContextualNodeChanged `
                            -Node $_ -Spans $Spans)
                    })) {
            $left = [string]$assignment.Left.ToString()
            $right = [string]$assignment.Right.ToString()
            if ($left -notmatch
                '(?i)(?:response|result)\.(?:password|secret|token|authorization|connectionString|apiKey)$') {
                continue
            }
            if ($right -match '(?i)Redact|Mask|Sanitize') {
                $results['secret-redaction'] =
                    New-ContextualOutcome `
                        -RuleId secret-redaction `
                        -State compliant `
                        -Reason response-value-redacted `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $assignment) `
                        -EndLine (Get-ContextualNodeLine $assignment)
                continue
            }
            if ($right -notmatch
                '(?i)(?:password|secret|token|authorization|connectionString|apiKey)') {
                $results['secret-redaction'] =
                    New-ContextualOutcome `
                        -RuleId secret-redaction `
                        -State unknown `
                        -Reason sensitive-source-unproven `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $assignment) `
                        -EndLine (Get-ContextualNodeLine $assignment)
                continue
            }
            $cacheBranch = @($assignment.Ancestors() |
                Where-Object {
                    $_ -is [
                        Microsoft.CodeAnalysis.CSharp.Syntax.IfStatementSyntax] -and
                    [string]$_.Condition.ToString() -match
                        '(?i)(?:cache|cached|metadata).*(?:==\s*null|is\s+null|miss)'
                } | Select-Object -First 1)
            if ($cacheBranch.Count -eq 1) {
                $results['secret-redaction'] =
                    New-ContextualOutcome `
                        -RuleId secret-redaction `
                        -State violation `
                        -Reason cold-cache-sensitive-value-reaches-response `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $assignment) `
                        -EndLine (Get-ContextualNodeLine $assignment) `
                        -Symbol (
                            [string]$method.Identifier.ValueText) `
                        -Evidence (
                            'Redact the sensitive field on the proven cache-miss response path.')
            }
            else {
                $results['secret-redaction'] =
                    New-ContextualOutcome `
                        -RuleId secret-redaction `
                        -State unknown `
                        -Reason cold-cache-path-unproven `
                        -Path $Path `
                        -Line (Get-ContextualNodeLine $assignment) `
                        -EndLine (Get-ContextualNodeLine $assignment)
            }
        }
    }

    foreach ($rule in $script:RuleIds) {
        $changedCandidates = @($contextualCandidateOutcomes |
            Where-Object { [string]$_.ruleId -ceq $rule } |
            Where-Object {
                $candidate = $_
                $first = [int]$candidate.line
                $last = [Math]::Max($first, [int]$candidate.endLine)
                @($Spans | Where-Object {
                        $first -le [int]$_.endLine -and
                        $last -ge [int]$_.startLine
                    }).Count -gt 0
            })
        if ($changedCandidates.Count -gt 0) {
            $results[$rule] = if ($rule -cin @(
                    'http-client-lifetime',
                    'named-call-arguments')) {
                @($changedCandidates |
                    Sort-Object {
                        [int]$_.line
                    })[0]
            }
            else {
                $changedCandidates[-1]
            }
            continue
        }
        $outcome = $results[$rule]
        if ([string]$outcome.state -ceq 'violation') {
            $outcome.state = 'compliant'
            $outcome.reason = 'candidate-outside-changed-spans'
            $outcome.evidence = ''
        }
    }

    if ($parseErrors.Count -gt 0) {
        foreach ($rule in $script:RuleIds) {
            $results[$rule].state = 'unknown'
            $results[$rule].reason =
                'csharp-syntax-incomplete'
            $results[$rule].evidence = ''
        }
        $coverageOutcomes = @(
            New-ContextualOutcome `
                -RuleId test-class-code-coverage `
                -State unknown `
                -Reason csharp-syntax-incomplete `
                -Path $Path)
        $exceptionNamingOutcomes = @(
            New-ContextualOutcome -RuleId generic-exception-naming `
                -State unknown -Reason csharp-syntax-incomplete -Path $Path)
        $reusedStringOutcomes = @(
            New-ContextualOutcome -RuleId reused-string-literals `
                -State unknown -Reason csharp-syntax-incomplete -Path $Path)
    }
    $baseOutcomes = @($script:RuleIds | Where-Object {
            $_ -cnotin @('test-class-code-coverage', 'generic-exception-naming', 'reused-string-literals')
        } | ForEach-Object {
            $results[$_]
        })
    return @($baseOutcomes + $coverageOutcomes + $exceptionNamingOutcomes + $reusedStringOutcomes)
}

function Get-ContextualConventionOutcomes {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [AllowEmptyString()]
        [string]$Content,
        [Parameter(Mandatory)]
        [string]$Path,
        [Parameter(Mandatory)]
        [AllowEmptyCollection()]
        [object[]]$Spans,
        [Parameter(Mandatory)]
        [AllowEmptyCollection()]
        [object[]]$SnapshotFiles
    )
    $snapshotBytes = 0L
    foreach ($file in $SnapshotFiles) {
        if ($file.content -is [string]) {
            $snapshotBytes += [Text.Encoding]::UTF8.GetByteCount([string]$file.content)
        }
        if ($file -is [Collections.IDictionary] -and $file.Contains('comparison') -and
            $file.comparison -is [Collections.IDictionary] -and
            $file.comparison.Contains('content') -and $file.comparison.content -is [string]) {
            $snapshotBytes += [Text.Encoding]::UTF8.GetByteCount([string]$file.comparison.content)
        }
    }
    if ($snapshotBytes -gt 16MB -or
        [Text.Encoding]::UTF8.GetByteCount($Content) -gt
            16MB -or
        $Spans.Count -gt 4096 -or
        $SnapshotFiles.Count -gt 64) {
        throw 'Contextual convention input exceeded its bounded limits.'
    }
    $outcomes = if ($Path.EndsWith(
            '.cs',
            [StringComparison]::OrdinalIgnoreCase)) {
        Get-ContextualRoslynOutcomes `
            -Content $Content -Path $Path -Spans $Spans `
            -SnapshotFiles $SnapshotFiles
    }
    else {
        @($script:RuleIds | ForEach-Object {
                New-ContextualOutcome `
                    -RuleId $_ -State compliant `
                    -Reason no-applicable-violation `
                    -Path $Path
            })
    }
    $dependency = Get-ContextualDependencyOutcome `
        -Content $Content -Path $Path `
        -SnapshotFiles $SnapshotFiles
    $outcomes = @($outcomes | ForEach-Object {
            if ([string]$_.ruleId -ceq 'file-copyright-header') {
                Get-ContextualCopyrightHeaderOutcome -Content $Content -Path $Path -SnapshotFiles $SnapshotFiles
            }
            elseif ([string]$_.ruleId -ceq
                'dependency-fanout') {
                $dependency
            }
            else {
                $_
            }
        })
    if ($outcomes.Count -lt $script:RuleIds.Count -or
        @($outcomes | Where-Object {
                [string]$_.ruleId -cnotin
                    $script:RuleIds
            }).Count -gt 0 -or
        @($outcomes.ruleId | Sort-Object -Unique).Count -ne
            $script:RuleIds.Count) {
        throw 'Contextual analyzer returned an invalid rule set.'
    }
    return $outcomes
}

