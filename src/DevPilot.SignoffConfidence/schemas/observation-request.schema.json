{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devpilot:signoff:observation-request:1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "studyId", "captureId", "startedAt", "cursor", "trackedPullRequests", "maxItems", "collectorConfigSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "purpose": {"enum": ["INVENTORY", "REFRESH"]},
    "studyId": {"$ref": "urn:devpilot:signoff:bundle:1#/$defs/id"},
    "captureId": {"$ref": "urn:devpilot:signoff:bundle:1#/$defs/id"},
    "startedAt": {"type": "string", "format": "date-time"},
    "cursor": {"type": ["string", "null"], "maxLength": 256},
    "trackedPullRequests": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["familyId", "pullRequestId"],
        "properties": {"familyId": {"type": "string", "minLength": 1, "maxLength": 512}, "pullRequestId": {"type": "string", "pattern": "^[1-9][0-9]*$"}}
      }
    },
    "maxItems": {"type": "integer", "minimum": 1, "maximum": 25},
    "collectorConfigSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [{
    "if": {"required": ["purpose"], "properties": {"purpose": {"const": "REFRESH"}}},
    "then": {"properties": {
      "cursor": {"type": "null"}, "maxItems": {"const": 1},
      "trackedPullRequests": {"minItems": 1, "maxItems": 1}
    }}
  }]
}
