{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devpilot:signoff:assessment:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["recommendation", "readinessProbability", "risk", "questions", "blockers"],
  "properties": {
    "recommendation": {"enum": ["APPROVE", "REQUEST_CHANGES", "NEEDS_HUMAN_REVIEW"]},
    "readinessProbability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"]},
    "questions": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "answer", "evidenceRefs", "reason"],
        "properties": {
          "id": {"enum": ["intent", "correctness", "validation"]},
          "answer": {"enum": ["YES", "NO", "UNKNOWN"]},
          "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    },
    "blockers": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "evidenceRefs", "reason"],
        "properties": {
          "code": {"enum": ["CODE_DEFECT", "MISSING_EVIDENCE", "POLICY_UNKNOWN", "RISK_UNKNOWN"]},
          "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    }
  }
}
