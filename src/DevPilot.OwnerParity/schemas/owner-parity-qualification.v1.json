{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owner-parity-qualification.v2",
  "title": "Owner parity qualification manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "attestation", "entries"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "owner-parity-qualification" },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "volatile"],
      "properties": {
        "critical": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/exactReference" }
        },
        "volatile": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "relativePath",
              "expectedPrefixSha256",
              "expectedPrefixLength",
              "maximumGrowthBytes",
              "affectsParityInputs"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "relativePath": { "$ref": "#/$defs/relativePath" },
              "expectedPrefixSha256": { "$ref": "#/$defs/sha256" },
              "expectedPrefixLength": { "type": "integer", "minimum": 0, "maximum": 67108864 },
              "maximumGrowthBytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
              "affectsParityInputs": { "const": false }
            }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "baseline", "candidate", "evidence", "adjudication"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["headKey"],
            "properties": {
              "headKey": { "$ref": "#/$defs/sha256" }
            }
          },
          "candidate": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "manifestPath", "entryId"],
                "properties": {
                  "mode": { "const": "run" },
                  "manifestPath": { "$ref": "#/$defs/path" },
                  "entryId": { "$ref": "#/$defs/id" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "observationPath"],
                "allOf": [
                  {
                    "if": {
                      "required": ["semanticProvenance"],
                      "properties": {
                        "semanticProvenance": { "const": "prospective-real-model" }
                      }
                    },
                    "then": { "required": ["telemetryPath"] }
                  }
                ],
                "properties": {
                  "mode": { "const": "read" },
                  "observationPath": { "$ref": "#/$defs/path" },
                  "telemetryPath": { "$ref": "#/$defs/path" },
                  "semanticProvenance": {
                    "enum": ["prospective-real-model", "unknown"]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "reason"],
                "properties": {
                  "mode": { "const": "unavailable" },
                  "reason": {
                    "enum": [
                      "exact-evidence-unavailable",
                      "safe-real-model-launcher-unavailable"
                    ]
                  }
                }
              }
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "semanticProvenance", "inputContract", "truthCoverage"],
            "properties": {
              "class": { "enum": ["preserved-exact-bytes", "synthetic", "unknown"] },
              "semanticProvenance": {
                "enum": [
                  "offline-replay-recorded-model",
                  "offline-replay-deterministic",
                  "prospective-real-model",
                  "unavailable",
                  "unknown"
                ]
              },
              "inputContract": { "enum": ["independently-validated", "unknown"] },
              "truthCoverage": { "enum": ["complete", "partial", "none"] }
            }
          },
          "adjudication": {
            "type": "array",
            "maxItems": 1024,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "eligibility", "truth", "baseline", "candidate"],
              "properties": {
                "key": { "$ref": "#/$defs/id" },
                "eligibility": { "enum": ["method", "class-advisory", "incomplete"] },
                "truth": { "enum": ["violation", "compliant", "unknown"] },
                "baseline": { "$ref": "#/$defs/selectorOrNull" },
                "candidate": { "$ref": "#/$defs/selectorOrNull" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32767
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.?(?:[/\\\\]|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "exactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relativePath", "sha256", "length", "binding"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "length": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "binding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "disposition"],
      "properties": {
        "identity": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "disposition": { "enum": ["violation", "unknown"] }
      }
    },
    "selectorOrNull": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/selector" }
      ]
    }
  }
}
